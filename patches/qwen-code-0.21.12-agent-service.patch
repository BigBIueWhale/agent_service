+  it('preserves provenance only through the runtime clone operation', () => {
+    const approved = withToolModification(
+      { content: 'approved' },
+      '',
+      'approved',
+    );
+    expect(getToolModification(cloneToolParams(approved))).toEqual({
+      originalProposedContent: '',
+      approvedContent: 'approved',
+    });
+    expect(
+      getToolModification(JSON.parse(JSON.stringify(approved))),
+    ).toBeUndefined();
+    expect(getToolModification({ content: 'approved' })).toBeUndefined();
+    expect(Object.keys(approved)).toEqual(['content']);
