diff --git a/packages/core/src/utils/runtime-contract-admission.ts b/packages/core/src/utils/runtime-contract-admission.ts
--- /dev/null
+++ b/packages/core/src/utils/runtime-contract-admission.ts
@@ -0,0 +1,144 @@
+import {
+  STREAM_CONTRACT_SHA256,
+  validateGoalSnapshot,
+  validateRuntimeStreamRecord,
+  validateRuntimeControlRecord,
+} from './runtime-stream-contract.js';
+import { RuntimePartialStream } from './runtime-partial-stream.js';
+
+type AdmissionKind = 'wire_record' | 'goal_snapshot' | 'outbound_control';
+
+export class RuntimeContractViolation extends Error {
+  override readonly name = 'RuntimeContractViolation';
+  readonly contract = STREAM_CONTRACT_SHA256;
+  constructor(
+    readonly evidence:
+      | { state: 'serialized'; kind: AdmissionKind; recordBytes: string }
+      | { state: 'unserializable'; kind: AdmissionKind; cause: unknown },
+    cause: string,
+  ) {
+    super(
+      `Runtime stream contract ${STREAM_CONTRACT_SHA256} refused a record: ${cause}`,
+    );
+  }
+}
+
+/** Required admission belongs to Config, before any optional output subscriber.
+ * A failure is retained and blocks subsequent work even if a renderer catches
+ * the thrown error. The exact serialized candidate is available for recovery.
+ */
+export class RuntimeContractAdmission {
+  private failure: RuntimeContractViolation | undefined;
+  private readonly partials = new Map<
+    string,
+    Map<string | null, RuntimePartialStream>
+  >();
+
+  assertAvailable(): void {
+    if (this.failure) throw this.failure;
+  }
+
+  admit(record: unknown): string {
+    return this.validate(
+      record,
+      (value) => {
+        const cause = validateRuntimeStreamRecord(value);
+        if (cause !== null) return cause;
+        const wire = value as {
+          type: string;
+          session_id: string;
+          parent_tool_use_id?: string | null;
+          event: Parameters<RuntimePartialStream['observe']>[0];
+        };
+        let session = this.partials.get(wire.session_id);
+        if (!session) {
+          session = new Map();
+          this.partials.set(wire.session_id, session);
+        }
+        const scope = wire.parent_tool_use_id ?? null;
+        let partial = session.get(scope);
+        if (!partial) {
+          partial = new RuntimePartialStream();
+          session.set(scope, partial);
+        }
+        try {
+          if (wire.type === 'stream_event')
+            partial.observe(wire.event, scope === null);
+          if (wire.type === 'assistant') partial.completeMessage();
+          if (wire.type === 'result') partial.finish();
+        } catch (error) {
+          return `Partial-stream ordering is invalid: ${String(error)}`;
+        }
+        return null;
+      },
+      'wire_record',
+    );
+  }
+
+  admitGoalSnapshot(snapshot: unknown): void {
+    this.validate(snapshot, validateGoalSnapshot, 'goal_snapshot');
+  }
+
+  admitOutboundControl(record: unknown): string {
+    return this.validate(
+      record,
+      validateRuntimeControlRecord,
+      'outbound_control',
+    );
+  }
+
+  private validate(
+    record: unknown,
+    validator: (value: unknown) => string | null,
+    kind: AdmissionKind,
+  ): string {
+    this.assertAvailable();
+    let bytes: string;
+    try {
+      const serialized = JSON.stringify(record, (key, value: unknown) => {
+        // JSON.stringify otherwise silently maps nonfinite numbers to null
+        // and escapes invalid UTF-16 as bytes the strict reader must refuse.
+        if (
+          /[\uD800-\uDFFF]/u.test(key) ||
+          (typeof value === 'string' && /[\uD800-\uDFFF]/u.test(value))
+        ) {
+          throw new Error(
+            'Runtime stream strings must contain Unicode scalar values',
+          );
+        }
+        if (typeof value === 'number' && !Number.isFinite(value)) {
+          throw new Error('Runtime stream numbers must be finite');
+        }
+        return value;
+      });
+      if (typeof serialized !== 'string') {
+        throw new Error('Runtime stream record has no JSON representation');
+      }
+      bytes = serialized;
+    } catch (cause) {
+      this.failure = new RuntimeContractViolation(
+        { state: 'unserializable', kind, cause },
+        'candidate could not be serialized',
+      );
+      throw this.failure;
+    }
+    let cause: string | null;
+    try {
+      cause = validator(JSON.parse(bytes));
+    } catch (error) {
+      this.failure = new RuntimeContractViolation(
+        { state: 'serialized', kind, recordBytes: bytes },
+        `validator could not establish admission: ${String(error)}`,
+      );
+      throw this.failure;
+    }
+    if (cause !== null) {
+      this.failure = new RuntimeContractViolation(
+        { state: 'serialized', kind, recordBytes: bytes },
+        cause,
+      );
+      throw this.failure;
+    }
+    return bytes;
+  }
+}
