+/**
+ * @license
+ * Copyright 2025 Qwen
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { afterEach, describe, expect, it } from 'vitest';
+import {
+  beginQwen38EffectJournal,
+  finishQwen38EffectJournal,
+} from './qwen38-effect-journal.js';
+
+const cleanup: string[] = [];
+
+function fixture(): {
+  root: string;
+  workspace: string;
+  artifacts: string;
+  journals: string;
+} {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'qwen38-effects-test-'));
+  cleanup.push(root);
+  const workspace = path.join(root, 'workspace');
+  const artifacts = path.join(root, 'artifacts');
+  const journals = path.join(root, 'journals');
+  fs.mkdirSync(workspace, { mode: 0o700 });
+  fs.mkdirSync(artifacts, { mode: 0o700 });
+  fs.mkdirSync(journals, { mode: 0o700 });
+  return { root, workspace, artifacts, journals };
+}
+
+afterEach(() => {
+  for (const item of cleanup.splice(0)) {
+    fs.rmSync(item, { recursive: true, force: true });
+  }
+});
+
+describe('Qwen3.8 Explore effect journal', () => {
+  it('reports content, metadata, creation, removal, symlink, and artifact effects', async () => {
+    const { workspace, artifacts, journals } = fixture();
+    fs.writeFileSync(path.join(workspace, 'modified.bin'), Buffer.from([1, 2]));
+    fs.writeFileSync(path.join(workspace, 'removed.txt'), 'remove me');
+    fs.writeFileSync(path.join(workspace, 'chmod.txt'), 'same');
+    fs.symlinkSync('modified.bin', path.join(workspace, 'link'));
+    const journal = await beginQwen38EffectJournal({
+      workspaceRoot: workspace,
+      artifactsRoot: artifacts,
+      journalRoot: journals,
+    });
+
+    fs.writeFileSync(path.join(workspace, 'modified.bin'), Buffer.from([1, 3]));
+    fs.rmSync(path.join(workspace, 'removed.txt'));
+    fs.chmodSync(path.join(workspace, 'chmod.txt'), 0o600);
+    fs.rmSync(path.join(workspace, 'link'));
+    fs.symlinkSync('chmod.txt', path.join(workspace, 'link'));
+    fs.writeFileSync(path.join(workspace, 'created.txt'), 'new');
+    fs.writeFileSync(path.join(artifacts, 'report.txt'), 'report');
+
+    const report = await finishQwen38EffectJournal(journal);
+    expect(report.workspace.created).toEqual(['created.txt']);
+    expect(report.workspace.removed).toEqual(['removed.txt']);
+    expect(report.workspace.contentModified).toEqual(['link', 'modified.bin']);
+    expect(report.workspace.metadataModified).toEqual(['chmod.txt']);
+    expect(report.artifacts.created).toEqual(['report.txt']);
+    expect(report.modelSummary).toContain(
+      'QWEN38_TRUSTED_EXPLORE_EFFECT_JOURNAL_V1',
+    );
+    expect(report.modelSummary).toContain('path_list_truncated=false');
+    expect(fs.readFileSync(report.manifestPath, 'utf8')).toContain(
+      report.journalId,
+    );
+  });
+
+  it('does not treat scratch-only writes as project effects', async () => {
+    const { root, workspace, artifacts, journals } = fixture();
+    const journal = await beginQwen38EffectJournal({
+      workspaceRoot: workspace,
+      artifactsRoot: artifacts,
+      journalRoot: journals,
+    });
+    fs.writeFileSync(path.join(root, 'scratch-only'), 'derived');
+    const report = await finishQwen38EffectJournal(journal);
+    expect(report.workspace).toEqual({
+      created: [],
+      removed: [],
+      contentModified: [],
+      metadataModified: [],
+    });
+    expect(report.artifacts).toEqual(report.workspace);
+  });
+
+  it('refuses a symlinked project root instead of following it', async () => {
+    const { root, workspace, artifacts, journals } = fixture();
+    const linked = path.join(root, 'linked-workspace');
+    fs.symlinkSync(workspace, linked);
+    await expect(
+      beginQwen38EffectJournal({
+        workspaceRoot: linked,
+        artifactsRoot: artifacts,
+        journalRoot: journals,
+      }),
+    ).rejects.toThrow('not a real directory');
+  });
+
+  it('refuses a non-private journal root', async () => {
+    const { workspace, artifacts, journals } = fixture();
+    fs.chmodSync(journals, 0o755);
+    await expect(
+      beginQwen38EffectJournal({
+        workspaceRoot: workspace,
+        artifactsRoot: artifacts,
+        journalRoot: journals,
+      }),
+    ).rejects.toThrow('mode-0700');
+  });
+});
