+function createConfig(params: Partial<ConfigParameters> = {}) {
+  const config = Storage.runWithRuntimeBaseDir(
+    runtimeBaseDir,
+    projectRoot,
+    () =>
+      new Config({
+        sessionId: 'owned-recording',
+        cwd: projectRoot,
+        targetDir: projectRoot,
+        debugMode: false,
+        model: 'test-model',
+        bareMode: true,
