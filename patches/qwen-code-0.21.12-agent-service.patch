+type VllmTokenizeResponse = {
+  count?: unknown;
+  max_model_len?: unknown;
+};
+
+export function deriveVllmTokenizeUrl(baseUrl: string | undefined): string {
+  if (!baseUrl) {
+    throw new Error(
+      'exactTokenCounting=vllm requires an explicit OpenAI baseUrl ending in /v1.',
+    );
+  }
+
+  const parsed = new URL(baseUrl);
+  if (parsed.username || parsed.password || parsed.search || parsed.hash) {
+    throw new Error(
+      'exactTokenCounting=vllm requires a credential-free baseUrl without query parameters or a fragment.',
+    );
+  }
+  const normalizedPath = parsed.pathname.replace(/\/+$/, '');
+  if (!normalizedPath.endsWith('/v1')) {
+    throw new Error(
+      `exactTokenCounting=vllm requires baseUrl to end in /v1; received ${parsed.origin}${parsed.pathname}`,
+    );
+  }
+  parsed.pathname = `${normalizedPath.slice(0, -3)}/tokenize`.replace(
+    /\/{2,}/g,
+    '/',
+  );
+  return parsed.toString();
+}
+
+export function validateVllmTokenizeResponse(
+  response: VllmTokenizeResponse,
+  expectedMaxModelLen: number | undefined,
+): ExactRequestTokenCount {
+  const totalTokens = response.count;
+  const maxModelLen = response.max_model_len;
+  if (
+    !Number.isSafeInteger(totalTokens) ||
+    (totalTokens as number) < 0 ||
+    !Number.isSafeInteger(maxModelLen) ||
+    (maxModelLen as number) <= 0
+  ) {
+    throw new Error(
+      'vLLM /tokenize returned an invalid count or max_model_len; refusing to estimate.',
+    );
+  }
+  if (
+    !Number.isSafeInteger(expectedMaxModelLen) ||
+    (expectedMaxModelLen as number) <= 0
+  ) {
+    throw new Error(
+      'exactTokenCounting=vllm requires an explicit positive contextWindowSize.',
+    );
+  }
+  if (maxModelLen !== expectedMaxModelLen) {
+    throw new Error(
+      `vLLM /tokenize reports max_model_len=${maxModelLen}, but contextWindowSize=${expectedMaxModelLen}; refusing to use mismatched limits.`,
+    );
+  }
+  return {
+    totalTokens: totalTokens as number,
+    maxModelLen: maxModelLen as number,
+  };
+}
