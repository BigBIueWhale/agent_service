-      yield result.value; // a chunk arrived → next loop starts a fresh timer
-    }
-  } finally {
-    abortRequest();
-    try {
-      await it.return?.();
-    } catch {
-      // The abort above is the cleanup that matters; ignore return failures.
-    }
