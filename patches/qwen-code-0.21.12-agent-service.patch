--- /dev/null
+++ b/packages/core/src/core/served-usage.ts
@@ -0,0 +1,74 @@
+import type {
+  GenerateContentResponse,
+  GenerateContentResponseUsageMetadata,
+} from '@google/genai';
+import type { GenerationUsageCounts } from '../telemetry/generation-usage-types.js';
+
+/**
+ * Usage the pinned backend serves on every generation it completes: the five
+ * counts that together say what a request cost and where its output went.
+ */
+export type ServedUsage = GenerateContentResponseUsageMetadata &
+  GenerationUsageCounts;
+
+const SERVED_USAGE_FIELDS = [
+  'totalTokenCount',
+  'promptTokenCount',
+  'candidatesTokenCount',
+  'thoughtsTokenCount',
+  'cachedContentTokenCount',
+] as const;
+
+export function isTokenCount(value: unknown): value is number {
+  return Number.isSafeInteger(value) && (value as number) >= 0;
+}
+
+/**
+ * Under `exactTokenCounting: 'vllm'` a generation that arrived without its
+ * served usage did not complete in a way this client can account for, and no
+ * count is invented in its place.
+ */
+export function requireServedUsage(usage: unknown, site: string): ServedUsage {
+  const counts = usage as ServedUsage;
+  const invalidField = SERVED_USAGE_FIELDS.find(
+    (field) =>
+      !isTokenCount(
+        usage !== null && typeof usage === 'object' ? counts[field] : undefined,
+      ),
+  );
+  if (
+    invalidField !== undefined ||
+    counts.totalTokenCount !==
+      counts.promptTokenCount + counts.candidatesTokenCount ||
+    counts.thoughtsTokenCount > counts.candidatesTokenCount ||
+    counts.cachedContentTokenCount > counts.promptTokenCount
+  ) {
+    throw new Error(
+      `${site}: invalid served usage (${invalidField ?? 'relationships'}): ${JSON.stringify(usage)}`,
+    );
+  }
+  return counts;
+}
+
+/** Received diagnostics from a response that could not be accepted. */
+export class ResponseObservationError extends Error {
+  readonly response: GenerateContentResponse;
+  constructor(response: GenerateContentResponse, cause: unknown) {
+    super(`Invalid served response: ${String(cause)}`, { cause });
+    this.response = {
+      ...(response.usageMetadata
+        ? { usageMetadata: response.usageMetadata }
+        : {}),
+      candidates: [
+        {
+          content: {
+            role: 'model',
+            parts: (response.candidates?.[0]?.content?.parts ?? []).filter(
+              (part) => typeof part.text === 'string',
+            ),
+          },
+        },
+      ],
+    } as GenerateContentResponse;
+  }
+}
