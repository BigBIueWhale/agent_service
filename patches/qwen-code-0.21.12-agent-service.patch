diff --git a/scripts/tests/stream-contract-assets.test.js b/scripts/tests/stream-contract-assets.test.js
--- /dev/null
+++ b/scripts/tests/stream-contract-assets.test.js
@@ -0,0 +1,89 @@
+import { afterEach, describe, expect, it } from 'vitest';
+import {
+  mkdtempSync,
+  mkdirSync,
+  readFileSync,
+  rmSync,
+  symlinkSync,
+  writeFileSync,
+} from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import {
+  copyCoreStreamContract,
+  copyBundleStreamContract,
+  readStreamContract,
+} from '../stream-contract-assets.js';
+
+// These are actual generated bindings. This suite qualifies copying and
+// rejection of damaged build artifacts; it does not execute a provider.
+const actualRoot = fileURLToPath(new URL('../../', import.meta.url));
+const actualFiles = readStreamContract(actualRoot);
+const actualLock = readFileSync(join(actualRoot, 'package-lock.json'));
+const roots = [];
+function fixture() {
+  const root = mkdtempSync(join(tmpdir(), 'qwen-stream-assets-'));
+  roots.push(root);
+  const source = join(root, 'packages/core/src/generated');
+  mkdirSync(source, { recursive: true });
+  writeFileSync(join(root, 'package-lock.json'), actualLock);
+  for (const [name, bytes] of actualFiles)
+    writeFileSync(join(source, name), bytes);
+  return { root, source };
+}
+afterEach(() => {
+  for (const root of roots.splice(0)) rmSync(root, { recursive: true });
+});
+
+describe('required generated stream artifacts', () => {
+  it('copies the exact executable modules, declarations and receipt into their distributions', () => {
+    const { root } = fixture();
+    copyCoreStreamContract(root);
+    copyBundleStreamContract(root, join(root, 'dist'));
+    for (const [name, bytes] of actualFiles) {
+      if (name !== 'stream-contract.ts')
+        expect(
+          readFileSync(join(root, 'packages/core/dist/src/generated', name)),
+        ).toEqual(bytes);
+    }
+    expect(
+      readFileSync(join(root, 'dist/stream-binding-manifest.json')),
+    ).toEqual(actualFiles.get('stream-binding-manifest.json'));
+    copyCoreStreamContract(root);
+    copyBundleStreamContract(root, join(root, 'dist'));
+  });
+  it.each(['missing', 'changed', 'symlink', 'lock', 'receipt'])(
+    'refuses a %s artifact before publishing',
+    (fault) => {
+      const { root, source } = fixture();
+      const validator = join(source, 'stream-record-validator.js');
+      if (fault === 'missing' || fault === 'symlink') rmSync(validator);
+      if (fault === 'changed')
+        writeFileSync(validator, 'export default () => true;\n');
+      if (fault === 'symlink')
+        symlinkSync(join(source, 'goal-snapshot-validator.js'), validator);
+      if (fault === 'lock')
+        writeFileSync(join(root, 'package-lock.json'), '{}\n');
+      if (fault === 'receipt')
+        writeFileSync(
+          join(source, 'stream-binding-manifest.json'),
+          '{"v":1}\n',
+        );
+      const cause = {
+        missing: /ENOENT/,
+        changed: /binding changed/,
+        symlink: /not a regular file/,
+        lock: /dependencies differ/,
+        receipt: /incomplete or invalid/,
+      }[fault];
+      expect(() => copyCoreStreamContract(root)).toThrow(cause);
+      expect(() => copyBundleStreamContract(root, join(root, 'dist'))).toThrow(
+        cause,
+      );
+      expect(() =>
+        readFileSync(join(root, 'dist/stream-binding-manifest.json')),
+      ).toThrow(/ENOENT/);
+    },
+  );
+});
