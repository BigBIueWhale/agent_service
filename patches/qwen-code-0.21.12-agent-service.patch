+/**
+ * @license
+ * Copyright 2026 Qwen
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import fs from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import type { Part } from '@google/genai';
+import sharp from 'sharp';
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import type { Config } from '../config/config.js';
+import { ToolErrorType } from '../tools/tool-error.js';
+import { processSingleFileContent } from './fileUtils.js';
+
+describe('Qwen3.8 read_file image contract', () => {
+  let root: string;
+  let config: Config;
+
+  beforeEach(async () => {
+    root = await fs.mkdtemp(path.join(os.tmpdir(), 'qwen38-image-contract-'));
+    config = {
+      getTargetDir: () => root,
+      getContentGeneratorConfig: () => ({
+        modalities: { image: true, pdf: false, audio: false, video: false },
+      }),
+      getTruncateToolOutputThreshold: () => 2500,
+      getTruncateToolOutputLines: () => 500,
+    } as unknown as Config;
+  });
+
+  afterEach(async () => {
+    await fs.rm(root, { recursive: true, force: true });
+  });
+
+  it('emits the exact original PNG bytes at their full dimensions', async () => {
+    const filePath = path.join(root, 'full.png');
+    await sharp({
+      create: {
+        width: 2048,
+        height: 1024,
+        channels: 4,
+        background: { r: 10, g: 20, b: 30, alpha: 0.5 },
+      },
+    })
+      .png({ compressionLevel: 0 })
+      .toFile(filePath);
+    const original = await fs.readFile(filePath);
+
+    const result = await processSingleFileContent(filePath, config);
+    const parts = result.llmContent as Part[];
+
+    expect(result.error).toBeUndefined();
+    expect(parts[0]?.text).toMatch(
+      /Full-quality original PNG: 2048x1024.*no resize.*transcode/,
+    );
+    expect(parts[1]?.inlineData?.mimeType).toBe('image/png');
+    expect(
+      Buffer.from(parts[1]!.inlineData!.data!, 'base64').equals(original),
+    ).toBe(true);
+    expect(result.returnDisplay).toBe('Read full-quality PNG: full.png');
+  });
+
+  it('fails closed for JPEG instead of transcoding or forwarding it', async () => {
+    const filePath = path.join(root, 'photo.jpg');
+    await sharp({
+      create: {
+        width: 256,
+        height: 256,
+        channels: 3,
+        background: '#804020',
+      },
+    })
+      .jpeg()
+      .toFile(filePath);
+
+    const result = await processSingleFileContent(filePath, config);
+
+    expect(result.errorType).toBe(ToolErrorType.INVALID_TOOL_PARAMS);
+    expect(result.error).toMatch(/full-quality PNG contract/);
+    expect(result.llmContent).not.toEqual(
+      expect.objectContaining({ inlineData: expect.anything() }),
+    );
+  });
+
+  it('fails closed for excess pixels and excess aspect ratio', async () => {
+    const tooLarge = path.join(root, 'too-large.png');
+    await sharp({
+      create: {
+        width: 4097,
+        height: 4096,
+        channels: 3,
+        background: '#804020',
+      },
+    })
+      .png()
+      .toFile(tooLarge);
+    const tooWide = path.join(root, 'too-wide.png');
+    await sharp({
+      create: {
+        width: 31,
+        height: 1,
+        channels: 3,
+        background: '#804020',
+      },
+    })
+      .png()
+      .toFile(tooWide);
+
+    const largeResult = await processSingleFileContent(tooLarge, config);
+    const wideResult = await processSingleFileContent(tooWide, config);
+
+    expect(largeResult.errorType).toBe(ToolErrorType.FILE_TOO_LARGE);
+    expect(largeResult.error).toMatch(/16777216 pixels/);
+    expect(wideResult.errorType).toBe(ToolErrorType.INVALID_TOOL_PARAMS);
+    expect(wideResult.error).toMatch(/30:1/);
+  });
+});
