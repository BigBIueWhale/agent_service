+      'openai',
+      'child',
+    ),
+    'event.name': EVENT_API_DISPATCH,
+  }) as const;
+const finalize = (start: ReturnType<typeof dispatch>, usage = servedUsage()) =>
+  ({
+    ...new ApiUsageEvent(start as unknown as ApiDispatchEvent, 100, usage, 10),
+    'event.name': EVENT_API_USAGE,
