+/**
+ * Write the per-request maintenance phase budget onto the fully merged wire
+ * request, mutating and returning the passed object.
+ *
+ * This is deliberately the last transformation of the request. The phase
+ * budgets are ordinary wire keys that the pinned configuration also declares
+ * — in `samplingParams`, in a provider hook, or in `extra_body`, which
+ * providers merge over the request — so an override written before those
+ * layers have merged is silently replaced by the pinned value, and the
+ * ceiling check below compares against an absent value it can never refuse.
+ * Written here, the override is both the value that ships and the value
+ * validated against the one it replaces.
+ */
+function applyPhaseBudgetOverrides(
+  wireRequest: Record<string, unknown>,
+  overrides: PromptCacheSharingParameters['phaseBudgetOverrides'],
+  requestMaxTokens: number | undefined,
+): Record<string, unknown> {
+  if (!overrides) return wireRequest;
+  const entries = [
+    ['thinking_token_budget', overrides.thinkingTokenBudget],
+    ['final_response_token_budget', overrides.finalResponseTokenBudget],
+  ] as const;
+  for (const [wireKey, requested] of entries) {
+    if (!Number.isSafeInteger(requested) || requested <= 0) {
+      throw new Error(
+        `Invalid ${wireKey} phase override: expected a positive safe integer.`,
+      );
+    }
+    const configured = wireRequest[wireKey];
+    if (
+      configured !== undefined &&
+      (typeof configured !== 'number' ||
+        !Number.isSafeInteger(configured) ||
+        requested > configured)
+    ) {
+      throw new Error(
+        `Refusing ${wireKey}=${requested}: the per-request maintenance ` +
+          `budget must not exceed the pinned provider ceiling (${String(configured)}).`,
+      );
+    }
+  }
+  if (
+    requestMaxTokens !== undefined &&
+    overrides.thinkingTokenBudget + overrides.finalResponseTokenBudget >
+      requestMaxTokens
+  ) {
+    throw new Error(
+      `Phase budgets exceed maxOutputTokens: thinking=` +
+        `${overrides.thinkingTokenBudget}, final=` +
+        `${overrides.finalResponseTokenBudget}, max=${requestMaxTokens}.`,
+    );
+  }
+  wireRequest['thinking_token_budget'] = overrides.thinkingTokenBudget;
+  wireRequest['final_response_token_budget'] =
+    overrides.finalResponseTokenBudget;
+  return wireRequest;
+}
