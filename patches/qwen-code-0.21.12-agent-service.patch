+describe('AgentCore generation accounting ownership', () => {
+  const served = {
+    promptTokenCount: 10,
+    candidatesTokenCount: 4,
+    thoughtsTokenCount: 2,
+    cachedContentTokenCount: 3,
+    totalTokenCount: 14,
+  };
+  function makeOwnerCore(getSessionId: () => string, owner: string) {
+    return new AgentCore(
+      new GenerationContext(owner),
+      'same-display-name',
+      {
+        getSessionId,
+        getSkipLoopDetection: () => true,
+        getModel: () => 'model',
+        getMaxToolCallsPerTurn: () => 1000,
+        isMaxToolCallsPerTurnExplicit: () => false,
+        getDebugLogger: () => ({
+          debug() {},
+          info() {},
+          warn() {},
+          error() {},
+        }),
+      } as unknown as Config,
+      { systemPrompt: 'system' },
+      { model: 'model' },
+      { max_turns: 5 },
+    );
+  }
+  function begin(session: string, owner: string, prompt: string) {
+    const start = new ApiDispatchEvent(
+      'model',
+      prompt,
+      session,
+      owner,
+      'openai',
+      'same-display-name',
+    );
+    uiTelemetryService.addEvent(
+      { ...start, 'event.name': EVENT_API_DISPATCH },
+      session,
+    );
+    return start;
+  }
+  function finish(start: ApiDispatchEvent) {
+    uiTelemetryService.addEvent(
+      {
+        ...new ApiUsageEvent(start, 100, served),
+        'event.name': EVENT_API_USAGE,
+      },
+      start.session_id,
+    );
+  }
+  const chunk = (
+    text: string,
+    thought = false,
+    usage = false,
+  ): StreamEvent => ({
+    type: StreamEventType.CHUNK,
+    value: Object.assign(new GenerateContentResponse(), {
+      candidates: [
+        {
+          content: { parts: [{ text, ...(thought ? { thought: true } : {}) }] },
+        },
+      ],
+      ...(usage ? { usageMetadata: served } : {}),
+    }),
+  });
+  function run(
+    core: AgentCore,
+    stream: AsyncGenerator<StreamEvent>,
+    abort = new AbortController(),
+  ) {
+    const chat = {
+      getHistoryFunctionResponseIds: () => [],
+      sendMessageStream: async () => stream,
+    } as unknown as GeminiChat;
+    return core['_runReasoningLoopInner'](
+      chat,
+      [{ role: 'user', parts: [{ text: 'task' }] }],
+      [],
+      abort,
+    );
+  }
+
+  it('captures the session and generation owner before the Config moves to another session', () => {
+    let session = 'captured-session';
+    uiTelemetryService.resetSession(session);
+    uiTelemetryService.resetSession('later-session');
+    const core = makeOwnerCore(() => session, 'child-owner');
+    finish(begin(session, 'child-owner', 'owned'));
+    finish(begin(session, 'other-child-owner', 'sibling'));
+    session = 'later-session';
+    begin(session, 'child-owner', 'unrelated');
+    expect(core.getExecutionSummary().ownerUsage).toEqual({
+      requests: 1,
+      usageReports: 1,
+      unfinalizedRequests: 0,
+      unreportedUsageRequests: 0,
+      usage: served,
+    });
+    core.resetExecutionStats();
+    expect(core.getExecutionSummary().ownerUsage.usage).toEqual(served);
+  });
+
+  it('counts retry and failed compaction accounting once independently of round diagnostics', async () => {
+    const session = 'retry-compaction-session';
+    const owner = 'child';
+    uiTelemetryService.resetSession(session);
+    const core = makeOwnerCore(() => session, owner);
+    const rounds: AgentRoundTextEvent[] = [];
+    const compactions: AgentCompactionEvent[] = [];
+    core
+      .getEventEmitter()
+      .on(AgentEventType.ROUND_TEXT, (event) => rounds.push(event));
+    core
+      .getEventEmitter()
+      .on(AgentEventType.COMPACTION, (event) => compactions.push(event));
+    const failure = new Error('failed compaction after partial output');
+    const record: CompactionRecord = {
+      status: 'COMPRESSION_FAILED_EMPTY_SUMMARY',
+      succeeded: false,
+      originalTokenCount: 100,
+      newTokenCount: 100,
+      triggerReason: 'token_limit',
+      output: {
+        summary: 'partial summary',
+        reasoning: 'partial thought',
+        usage: served,
+        finishReason: null,
+        requestAttempts: 1,
+        maxOutputTokens: 100,
+      },
+    };
+    await expect(
+      run(
+        core,
+        (async function* () {
+          finish(begin(session, owner, 'first-attempt'));
+          yield chunk('first reasoning', true, true);
+          yield { type: StreamEventType.RETRY };
+          finish(begin(session, owner, 'second-attempt'));
+          yield chunk('second text', false, true);
+          finish(begin(session, owner, 'compaction'));
+          yield { type: StreamEventType.COMPACTION, record };
+          throw failure;
+        })(),
+      ),
+    ).rejects.toBe(failure);
+    expect(rounds).toHaveLength(2);
+    expect(compactions[0].compaction).toEqual(record);
+    expect(core.getExecutionSummary().ownerUsage).toEqual({
+      requests: 3,
+      usageReports: 3,
+      unfinalizedRequests: 0,
+      unreportedUsageRequests: 0,
+      usage: {
+        promptTokenCount: 30,
+        candidatesTokenCount: 12,
+        thoughtsTokenCount: 6,
+        cachedContentTokenCount: 9,
+        totalTokenCount: 42,
+      },
+    });
+  });
+
+  it('includes final usage observed during iterator cleanup after cancellation', async () => {
+    const session = 'cancelled-owner-session';
+    const owner = 'child';
+    uiTelemetryService.resetSession(session);
+    const core = makeOwnerCore(() => session, owner);
+    const abort = new AbortController();
+    const start = begin(session, owner, 'cancelled-attempt');
+    const result = await run(
+      core,
+      (async function* () {
+        try {
+          yield chunk('reasoning', true);
+          abort.abort(new Error('cancelled'));
+          yield chunk('delivered text', false, true);
+        } finally {
+          finish(start);
+        }
+      })(),
+      abort,
+    );
+    expect(result.terminateMode).toBe(AgentTerminateMode.CANCELLED);
+    expect(core.getExecutionSummary().ownerUsage).toEqual({
+      requests: 1,
+      usageReports: 1,
+      unfinalizedRequests: 0,
+      unreportedUsageRequests: 0,
+      usage: served,
+    });
+  });
+});
