+    expect(metricValues('Total')).toEqual(['14', '14']);
+  });
+
+  it('uses finalized observations for average latency and error rate', () => {
+    const status = statusFor({
+      ...reported,
+      requests: 3,
+      unreportedUsageRequests: 1,
+      unfinalizedRequests: 1,
+    });
+    status.models['selected-model::reviewer']!.api = {
+      totalErrors: 1,
+      totalLatencyMs: 200,
+    };
+    render(status, 'model');
+    expect(metricValues('Avg Latency')).toEqual(['100ms']);
+    expect(metricValues('Errors')).toEqual(['1 (50.0%)']);
+    expect(container!.textContent).toContain(
+      '3 requests, 1 usage reports, 1 without usage, 1 unfinalized',
+    );
+  });
+
+  it('leaves latency and error rate absent until an observation is finalized', () => {
+    render(
+      statusFor({ ...noRequests, requests: 1, unfinalizedRequests: 1 }),
+      'model',
+    );
+    expect(metricValues('Avg Latency')).toEqual(['—']);
+    expect(metricValues('Errors')).toEqual(['0 (—)']);
+  });
+
+  it('retains no-call model and tool views', () => {
+    const status = statusFor(noRequests);
+    render(status, 'model');
+    expect(container!.textContent).toContain('No API calls');
+    render(status, 'tools');
+    expect(container!.textContent).toContain('No tool calls');
+  });
+
+  it('retains tool sorting, durations, decisions and code changes', () => {
+    const status = statusFor(reported);
+    status.files = { totalLinesAdded: 7, totalLinesRemoved: 2 };
+    status.tools = {
+      totalCalls: 3,
+      totalSuccess: 2,
+      totalFail: 1,
+      totalDurationMs: 3000,
+      byName: {
+        read_file: {
+          count: 1,
+          success: 1,
+          fail: 0,
+          durationMs: 1000,
+          decisions: { accept: 1, reject: 0, modify: 0, auto_accept: 0 },
+        },
+        run_shell_command: {
+          count: 2,
+          success: 1,
+          fail: 1,
+          durationMs: 2000,
+          decisions: { accept: 0, reject: 1, modify: 0, auto_accept: 1 },
+        },
+      },
+    };
+    render(status);
+    expect(container!.textContent).toContain('+7 -2');
+    render(status, 'tools');
+    const text = container!.textContent ?? '';
+    expect(text.indexOf('Shell')).toBeLessThan(text.indexOf('ReadFile'));
+    expect(text).toContain('1.0s');
+    expect(text).toContain('50.0%');
+    expect(text).toContain('Total Reviewed Suggestions:2');
+  });
+
+  it.each(['overview', 'model', 'tools'] as const)(
+    'roundtrips canonical stats and selected %s view without mutation',
+    (view) => {
+      const status = statusFor({
+        ...reportedZero,
+        requests: 3,
+        unreportedUsageRequests: 1,
+        unfinalizedRequests: 1,
+      });
+      const original = structuredClone(status);
+      expect(parseStatsMessage(serializeStatsMessage(status, view))).toEqual({
+        view,
+        status,
+      });
+      expect(status).toEqual(original);
+    },
+  );
+
+  it.each([
+    {
+      name: 'missing global counts',
+      make: () => ({
+        ...statusFor(reported),
+        generationUsage: { requests: 1 },
+      }),
+    },
+    {
+      name: 'contradictory global reports',
+      make: () => ({
+        ...statusFor(reported),
+        generationUsage: {
+          ...reported,
