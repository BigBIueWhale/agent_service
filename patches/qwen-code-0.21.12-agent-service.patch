+        exactTokenCounting: 'vllm' as const,
+      },
+    };
+    const config = new Config({
+      cwd: directory,
+      targetDir: directory,
+      debugMode: false,
+
+      usageStatisticsEnabled: false,
+      telemetry: { enabled: false },
+      disableAllHooks: true,
+      model: initial.model,
+      authType: initial.authType,
+      generationConfig: initial,
+      modelProvidersConfig: {
+        openai: [
