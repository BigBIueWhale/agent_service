+  config: Config;
+  chat: GeminiChat;
+  history: Content[];
+  countSideQuery: ReturnType<typeof vi.fn>;
+  generateText: ReturnType<typeof vi.fn>;
+  countCandidate: ReturnType<typeof vi.fn>;
+  firePreCompactEvent: ReturnType<typeof vi.fn>;
+  firePostCompactEvent: ReturnType<typeof vi.fn>;
+  debug: ReturnType<typeof vi.fn>;
+  warn: ReturnType<typeof vi.fn>;
+  generationConfig: GenerateContentConfig;
+  contentGeneratorConfig: {
+    model: string;
+    authType: AuthType;
+    exactTokenCounting?: 'vllm';
+    contextWindowSize: number;
+    enableCacheControl?: boolean;
+  };
+  setCompactionModel(model: string | undefined): void;
+  setHistory(history: Content[]): void;
+  setHookSystem(enabled: boolean): void;
+}
+
+function makeHarness(): Harness {
+  let history = baseHistory();
+  let compactionModel: string | undefined = MODEL;
+  let hooksEnabled = false;
+  const generationConfig: GenerateContentConfig & { kvScope?: string } = {
+    systemInstruction: 'main agent system prompt',
+    kvScope: 'agent-under-test',
+    tools: [{ functionDeclarations: [{ name: 'read_file' }] }],
+  };
+  const contentGeneratorConfig = {
+    model: MODEL,
+    authType: AuthType.USE_GEMINI,
+    exactTokenCounting: 'vllm' as const,
+    contextWindowSize: WINDOW,
+  };
+  // Two counts per compaction: the request, then the same request without
+  // the directive, so the directive's share can be checked against what it
+  // actually renders to.
+  const countSideQuery = vi
+    .fn()
+    .mockResolvedValue({ totalTokens: 195_000, maxModelLen: WINDOW })
+    .mockResolvedValueOnce({ totalTokens: 195_000, maxModelLen: WINDOW })
+    .mockResolvedValueOnce({
+      totalTokens: 195_000 - DIRECTIVE_TOKENS,
+      maxModelLen: WINDOW,
+    });
+  const generateText = vi.fn().mockResolvedValue(summaryResult());
+  const countCandidate = vi
+    .fn()
+    .mockResolvedValueOnce({ totalTokens: 230_000, maxModelLen: WINDOW })
+    .mockResolvedValueOnce({ totalTokens: 12_000, maxModelLen: WINDOW });
+  const firePreCompactEvent = vi.fn().mockResolvedValue(undefined);
+  const firePostCompactEvent = vi.fn().mockResolvedValue(undefined);
+  const debug = vi.fn();
+  const warn = vi.fn();
+  const hookSystem = {
+    firePreCompactEvent,
+    firePostCompactEvent,
+  };
+  const baseLlmClient = { countRequestTokens: countSideQuery, generateText };
+  const config = {
+    getChatCompression: () => ({
+      maxRecentFiles: 0,
+      maxRecentImages: 0,
+      enableScreenshotTrigger: false,
+    }),
+    getContentGeneratorConfig: () => contentGeneratorConfig,
+    getHookSystem: () => (hooksEnabled ? hookSystem : undefined),
+    getCompactionModel: () => compactionModel,
+    getModel: () => MODEL,
+    getBaseLlmClient: () => baseLlmClient,
+    getDebugLogger: () => ({ debug, warn }),
+    getTargetDir: () => '/workspace',
+    getApprovalMode: () => ApprovalMode.DEFAULT,
+    getBackgroundTaskRegistry: () => undefined,
+    getUsageStatisticsEnabled: () => false,
+    getSessionId: () => 'compaction-test-session',
+  } as unknown as Config;
+  const chat = {
+    getHistoryShallow: () => history.map((entry) => ({ ...entry })),
+    getGenerationConfig: () => ({ ...generationConfig }),
+    countRequestTokensForCandidateHistory: countCandidate,
+  } as unknown as GeminiChat;
+
+  return {
+    config,
+    chat,
+    get history() {
+      return history;
+    },
+    countSideQuery,
+    generateText,
+    countCandidate,
+    firePreCompactEvent,
+    firePostCompactEvent,
+    debug,
+    warn,
+    generationConfig,
+    contentGeneratorConfig,
+    setCompactionModel(model) {
+      compactionModel = model;
+    },
+    setHistory(next) {
+      history = next;
+    },
+    setHookSystem(enabled) {
+      hooksEnabled = enabled;
+    },
+  };
+}
