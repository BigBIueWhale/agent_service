+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import { describe, expect, it } from 'vitest';
+import type { ServedUsage } from '../core/served-usage.js';
+import { ApiDispatchEvent, ApiUsageEvent } from './types.js';
+import { EVENT_API_DISPATCH, EVENT_API_USAGE } from './constants.js';
+import type { GenerationObservation } from './generation-observations.js';
+import {
+  combineGenerationUsage,
+  formatGenerationUsage,
+  requireGenerationUsage,
+  summarizeGenerationUsage,
+  type GenerationUsageSummary,
+} from './generation-usage.js';
+
+const zero: ServedUsage = {
+  promptTokenCount: 0,
+  candidatesTokenCount: 0,
+  thoughtsTokenCount: 0,
+  cachedContentTokenCount: 0,
+  totalTokenCount: 0,
+};
+const served: ServedUsage = {
+  promptTokenCount: 10,
+  candidatesTokenCount: 4,
+  thoughtsTokenCount: 2,
+  cachedContentTokenCount: 3,
+  totalTokenCount: 14,
+};
+function observation(
+  usage: ServedUsage | null | 'unfinalized',
+): GenerationObservation {
+  const start = new ApiDispatchEvent('model', 'prompt', 'session', 'owner');
+  return {
+    dispatch: { ...start, 'event.name': EVENT_API_DISPATCH },
+    finalization:
+      usage === 'unfinalized'
+        ? null
+        : {
+            ...new ApiUsageEvent(start, 100, usage ?? undefined),
+            'event.name': EVENT_API_USAGE,
+          },
+  };
+}
+
+describe('summarizeGenerationUsage', () => {
+  it.each([
+    {
+      label: 'no dispatch',
+      observations: [],
+      requests: 0,
+      unfinalizedRequests: 0,
+      unreportedUsageRequests: 0,
+    },
+    {
+      label: 'unfinalized dispatch',
+      observations: [observation('unfinalized')],
+      requests: 1,
+      unfinalizedRequests: 1,
+      unreportedUsageRequests: 0,
+    },
+    {
+      label: 'finalized absent usage',
+      observations: [observation(null)],
+      requests: 1,
+      unfinalizedRequests: 0,
+      unreportedUsageRequests: 1,
+    },
+  ])(
+    'preserves absence for $label',
+    ({
+      observations,
+      requests,
+      unfinalizedRequests,
+      unreportedUsageRequests,
+    }) => {
+      expect(summarizeGenerationUsage(observations)).toEqual({
+        requests,
+        usageReports: 0,
+        unfinalizedRequests,
+        unreportedUsageRequests,
+        usage: null,
+      });
+    },
+  );
+
+  it('retains a reported all-zero usage separately from absence', () => {
+    expect(summarizeGenerationUsage([observation(zero)])).toEqual({
+      requests: 1,
+      usageReports: 1,
+      unfinalizedRequests: 0,
+      unreportedUsageRequests: 0,
+      usage: zero,
+    });
+  });
+
+  it('sums full served fields once while retaining every kind of missing observation', () => {
+    const result = summarizeGenerationUsage([
+      observation(served),
+      observation('unfinalized'),
+      observation(null),
+      observation(zero),
+      observation(served),
+    ]);
+    expect(result).toEqual({
+      requests: 5,
+      usageReports: 3,
+      unfinalizedRequests: 1,
+      unreportedUsageRequests: 1,
+      usage: {
+        promptTokenCount: 20,
+        candidatesTokenCount: 8,
+        thoughtsTokenCount: 4,
+        cachedContentTokenCount: 6,
+        totalTokenCount: 28,
+      },
+    });
+    expect(result.requests).toBe(
+      result.usageReports +
+        result.unfinalizedRequests +
+        result.unreportedUsageRequests,
+    );
+  });
+
+  it('returns independent totals without mutating retained observations', () => {
+    const source = observation(served);
+    const original = structuredClone(source);
+    const result = summarizeGenerationUsage([source]);
+    result.usage!.promptTokenCount = 999;
+    expect(source).toEqual(original);
+    expect(summarizeGenerationUsage([source]).usage).toEqual(served);
+  });
+
+  it('accepts an aggregate at the safe integer boundary', () => {
+    const largest: ServedUsage = {
+      ...zero,
+      promptTokenCount: Number.MAX_SAFE_INTEGER - 1,
+      candidatesTokenCount: 1,
+      totalTokenCount: Number.MAX_SAFE_INTEGER,
+    };
+    expect(
+      summarizeGenerationUsage([observation(largest), observation(zero)]).usage,
+    ).toEqual(largest);
