+ */
+
+import { existsSync, readFileSync } from 'node:fs';
+import { resolve } from 'node:path';
+import { describe, expect, it } from 'vitest';
+
+describe('Qwen3.8 locked agent-service initialization contract', () => {
+  it('disables ambient extension, hook, and skill initialization', () => {
+    const monorepoPath = resolve(
+      process.cwd(),
+      'packages/core/src/config/config.ts',
+    );
+    const source = readFileSync(
+      existsSync(monorepoPath)
+        ? monorepoPath
+        : resolve(process.cwd(), 'src/config/config.ts'),
+      'utf8',
+    );
+
+    expect(source).toMatch(
+      /!this\.isSafeMode\(\)\s*&&\s*!this\.getBareMode\(\)\s*&&\s*!this\.getForegroundAgentsOnly\(\)/,
+    );
+    expect(source).toMatch(
+      /!options\?\.skipHooks\s*&&\s*!this\.getDisableAllHooks\(\)\s*&&\s*!this\.getForegroundAgentsOnly\(\)/,
+    );
+    expect(source).toContain(
+      '!options?.skipSkillManager && !this.getForegroundAgentsOnly()',
+    );
+    expect(source).toMatch(
+      /!this\.getBareMode\(\)\s*&&\s*!this\.isSafeMode\(\)\s*&&\s*!this\.getForegroundAgentsOnly\(\)/,
+    );
+    expect(source).toMatch(
+      /getManagedAutoMemoryEnabled\(\)[\s\S]*?!this\.getForegroundAgentsOnly\(\)/,
+    );
+    expect(source).toMatch(
+      /isManagedMemoryAvailable\(\)[\s\S]*?!this\.getForegroundAgentsOnly\(\)/,
+    );
+    expect(source).toMatch(
+      /getManagedAutoDreamEnabled\(\)[\s\S]*?!this\.getForegroundAgentsOnly\(\)/,
+    );
+    expect(source).toMatch(
+      /getAutoSkillEnabled\(\)[\s\S]*?!this\.getForegroundAgentsOnly\(\)/,
+    );
+  });
+});
+
+function coreSource(relative: string): string {
+  const monorepoPath = resolve(process.cwd(), `packages/core/src/${relative}`);
+  return readFileSync(
+    existsSync(monorepoPath)
+      ? monorepoPath
+      : resolve(process.cwd(), `src/${relative}`),
+    'utf8',
+  );
+}
+
+describe('Qwen3.8 locked agent-service tool-parameter contract', () => {
+  // The ten native tools this deployment exposes, and nothing else.
+  const NATIVE_TOOL_SOURCES = [
+    'tools/agent/agent.ts',
+    'tools/edit.ts',
+    'tools/glob.ts',
+    'tools/ripGrep.ts',
+    'tools/ls.ts',
+    'tools/notebook-edit.ts',
+    'tools/read-file.ts',
+    'tools/shell.ts',
+    'tools/todoWrite.ts',
+    'tools/write-file.ts',
+  ];
+
+  it.each(NATIVE_TOOL_SOURCES)(
+    '[param-contract] %s declares its parameter schema closed',
+    (relative) => {
+      // A tool schema is the model's only map of what is callable and it is
+      // re-rendered into every request, so it is the surface that teaches.
+      // JSON Schema permits undeclared properties by default, which made an
+      // invented parameter name pass validation and then be dropped: the
+      // tool did something other than what was asked, and said nothing.
+      expect(coreSource(relative)).toContain('additionalProperties: false');
+    },
+  );
+
+  it.each(['tools/edit.ts', 'tools/write-file.ts'])(
+    '[param-contract] %s routes its runtime bookkeeping through a declared channel',
+    (relative) => {
+      // The modification flow re-enters build() with the edited parameters
+      // plus its own bookkeeping. Those names are enumerated in one place and
+      // removed before the schema check rather than declared in the schema,
+      // which would put them in front of the model; every other undeclared
+      // name is still refused.
+      const source = coreSource(relative);
+      expect(source).toContain('protected override get runtimeOnlyParams()');
+      expect(source).toContain(
+        "return ['ai_proposed_content', 'modified_by_user'];",
+      );
+      expect(source).toContain('additionalProperties: false');
+    },
+  );
+
+  it('[param-contract] no other native tool opens a runtime channel', () => {
+    // notebook_edit keeps its bookkeeping in a side map instead of the
+    // parameter object, which is the shape that removes the channel
+    // entirely. Nothing else needs one.
+    const withChannel = NATIVE_TOOL_SOURCES.filter((relative) =>
+      coreSource(relative).includes('runtimeOnlyParams'),
+    );
+    expect(withChannel.sort()).toEqual([
+      'tools/edit.ts',
+      'tools/write-file.ts',
+    ]);
+  });
+
+  it('[param-contract] the shared refusal runs before schema validation for every tool', () => {
+    const source = coreSource('tools/tools.ts');
+    expect(source).toContain('export function undeclaredToolParamsError(');
+    // Ordering matters: the shared refusal names the offending key and the
+    // accepted set, where Ajv's additionalProperties error does not.
+    const refusalAt = source.indexOf('const undeclared = undeclaredToolParamsError(');
+    const ajvAt = source.indexOf('const errors = SchemaValidator.validate(');
+    expect(refusalAt).toBeGreaterThan(-1);
+    expect(ajvAt).toBeGreaterThan(refusalAt);
+  });
+
+  it.each(['tools/agent/agent.ts', 'tools/todoWrite.ts'])(
+    '[param-contract] %s applies the shared refusal despite overriding validateToolParams',
+    (relative) => {
+      // Both replace the base class's validation wholesale, so neither runs
+      // Ajv at all. Without this call they would be the only tools that
+      // still drop a name they never declared.
+      const source = coreSource(relative);
+      expect(source).toContain('override validateToolParams(');
+      expect(source).toContain('undeclaredToolParamsError(');
+    },
