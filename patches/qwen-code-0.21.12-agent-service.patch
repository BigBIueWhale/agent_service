+    // agent.ts wrote the remedy here and the terse reason into error.message;
+    // the remedy was discarded before the model saw it.
+    expect(
+      mergeModelFacingFailureText(
+        'No active team. Use TeamCreate to start a team first.',
+        'No active team.',
+      ),
+    ).toBe('No active team. Use TeamCreate to start a team first.');
+  });
+
+  it('keeps an operational reason that exists only in error.message', () => {
+    // shell.ts: llmContent is the command output, error.message is the
+    // timeout summary. Preferring either half alone loses one of them.
+    expect(
+      mergeModelFacingFailureText(
+        'partial stdout before the cut',
+        'Command timed out after 120s.',
+      ),
+    ).toBe('partial stdout before the cut\nCommand timed out after 120s.');
+  });
+
+  it('falls back to the operational message when there is no model-facing text', () => {
+    expect(mergeModelFacingFailureText('', 'Path is a directory.')).toBe(
+      'Path is a directory.',
