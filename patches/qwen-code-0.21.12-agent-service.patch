--- /dev/null
+++ b/packages/core/src/telemetry/generation-observations.ts
@@ -0,0 +1,97 @@
+import { EVENT_API_DISPATCH, EVENT_API_USAGE } from './constants.js';
+import type { ApiDispatchEvent, ApiUsageEvent } from './types.js';
+import { requireServedUsage } from '../core/served-usage.js';
+
+type Dispatch = Omit<ApiDispatchEvent, 'event.name'> & {
+  'event.name': typeof EVENT_API_DISPATCH;
+};
+type Usage = Omit<ApiUsageEvent, 'event.name'> & {
+  'event.name': typeof EVENT_API_USAGE;
+};
+export type GenerationObservationEvent = Dispatch | Usage;
+export interface GenerationObservation {
+  readonly dispatch: Dispatch;
+  finalization: Usage | null;
+}
+
+export function validateGenerationObservationEvent(
+  event: GenerationObservationEvent | ApiDispatchEvent | ApiUsageEvent,
+): void {
+  for (const field of [
+    'request_id',
+    'model',
+    'session_id',
+    'kv_scope',
+  ] as const) {
+    if (typeof event[field] !== 'string' || !event[field].trim())
+      throw new Error(`Invalid generation ${field}`);
+  }
+  if (
+    typeof event.prompt_id !== 'string' ||
+    (event.subagent_name !== undefined &&
+      (typeof event.subagent_name !== 'string' ||
+        !event.subagent_name.trim())) ||
+    (event.auth_type !== undefined &&
+      (typeof event.auth_type !== 'string' || !event.auth_type.trim())) ||
+    typeof event['event.timestamp'] !== 'string' ||
+    !Number.isFinite(Date.parse(event['event.timestamp']))
+  ) {
+    throw new Error('Invalid generation attribution or timestamp');
+  }
+  if (
+    event['event.name'] === EVENT_API_USAGE ||
+    event['event.name'] === 'api_usage'
+  ) {
+    if (
+      !Number.isFinite(event.duration_ms) ||
+      event.duration_ms < 0 ||
+      (event.ttft_ms !== undefined &&
+        (!Number.isFinite(event.ttft_ms) || event.ttft_ms < 0))
+    ) {
+      throw new Error('Invalid generation duration');
+    }
+    if (event.served_usage !== null)
+      requireServedUsage(event.served_usage, 'Generation finalization');
+  }
+}
+
+/** The same dispatch/finalization contract owns live metrics and recorded replay. */
+export class GenerationObservations {
+  readonly #observations = new Map<string, GenerationObservation>();
+
+  add(event: GenerationObservationEvent): void {
+    validateGenerationObservationEvent(event);
+    const observation = this.#observations.get(event.request_id);
+    if (event['event.name'] === EVENT_API_DISPATCH) {
+      if (observation)
+        throw new Error(`Duplicate generation dispatch ${event.request_id}`);
+      this.#observations.set(event.request_id, {
+        dispatch: structuredClone(event),
+        finalization: null,
+      });
+      return;
+    }
+    if (!observation)
+      throw new Error(
+        `Generation finalization has no dispatch ${event.request_id}`,
+      );
+    if (observation.finalization)
+      throw new Error(`Duplicate generation finalization ${event.request_id}`);
+    for (const field of [
+      'model',
+      'session_id',
+      'kv_scope',
+      'prompt_id',
+      'auth_type',
+      'subagent_name',
+    ] as const) {
+      if (event[field] !== observation.dispatch[field])
+        throw new Error(`Generation finalization changed ${field}`);
+    }
+    observation.finalization = structuredClone(event);
+  }
+
+  values(): readonly GenerationObservation[] {
+    return [...this.#observations.values()];
+  }
+}
