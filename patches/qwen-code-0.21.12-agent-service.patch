+    goal_state: { v: 2, goal: null, activity: 'idle' },
+  },
+});
+
+describe('required runtime admission', () => {
+  it('retains the offending bytes and failure across an optional subscriber catch', () => {
+    const owner = new RuntimeContractAdmission();
+    const malformed = { ...idle(), event: { type: 'unknown' } };
+    let failure: unknown;
+    try {
+      owner.admit(malformed);
+    } catch (error) {
+      failure = error;
+    }
+    expect(failure).toBeInstanceOf(RuntimeContractViolation);
+    expect((failure as RuntimeContractViolation).evidence).toEqual({
+      state: 'serialized',
+      kind: 'wire_record',
+      recordBytes: JSON.stringify(malformed),
