+describe('safe displayed usage accumulation', () => {
+  function usageEvents(
+    usage: DaemonTurnUsage,
+    eventId: number,
+    parentToolCallId?: string,
+  ): DaemonUiEvent[] {
+    const events = normalizeDaemonEvent({
+      id: eventId,
+      v: 1,
+      type: 'session_update',
+      data: {
+        update: {
+          sessionUpdate: 'agent_message_chunk',
+          content: { type: 'text', text: '' },
+          _meta: {
+            ...(parentToolCallId ? { parentToolCallId } : {}),
+            usage: {
+              inputTokens: usage.inputTokens,
+              outputTokens: usage.outputTokens,
+              cachedReadTokens: usage.cachedTokens,
+              thoughtTokens: 0,
+              totalTokens: usage.inputTokens + usage.outputTokens,
+            },
+          },
+        },
+      },
+    });
+    expect(events).toEqual([
+      expect.objectContaining({ type: 'assistant.usage', usage }),
+    ]);
+    return events;
+  }
+
+  describe.each([
+    { scope: 'root', retainSubagentBlocks: true },
+    { scope: 'child retained', retainSubagentBlocks: true },
+    { scope: 'child compact', retainSubagentBlocks: false },
+  ])('$scope', ({ scope, retainSubagentBlocks }) => {
+    const parentToolCallId = scope === 'root' ? undefined : 'sum-child';
+    function initialState(): DaemonTranscriptState {
+      return reduceDaemonTranscriptEvents(
+        createDaemonTranscriptState({ now: 1, retainSubagentBlocks }),
+        [
+          { type: 'assistant.text.delta', text: 'Root answer' },
+          {
+            type: 'assistant.usage',
+            usage: { inputTokens: 0, outputTokens: 0, cachedTokens: 0 },
+          },
+          ...(parentToolCallId
+            ? [
+                {
+                  type: 'tool.update' as const,
+                  toolCallId: parentToolCallId,
+                  toolName: 'agent',
+                  status: 'running',
+                },
+                {
+                  type: 'assistant.text.delta' as const,
+                  text: 'Child answer',
+                  parentToolCallId,
+                },
+              ]
+            : []),
+        ],
+      );
+    }
+
+    it.each([
+      {
+        field: 'input',
+        first: {
+          inputTokens: Number.MAX_SAFE_INTEGER,
+          outputTokens: 0,
+          cachedTokens: 0,
+        },
+        next: { inputTokens: 1, outputTokens: 0, cachedTokens: 0 },
+      },
+      {
+        field: 'output',
+        first: {
+          inputTokens: 0,
+          outputTokens: Number.MAX_SAFE_INTEGER,
+          cachedTokens: 0,
+        },
+        next: { inputTokens: 0, outputTokens: 1, cachedTokens: 0 },
+      },
+      {
+        field: 'cached input',
+        first: {
+          inputTokens: Number.MAX_SAFE_INTEGER,
+          outputTokens: 0,
+          cachedTokens: Number.MAX_SAFE_INTEGER,
+        },
+        next: { inputTokens: 1, outputTokens: 0, cachedTokens: 1 },
+      },
+    ])(
+      'refuses unsafe $field sums of valid served observations',
+      ({ first, next }) => {
+        const state = reduceDaemonTranscriptEvents(
+          initialState(),
+          usageEvents(first, 11, parentToolCallId),
+        );
+        const retained = structuredClone(state);
+        const incoming = usageEvents(next, 12, parentToolCallId);
+        expect(() => reduceDaemonTranscriptEvents(state, incoming)).toThrow(
+          /usage|safe|overflow/i,
+        );
+        expect(state).toEqual(retained);
+      },
+    );
+
+    it('preserves exact represented counts at MAX while input plus output exceeds MAX', () => {
+      const first = {
+        inputTokens: Number.MAX_SAFE_INTEGER,
+        outputTokens: 0,
+        cachedTokens: Number.MAX_SAFE_INTEGER,
+      };
+      const second = { inputTokens: 0, outputTokens: 1, cachedTokens: 0 };
+      const zero = { inputTokens: 0, outputTokens: 0, cachedTokens: 0 };
+      const expected = { ...first, outputTokens: 1 };
+      const state = reduceDaemonTranscriptEvents(initialState(), [
+        ...usageEvents(first, 11, parentToolCallId),
+        ...usageEvents(second, 12, parentToolCallId),
+        ...usageEvents(zero, 13, parentToolCallId),
+      ]);
+      if (parentToolCallId) {
+        expect(state.blocks).toContainEqual(
+          expect.objectContaining({
+            kind: 'tool',
+            toolCallId: parentToolCallId,
+            reportedUsage: expected,
+          }),
+        );
+        expect(state.blocks).toContainEqual(
+          expect.objectContaining({
+            kind: 'assistant',
+            text: 'Root answer',
+            usage: zero,
+          }),
+        );
+        const child = state.blocks.filter(
+          (block) =>
+            block.kind === 'assistant' &&
+            block.parentToolCallId === parentToolCallId,
+        );
+        expect(child).toEqual(
+          retainSubagentBlocks
+            ? [expect.objectContaining({ usage: expected })]
+            : [],
+        );
+      } else {
+        expect(state.blocks).toContainEqual(
+          expect.objectContaining({
+            kind: 'assistant',
+            text: 'Root answer',
+            usage: expected,
+          }),
+        );
+      }
+    });
+  });
