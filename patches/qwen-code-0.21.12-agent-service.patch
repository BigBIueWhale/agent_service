+  it('names unserializable input and prevents any later admission', () => {
+    const owner = new RuntimeContractAdmission();
+    const cycle: Record<string, unknown> = {};
+    cycle['cycle'] = cycle;
+    expect(() => owner.admit(cycle)).toThrow('could not be serialized');
+    expect(() => owner.admit(idle())).toThrow('could not be serialized');
+  });
+
+  it('returns the exact validated JSON projection without changing its input', () => {
+    const owner = new RuntimeContractAdmission();
+    const record = idle();
+    const before = structuredClone(record);
+    expect(owner.admit(record)).toBe(JSON.stringify(before));
+    expect(record).toEqual(before);
+  });
+
+  it.each([NaN, Infinity, -Infinity])(
+    'refuses %s before JSON can substitute null',
+    (value) => {
+      const owner = new RuntimeContractAdmission();
+      const record = idle();
+      const malformed = {
+        ...record,
+        event: {
+          ...record.event,
+          goal_state: { v: 2, goal: value, activity: 'idle' },
+        },
+      };
+      // This projection would pass: no goal is a legitimate, different fact.
+      expect(
+        new RuntimeContractAdmission().admit(
+          JSON.parse(JSON.stringify(malformed)),
+        ),
+      ).toBeDefined();
+      expect(() => owner.admit(malformed)).toThrow('could not be serialized');
+      expect(() => owner.assertAvailable()).toThrow('could not be serialized');
+      expect(Object.is(malformed.event.goal_state.goal, value)).toBe(true);
