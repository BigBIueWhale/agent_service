--- /dev/null
+++ b/packages/sdk-typescript/scripts/copy-cli-distribution.js
@@ -0,0 +1,21 @@
+/**
+ * @license
+ * Copyright 2025 Qwen Team
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import { cpSync, statSync, rmSync } from 'node:fs';
+import { join } from 'node:path';
+
+export function copyCliDistribution(source, destination) {
+  if (
+    !statSync(source).isDirectory() ||
+    !statSync(join(source, 'cli.js')).isFile()
+  ) {
+    throw new Error(`CLI distribution is incomplete at ${source}`);
+  }
+  // Runtime resources include computed worker/skill/profile paths that do not
+  // occur in the JavaScript import graph. The distribution is the copy unit.
+  rmSync(destination, { recursive: true, force: true });
+  cpSync(source, destination, { recursive: true });
+}
