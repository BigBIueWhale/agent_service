--- /dev/null
+++ b/packages/cli/src/ui/hooks/useContextualTips.test.ts
@@ -0,0 +1,151 @@
+/**
+ * @license
+ * Copyright 2025 Google LLC
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import { cleanup, renderHook } from '@testing-library/react';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { partitionContextWindow, type Config } from '@qwen-code/qwen-code-core';
+import * as tips from '../../services/tips/index.js';
+import { StreamingState } from '../types.js';
+import { useContextualTips } from './useContextualTips.js';
+
+type Options = Parameters<typeof useContextualTips>[0];
+type Profile = Pick<
+  NonNullable<ReturnType<Config['getContentGeneratorConfig']>>,
+  'contextWindowSize'
+>;
+
+function createHarness(
+  profile: Profile | undefined,
+  overrides: Partial<Options> = {},
+) {
+  const select = vi.spyOn(tips, 'selectTip');
+  const history = {
+    sessionCount: 1,
+    isCooledDown: vi.fn(() => true),
+    getLastShown: vi.fn(() => 0),
+    recordShown: vi.fn(),
+  } as unknown as tips.TipHistory;
+  const options: Options = {
+    streamingState: StreamingState.Responding,
+    lastServedPromptTokenCount: 10_000_000,
+    sessionPromptCount: 10,
+    config: {
+      getContentGeneratorConfig: () => profile,
+    } as unknown as Config,
+    tipHistory: history,
+    addItem: vi.fn(),
+    hideTips: false,
+    ...overrides,
+  };
+  const rendered = renderHook(useContextualTips, { initialProps: options });
+  return { ...rendered, select, history, options };
+}
+
+afterEach(() => {
+  cleanup();
+  vi.restoreAllMocks();
+});
+
+describe('useContextualTips observed context', () => {
+  it.each([
+    ['provider not ready', undefined],
+    ['window not configured', {}],
+  ])('keeps the partition unknown when %s', (_name, profile) => {
+    const { rerender, options, select, history } = createHarness(profile);
+    rerender({ ...options, streamingState: StreamingState.Idle });
+
+    expect(select).toHaveBeenCalledOnce();
+    expect(select.mock.calls[0]?.[1].thresholds).toBeUndefined();
+    expect(options.addItem).not.toHaveBeenCalled();
+    expect(history.recordShown).not.toHaveBeenCalled();
+  });
+
+  it('uses the configured partition and records the selected tip once', () => {
+    const partition = partitionContextWindow(1_000_000);
+    const { rerender, options, select, history } = createHarness(
+      { contextWindowSize: partition.window },
+      { lastServedPromptTokenCount: partition.compactionTrigger },
+    );
+    rerender({ ...options, streamingState: StreamingState.Idle });
+    rerender({ ...options, streamingState: StreamingState.Idle });
+
+    expect(select).toHaveBeenCalledOnce();
+    expect(select.mock.calls[0]?.[1].thresholds).toEqual(partition);
+    expect(options.addItem).toHaveBeenCalledOnce();
+    expect(options.addItem).toHaveBeenCalledWith(
+      expect.objectContaining({
+        text: expect.stringContaining('Context is getting full.'),
+      }),
+      expect.any(Number),
+    );
+    expect(history.recordShown).toHaveBeenCalledExactlyOnceWith(
+      'context-high',
+      options.sessionPromptCount,
+    );
+  });
+
+  it.each([undefined, 0])(
+    'preserves served prompt count %s without triggering a context tip',
+    (lastServedPromptTokenCount) => {
+      const { rerender, options, select, history } = createHarness(
+        { contextWindowSize: 1_000_000 },
+        { lastServedPromptTokenCount },
+      );
+      rerender({ ...options, streamingState: StreamingState.Idle });
+      expect(select).toHaveBeenCalledOnce();
+      expect(select.mock.calls[0]?.[1].lastServedPromptTokenCount).toBe(
+        lastServedPromptTokenCount,
+      );
+      expect(options.addItem).not.toHaveBeenCalled();
+      expect(history.recordShown).not.toHaveBeenCalled();
+    },
+  );
+
+  it('waits through confirmation before evaluating the completed response', () => {
+    const { rerender, options, select } = createHarness({
+      contextWindowSize: 1_000_000,
+    });
+    rerender({
+      ...options,
+      streamingState: StreamingState.WaitingForConfirmation,
+    });
+    expect(select).not.toHaveBeenCalled();
+    rerender({ ...options, streamingState: StreamingState.Idle });
+    expect(select).toHaveBeenCalledOnce();
+  });
+
+  it('does not evaluate idle transitions without a response', () => {
+    const { rerender, options, select } = createHarness(
+      { contextWindowSize: 1_000_000 },
+      { streamingState: StreamingState.Idle },
+    );
+    rerender({
+      ...options,
+      streamingState: StreamingState.WaitingForConfirmation,
+    });
+    rerender({ ...options, streamingState: StreamingState.Idle });
+    expect(select).not.toHaveBeenCalled();
+  });
+
+  it.each(['hidden', 'history unavailable'])(
+    'clears the completed phase when tips are %s',
+    (reason) => {
+      const { rerender, options, select, history } = createHarness({
+        contextWindowSize: 1_000_000,
+      });
+      rerender({
+        ...options,
+        streamingState: StreamingState.Idle,
+        hideTips: reason === 'hidden',
+        tipHistory: reason === 'history unavailable' ? null : history,
+      });
+      rerender({ ...options, streamingState: StreamingState.Idle });
+      expect(select).not.toHaveBeenCalled();
+      expect(options.addItem).not.toHaveBeenCalled();
+      expect(history.recordShown).not.toHaveBeenCalled();
+    },
+  );
+});
