+import type { Config } from '../config/config.js';
+import { ApprovalMode } from '../config/config.js';
+import type { ChatRecord } from '../services/chatRecordingService.js';
+import { ChatCompressionService } from '../services/chatCompressionService.js';
+import { composePostCompactHistory } from '../services/postCompactAttachments.js';
+import { buildApiHistoryFromConversation } from '../services/session-api-history.js';
+import {
+  clearCacheSafeParams,
+  getCacheSafeParams,
+  saveCacheSafeParams,
+} from '../utils/forkedAgent.js';
+import { flatMapTextParts } from '../utils/partUtils.js';
+import {
+  carryHistoryInstructions,
+  retainDelegatedTask,
+  retainedInstructionParts,
+  retainUserInput,
+} from './authored-instructions.js';
+import type { GenerateTextResult } from './baseLlmClient.js';
+import { AuthType } from './contentGenerator.js';
