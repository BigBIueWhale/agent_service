+// @vitest-environment node
+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+import { build } from 'esbuild';
+import { spawn } from 'node:child_process';
+import { mkdtemp, realpath, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { dirname, join, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+// This exercises Linux process ownership in the same OS as the final-image gate.
+// Linux always executes this suite; other OSes lack this containment boundary.
+describe.skipIf(process.platform !== 'linux')(
+  'native relaunch and exit-cleanup ownership',
+  () => {
+    let ownedRoot: string;
+    let parentBundle: string;
+    let childBundle: string;
+    let passedCases = 0;
+    const totalCases = 10;
+    const fixtures = fileURLToPath(
+      new URL('./relaunch-ownership-fixtures/', import.meta.url),
+    );
+
+    beforeAll(async () => {
+      ownedRoot = await mkdtemp(join(tmpdir(), 'qwen-relaunch-ownership-'));
+      parentBundle = join(ownedRoot, 'parent.mjs');
+      childBundle = join(ownedRoot, 'child.mjs');
+      const relaunch = await realpath(
+        fileURLToPath(new URL('./relaunch.ts', import.meta.url)),
+      );
+      const cleanup = await realpath(
+        fileURLToPath(new URL('./cleanup.ts', import.meta.url)),
+      );
+      const coreCleanup = resolve(
+        dirname(cleanup),
+        '../../../core/src/utils/cleanup.ts',
+      );
+      await build({
+        entryPoints: {
+          parent: join(fixtures, 'parent.mjs'),
+          child: join(fixtures, 'child.mjs'),
+        },
+        outdir: ownedRoot,
+        outExtension: { '.js': '.mjs' },
+        bundle: true,
+        platform: 'node',
+        format: 'esm',
+        packages: 'external',
+        plugins: [
+          {
+            name: 'actual-owned-modules',
+            setup(builder) {
+              builder.onResolve({ filter: /^ACTUAL_RELAUNCH$/ }, () => ({
+                path: relaunch,
+              }));
+              builder.onResolve({ filter: /^ACTUAL_CLEANUP$/ }, () => ({
+                path: cleanup,
+              }));
+              // Select the actual pure implementation exported by the Core barrel;
+              // unrelated Core initialization is not part of this process fixture.
+              builder.onResolve(
+                { filter: /^@qwen-code\/qwen-code-core$/ },
+                (args) =>
+                  args.importer === cleanup ? { path: coreCleanup } : undefined,
+              );
+            },
+          },
+        ],
+      });
+    }, 30_000);
+
+    afterAll(async () => {
+      if (!ownedRoot) return;
+      if (passedCases === totalCases) {
+        await rm(ownedRoot, { recursive: true, force: true });
+      } else {
+        console.error(
+          `Native ownership failure evidence retained at ${ownedRoot}`,
+        );
+      }
+    });
+
+    it.each([
+      'ordinary_exit',
+      'spawn_error',
+      'term_parent_repeat',
+      'cleanup_group_repeat',
+      'after_spawn_throw',
+      'after_spawn_undefined',
+      'after_spawn_null',
+      'after_spawn_false',
+      'after_spawn_zero',
+      'after_spawn_empty',
+    ])(
+      '%s settles actual owned processes and preserves causes',
+      async (mode) => {
+        const result = await new Promise<{
+          code: number | null;
+          signal: NodeJS.Signals | null;
+          stdout: string;
+          stderr: string;
+        }>((resolveResult, reject) => {
+          // Python's Linux subreaper lets a failing test adopt and waitpid-join the
+          // leaked grandchild; existence polling alone would not establish a join.
+          const controller = spawn(
+            'python3',
+            [
+              '-I',
+              '-B',
+              join(fixtures, 'controller.py'),
+              ownedRoot,
+              process.execPath,
+              parentBundle,
+              childBundle,
+              mode,
+            ],
+            { stdio: ['ignore', 'pipe', 'pipe'] },
+          );
+          let stdout = '';
+          let stderr = '';
+          controller.stdout.on('data', (bytes: Buffer) => {
+            stdout += bytes.toString();
+          });
+          controller.stderr.on('data', (bytes: Buffer) => {
+            stderr += bytes.toString();
+          });
+          controller.once('error', reject);
+          controller.once('close', (code, signal) => {
+            resolveResult({ code, signal, stdout, stderr });
+          });
+        });
+        expect(result, JSON.stringify(result)).toMatchObject({
+          code: 0,
+          signal: null,
+        });
+        const lines = result.stdout.trim().split('\n');
+        const evidence = JSON.parse(lines.at(-1)!);
+        expect(evidence.final_owned_processes_absent).toBe(true);
+        expect(evidence.status).not.toBe('FIXTURE_OR_ASSERTION_FAILURE');
+        passedCases++;
+      },
+      40_000,
+    );
+  },
+);
