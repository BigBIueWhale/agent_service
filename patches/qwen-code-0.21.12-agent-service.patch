+      generationUsage: noRequests,
+      note: '0 requests, 0 usage reports, 0 without usage, 0 unfinalized',
+    },
+    {
+      name: 'reported zero',
+      generationUsage: reportedZero,
+      note: '0 reported tokens (in 0, out 0)',
+    },
+    {
+      name: 'unfinalized',
+      generationUsage: { ...noRequests, requests: 1, unfinalizedRequests: 1 },
+      note: '1 requests, 0 usage reports, 0 without usage, 1 unfinalized',
+    },
+    {
+      name: 'finalized unknown',
+      generationUsage: {
+        ...noRequests,
+        requests: 1,
+        unreportedUsageRequests: 1,
+      },
+      note: '1 requests, 0 usage reports, 1 without usage, 0 unfinalized',
+    },
+  ])(
+    'renders explicit $name accounting in overview',
+    ({ generationUsage, note }) => {
+      const el = render(statusFor(generationUsage));
+      expect(el.textContent).toContain(note);
+      if (generationUsage.usage === null)
+        expect(el.textContent).toContain('No served usage reported');
+      expect(el.textContent).toContain('1.0s');
