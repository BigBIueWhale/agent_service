+/**
+ * The stored payloads a rendered history refers to, oldest first.
+ *
+ * A history that has been rendered once carries references rather than
+ * payloads, so the set of images a render reattaches is read back from the
+ * references the history holds. That makes every render of one history
+ * produce the same request, which is what lets a request be counted and then
+ * sent.
+ */
+export function referencedImagePayloads(
+  contents: Content[],
+  store: ImagePayloadStore,
+): StoredImagePayload[] {
+  const found: StoredImagePayload[] = [];
+  const seen = new Set<string>();
+  for (const content of contents) {
+    for (const id of collectReferencedImageIds(content)) {
+      if (seen.has(id)) continue;
+      seen.add(id);
+      const stored = store.get(id);
+      if (stored) found.push(stored);
+    }
+  }
+  return found;
+}
