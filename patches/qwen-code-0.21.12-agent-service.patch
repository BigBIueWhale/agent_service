diff --git a/scripts/stream-contract-assets.js b/scripts/stream-contract-assets.js
--- /dev/null
+++ b/scripts/stream-contract-assets.js
@@ -0,0 +1,83 @@
+import { createHash } from 'node:crypto';
+import { lstatSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { isDeepStrictEqual } from 'node:util';
+
+const receiptName = 'stream-binding-manifest.json';
+const modules = [
+  'stream-record-validator',
+  'goal-snapshot-validator',
+  'outbound-control-validator',
+];
+const names = [
+  'stream-contract.ts',
+  ...modules.flatMap((name) => [`${name}.js`, `${name}.d.ts`]),
+].sort();
+const digest = (bytes) => createHash('sha256').update(bytes).digest('hex');
+
+function readRegular(path) {
+  if (!lstatSync(path).isFile())
+    throw new Error(`Stream contract asset is not a regular file: ${path}`);
+  return readFileSync(path);
+}
+
+export function readStreamContract(root) {
+  const source = join(root, 'packages/core/src/generated');
+  const bytes = readRegular(join(source, receiptName));
+  const receipt = JSON.parse(
+    new TextDecoder('utf-8', { fatal: true }).decode(bytes),
+  );
+  if (
+    receipt === null ||
+    typeof receipt !== 'object' ||
+    Array.isArray(receipt) ||
+    receipt.v !== 1 ||
+    receipt.files === null ||
+    typeof receipt.files !== 'object' ||
+    Array.isArray(receipt.files) ||
+    !isDeepStrictEqual(Object.keys(receipt.files).sort(), names) ||
+    ![
+      receipt.schema_sha256,
+      receipt.generator_sha256,
+      receipt.package_lock_sha256,
+    ].every(
+      (value) => typeof value === 'string' && /^[a-f0-9]{64}$/.test(value),
+    )
+  ) {
+    throw new Error('Stream contract binding receipt is incomplete or invalid');
+  }
+  if (
+    digest(readRegular(join(root, 'package-lock.json'))) !==
+    receipt.package_lock_sha256
+  ) {
+    throw new Error(
+      'Stream contract binding dependencies differ from the source lock',
+    );
+  }
+  const files = new Map([[receiptName, bytes]]);
+  for (const name of names) {
+    const content = readRegular(join(source, name));
+    if (digest(content) !== receipt.files[name])
+      throw new Error(`Stream contract binding changed: ${name}`);
+    files.set(name, content);
+  }
+  return files;
+}
+
+export function copyCoreStreamContract(root) {
+  const files = readStreamContract(root);
+  const destination = join(root, 'packages/core/dist/src/generated');
+  mkdirSync(destination, { recursive: true });
+  for (const [name, bytes] of files) {
+    // TypeScript compiles the authored constants; the compiler-generated
+    // JavaScript validators and their declarations are already final modules.
+    if (name === 'stream-contract.ts') continue;
+    writeFileSync(join(destination, name), bytes);
+  }
+}
+
+export function copyBundleStreamContract(root, destination) {
+  const files = readStreamContract(root);
+  mkdirSync(destination, { recursive: true });
+  writeFileSync(join(destination, receiptName), files.get(receiptName));
+}
