+describe('combineDaemonTurnUsage', () => {
+  it('leaves usage absent only when both observations are absent', () => {
+    expect(combineDaemonTurnUsage(undefined, undefined)).toBeUndefined();
+  });
+
+  it.each(['left', 'right'] as const)(
+    'preserves an observed zero on the %s',
+    (side) => {
+      const zero = Object.freeze({
+        inputTokens: 0,
+        outputTokens: 0,
+        cachedTokens: 0,
+      });
+      const result = combineDaemonTurnUsage(
+        side === 'left' ? zero : undefined,
+        side === 'right' ? zero : undefined,
+      );
+      expect(result).toEqual(zero);
+      expect(result).not.toBe(zero);
+    },
+  );
+
+  it.each(['left', 'right'] as const)(
+    'detaches the three displayed counts from the %s observation',
+    (side) => {
+      const observation = Object.freeze({
+        inputTokens: 7,
+        outputTokens: 4,
+        cachedTokens: 3,
+        details: { requestId: 'request-local' },
+      });
+      const result = combineDaemonTurnUsage(
+        side === 'left' ? observation : undefined,
+        side === 'right' ? observation : undefined,
+      );
+      expect(result).toEqual({
+        inputTokens: 7,
+        outputTokens: 4,
+        cachedTokens: 3,
+      });
+      expect(result).not.toBe(observation);
+      if (!result)
+        throw new Error('An observed report must retain displayed usage');
+      result.cachedTokens = 0;
+      expect(observation.cachedTokens).toBe(3);
+    },
+  );
+
+  it('adds observed counts without changing either operand or adding cache twice', () => {
+    const first = Object.freeze({
+      inputTokens: 7,
+      outputTokens: 4,
+      cachedTokens: 3,
+    });
+    const second = Object.freeze({
+      inputTokens: 5,
+      outputTokens: 2,
+      cachedTokens: 5,
+    });
+    const result = combineDaemonTurnUsage(first, second);
+    expect(result).toEqual({
+      inputTokens: 12,
+      outputTokens: 6,
+      cachedTokens: 8,
+    });
+    expect(result).not.toBe(first);
+    expect(result).not.toBe(second);
+    expect(first).toEqual({ inputTokens: 7, outputTokens: 4, cachedTokens: 3 });
+    expect(second).toEqual({
+      inputTokens: 5,
+      outputTokens: 2,
+      cachedTokens: 5,
+    });
+  });
+
+  it.each(['inputTokens', 'outputTokens', 'cachedTokens'] as const)(
+    'refuses malformed %s on either operand',
+    (field) => {
+      const valid = { inputTokens: 7, outputTokens: 4, cachedTokens: 3 };
+      for (const value of [
+        undefined,
+        null,
+        -1,
+        1.5,
+        NaN,
+        Infinity,
+        Number.MAX_SAFE_INTEGER + 1,
+        '1',
+      ]) {
+        const invalid = {
+          inputTokens: 2,
+          outputTokens: 1,
+          cachedTokens: 1,
+          [field]: value,
+        } as unknown as DaemonTurnUsage;
+        expect(() => combineDaemonTurnUsage(invalid, valid)).toThrow(/usage/i);
+        expect(() => combineDaemonTurnUsage(valid, invalid)).toThrow(/usage/i);
+      }
+    },
+  );
+
+  it.each(['left', 'right'] as const)(
+    'refuses excess cache on the %s even when the other input would mask it',
+    (side) => {
+      const invalid = { inputTokens: 1, outputTokens: 0, cachedTokens: 2 };
+      const valid = { inputTokens: 100, outputTokens: 0, cachedTokens: 0 };
+      expect(() =>
+        combineDaemonTurnUsage(
+          side === 'left' ? invalid : valid,
+          side === 'right' ? invalid : valid,
+        ),
