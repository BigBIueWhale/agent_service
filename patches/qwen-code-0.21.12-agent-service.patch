+  thoughtsTokenCount: 0,
+  cachedContentTokenCount: 0,
+};
+
+describe('served token counts', () => {
+  it.each([0, -0, 1, Number.MAX_SAFE_INTEGER])(
+    'accepts exact count %s',
+    (value) => {
+      expect(isTokenCount(value)).toBe(true);
+    },
+  );
+
+  it.each([
+    undefined,
+    null,
+    false,
+    '0',
+    {},
+    [],
+    0n,
+    Symbol('count'),
+    NaN,
+    Infinity,
+    -Infinity,
+    -1,
+    0.5,
+    Number.MAX_SAFE_INTEGER + 1,
+  ])('refuses a non-count without coercion: %s', (value) => {
+    expect(isTokenCount(value)).toBe(false);
+  });
+
+  it('preserves measured zero and exact boundary values', () => {
+    expect(requireServedUsage(zero, 'test')).toEqual(zero);
+    const maximum = {
+      ...zero,
+      totalTokenCount: Number.MAX_SAFE_INTEGER,
+      promptTokenCount: Number.MAX_SAFE_INTEGER,
+      cachedContentTokenCount: Number.MAX_SAFE_INTEGER,
+    };
+    expect(requireServedUsage(maximum, 'test')).toEqual(maximum);
+  });
+
+  it.each(Object.keys(zero))('names the invalid required field %s', (field) => {
+    const incomplete = { ...zero, [field]: undefined };
+    expect(() => requireServedUsage(incomplete, 'test')).toThrow(
+      `test: invalid served usage (${field})`,
+    );
+    expect(incomplete[field as keyof typeof zero]).toBeUndefined();
+  });
+
+  it.each([
+    { ...zero, totalTokenCount: 1 },
+    { ...zero, thoughtsTokenCount: 1 },
+    { ...zero, cachedContentTokenCount: 1 },
+    {
+      ...zero,
+      totalTokenCount: Number.MAX_SAFE_INTEGER,
+      promptTokenCount: Number.MAX_SAFE_INTEGER,
+      candidatesTokenCount: 1,
+    },
+  ])('names inconsistent count relationships', (usage) => {
+    const original = structuredClone(usage);
+    expect(() => requireServedUsage(usage, 'test')).toThrow(
+      'test: invalid served usage (relationships)',
+    );
+    expect(usage).toEqual(original);
+  });
+});
