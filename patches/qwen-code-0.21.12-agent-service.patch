diff --git a/packages/core/src/telemetry/generation-usage.ts b/packages/core/src/telemetry/generation-usage.ts
--- /dev/null
+++ b/packages/core/src/telemetry/generation-usage.ts
@@ -0,0 +1,111 @@
+import type { GenerationUsageSummary } from './generation-usage-types.js';
+export type { GenerationUsageSummary } from './generation-usage-types.js';
+import { requireServedUsage } from '../core/served-usage.js';
+import type { GenerationObservation } from './generation-observations.js';
+
+export function summarizeGenerationUsage(
+  observations: readonly GenerationObservation[],
+): GenerationUsageSummary {
+  return combineGenerationUsage(
+    observations.map(({ finalization }) => ({
+      requests: 1,
+      usageReports: finalization?.served_usage ? 1 : 0,
+      unfinalizedRequests: finalization === null ? 1 : 0,
+      unreportedUsageRequests: finalization?.served_usage === null ? 1 : 0,
+      usage: finalization?.served_usage ?? null,
+    })),
+  );
+}
+
+/** Combines observations already summarized at a session, model or source boundary. */
+export function combineGenerationUsage(
+  summaries: Iterable<GenerationUsageSummary>,
+): GenerationUsageSummary {
+  const combined: GenerationUsageSummary = {
+    requests: 0,
+    usageReports: 0,
+    unfinalizedRequests: 0,
+    unreportedUsageRequests: 0,
+    usage: null,
+  };
+  for (const input of summaries) {
+    const summary = requireGenerationUsage(input);
+    for (const key of [
+      'requests',
+      'usageReports',
+      'unfinalizedRequests',
+      'unreportedUsageRequests',
+    ] as const) {
+      combined[key] += summary[key];
+    }
+    if (summary.usage !== null) {
+      if (combined.usage === null) {
+        combined.usage = {
+          promptTokenCount: summary.usage.promptTokenCount,
+          candidatesTokenCount: summary.usage.candidatesTokenCount,
+          thoughtsTokenCount: summary.usage.thoughtsTokenCount,
+          cachedContentTokenCount: summary.usage.cachedContentTokenCount,
+          totalTokenCount: summary.usage.totalTokenCount,
+        };
+      } else {
+        for (const key of [
+          'promptTokenCount',
+          'candidatesTokenCount',
+          'thoughtsTokenCount',
+          'cachedContentTokenCount',
+          'totalTokenCount',
+        ] as const) {
+          combined.usage[key] += summary.usage[key];
+        }
+      }
+    }
+    requireGenerationUsage(combined);
+  }
+  return combined;
+}
+
+/** Decode a recorded summary without turning missing reports into zero usage. */
+export function requireGenerationUsage(value: unknown): GenerationUsageSummary {
+  if (!value || typeof value !== 'object' || Array.isArray(value))
+    throw new Error('Invalid generation usage summary');
+  const summary = value as GenerationUsageSummary;
+  for (const key of [
+    'requests',
+    'usageReports',
+    'unfinalizedRequests',
+    'unreportedUsageRequests',
+  ] as const) {
+    if (!Number.isSafeInteger(summary[key]) || summary[key] < 0)
+      throw new Error(`Invalid generation usage ${key}`);
+  }
+  if (
+    summary.requests !==
+      summary.usageReports +
+        summary.unfinalizedRequests +
+        summary.unreportedUsageRequests ||
+    (summary.usageReports === 0) !== (summary.usage === null)
+  ) {
+    throw new Error('Inconsistent generation usage observations');
+  }
+  if (summary.usage !== null)
+    requireServedUsage(summary.usage, 'Generation summary');
+  return summary;
+}
+
+export function formatGenerationUsage(summary: GenerationUsageSummary): string {
+  const usage = summary.usage;
+  const tokens = usage
+    ? `${usage.totalTokenCount.toLocaleString()} reported tokens (in ${usage.promptTokenCount.toLocaleString()}, out ${usage.candidatesTokenCount.toLocaleString()})`
+    : 'No served usage reported';
+  return `${tokens}; ${summary.requests} requests, ${summary.usageReports} usage reports, ${summary.unreportedUsageRequests} without usage, ${summary.unfinalizedRequests} unfinalized`;
+}
+
+/** A fixed-size status for one-line task lists; detail views retain the counts. */
+export function formatGenerationUsageStatus(
+  summary: GenerationUsageSummary,
+): string {
+  if (summary.requests === 0) return 'no requests';
+  if (summary.unfinalizedRequests > 0 || summary.unreportedUsageRequests > 0)
+    return 'usage incomplete';
+  return 'usage reported';
+}
