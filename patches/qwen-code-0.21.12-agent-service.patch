diff --git a/packages/cli/src/utils/output-writer.ts b/packages/cli/src/utils/output-writer.ts
--- /dev/null
+++ b/packages/cli/src/utils/output-writer.ts
@@ -0,0 +1,69 @@
+/** Ordered writes whose completion belongs to the output owner's lifetime. */
+export class OutputWriter {
+  private pending = 0;
+  private failure: { error: unknown } | undefined;
+  private readonly waiters = new Set<() => void>();
+
+  constructor(private readonly stream: NodeJS.WritableStream) {
+    stream.on('error', (error: unknown) => this.fail(error));
+    stream.on('close', () => this.fail(new Error('Output stream closed')));
+  }
+
+  private fail(error: unknown): void {
+    this.failure ??= { error };
+    this.notify();
+  }
+
+  private notify(): void {
+    if (this.pending === 0 || this.failure) {
+      for (const resolve of this.waiters) resolve();
+      this.waiters.clear();
+    }
+  }
+
+  write(bytes: string): void {
+    if (this.failure) throw this.failure.error;
+    this.pending++;
+    let completed = false;
+    const complete = (error?: Error | null) => {
+      if (completed) return;
+      completed = true;
+      this.pending--;
+      if (error != null) this.fail(error);
+      this.notify();
+    };
+    try {
+      this.stream.write(bytes, complete);
+    } catch (error) {
+      complete();
+      this.fail(error);
+      throw error;
+    }
+  }
+
+  async flush(): Promise<void> {
+    while (this.pending > 0 && !this.failure) {
+      await new Promise<void>((resolve) => this.waiters.add(resolve));
+    }
+    if (this.failure) throw this.failure.error;
+  }
+}
+
+const writers = new WeakMap<NodeJS.WritableStream, OutputWriter>();
+export function outputWriter(stream: NodeJS.WritableStream): OutputWriter {
+  let writer = writers.get(stream);
+  if (!writer) {
+    writer = new OutputWriter(stream);
+    writers.set(stream, writer);
+  }
+  return writer;
+}
+
+/** Includes writes made by a renderer directly to this same ordered stream. */
+export async function flushOutput(
+  stream: NodeJS.WritableStream,
+): Promise<void> {
+  const writer = outputWriter(stream);
+  writer.write('');
+  await writer.flush();
+}
