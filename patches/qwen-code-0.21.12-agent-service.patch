+/**
+ * @license
+ * Copyright 2026 Qwen
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import * as fs from 'node:fs/promises';
+import * as path from 'node:path';
+import { createHash } from 'node:crypto';
+import lockfile from 'proper-lockfile';
+import type { Config } from '../config/config.js';
+import { syncDirectoryAncestors } from './durable-path.js';
+import { runCleanupSteps, withCleanup } from './cleanup.js';
+
+export const MAX_SESSION_ARTIFACT_BYTES = 500 * 1024 * 1024;
+
+export function sessionArtifactDirectory(config: Config): string {
+  const sessionId = config.getSessionId();
+  if (!sessionId) throw new Error('Session artifacts require a session owner.');
+  return path.join(
+    config.storage.getProjectDir(),
+    'session-artifacts',
+    createHash('sha256').update(sessionId).digest('hex'),
+  );
+}
+
+/**
+ * Immutable, session-owned bytes. Paths can outlive a chat through forks or
+ * exports, so only an explicit disposal of those references can retire them.
+ * The files themselves are the durable quota ledger, including crash remnants.
+ */
+export async function persistSessionArtifact(
+  config: Config,
+  bytes: Uint8Array,
+  extension: string,
+): Promise<{ filepath: string; size: number }> {
+  if (!/^[a-z0-9]+$/.test(extension)) {
+    throw new Error('Invalid session artifact extension.');
+  }
+  const directory = sessionArtifactDirectory(config);
+  await fs.mkdir(directory, { recursive: true, mode: 0o700 });
+  if (!(await fs.lstat(directory)).isDirectory()) {
+    throw new Error('Session artifact directory must be a directory.');
+  }
+  // Never steal a lock on an elapsed-time assumption. A paused writer may
+  // still own it; a crashed writer leaves an explicit administrative refusal.
+  const release = await lockfile.lock(directory, {
+    stale: Number.MAX_SAFE_INTEGER,
+    update: 10_000,
+    retries: { retries: 100, minTimeout: 10, maxTimeout: 100 },
+  });
+  return withCleanup(async () => {
+    const filename = `${createHash('sha256').update(bytes).digest('hex')}.${extension}`;
+    const filepath = path.join(directory, filename);
+    let used = 0;
+    let exists = false;
+    for (const entry of await fs.readdir(directory)) {
+      const stat = await fs.lstat(path.join(directory, entry));
+      if (!stat.isFile()) {
+        throw new Error(`Invalid session artifact: ${entry}`);
+      }
+      used += stat.size;
+      exists ||= entry === filename;
+    }
+    if (exists) {
+      const file = await fs.open(filepath, 'r');
+      await withCleanup(
+        async () => {
+          if (!Buffer.from(bytes).equals(await file.readFile())) {
+            throw new Error(`Session artifact integrity failure: ${filepath}`);
+          }
+          await file.sync();
+        },
+        () => file.close(),
+      );
+      await syncDirectoryAncestors(directory);
+      return { filepath, size: bytes.byteLength };
+    }
+    if (used + bytes.byteLength > MAX_SESSION_ARTIFACT_BYTES) {
+      throw new Error(
+        `Session artifact disk budget exhausted: ${used} bytes retained, ${bytes.byteLength} requested, ${MAX_SESSION_ARTIFACT_BYTES} allowed.`,
+      );
+    }
+    const file = await fs.open(filepath, 'wx', 0o400);
+    await withCleanup(
+      async () => {
+        try {
+          await file.writeFile(bytes);
+          await file.sync();
+        } catch (error) {
+          await runCleanupSteps([
+            () => {
+              throw error;
+            },
+            () => fs.unlink(filepath),
+          ]);
+        }
+      },
+      () => file.close(),
+    );
+    await syncDirectoryAncestors(directory);
+    return { filepath, size: bytes.byteLength };
+  }, release);
+}
