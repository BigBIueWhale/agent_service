-      if (tag === 0x0100) {
-        // ImageWidth
-        width = value;
-      } else if (tag === 0x0101) {
-        // ImageLength (height)
-        height = value;
-      }
-
-      if (width > 0 && height > 0) break;
-    }
-
-    if (width === 0 || height === 0) {
