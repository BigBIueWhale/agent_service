+"""Linux native-process probe; deadlines bound tests, never prove settlement."""
+
+import ctypes
+import json
+import os
+from pathlib import Path
+import signal
+import subprocess
+import sys
+import time
+import traceback
+
+
+def process_state(pid):
+    try:
+        text = Path(f"/proc/{pid}/stat").read_text()
+    except (FileNotFoundError, ProcessLookupError):
+        return None
+    fields = text[text.rfind(")") + 2 :].split()
+    return {
+        "pid": pid,
+        "state": fields[0],
+        "ppid": int(fields[1]),
+        "pgid": int(fields[2]),
+        "sid": int(fields[3]),
+        "starttime": fields[19],
+    }
+
+
+def wait_for(predicate, seconds=5):
+    deadline = time.monotonic() + seconds
+    while time.monotonic() < deadline:
+        value = predicate()
+        if value:
+            return value
+        time.sleep(0.005)
+    raise TimeoutError("bounded fixture watchdog expired")
+
+
+def read_json(path):
+    try:
+        return json.loads(path.read_text())
+    except (FileNotFoundError, json.JSONDecodeError):
+        return None
+
+
+def read_events(path, *, settled=False):
+    try:
+        data = path.read_bytes()
+    except FileNotFoundError:
+        return []
+    complete, _, tail = data.rpartition(b"\n")
+    if settled and tail:
+        raise ValueError(f"unterminated fixture event evidence: {path}")
+    if not complete:
+        return []
+    return [json.loads(line) for line in complete.split(b"\n")]
+
+
+def signal_controller_stop(signum, frame):
+    for name in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
+        signal.signal(name, signal.SIG_IGN)
+    raise RuntimeError("native ownership controller cancelled")
+
+
+def run(root, node, parent_bundle, child_bundle, mode):
+    case = root / mode
+    case.mkdir(parents=True, exist_ok=False)
+    result = {
+        "case": mode,
+        "controller_pid": os.getpid(),
+        "signals": [],
+        "observations": [],
+        "containment": [],
+        "identities": {},
+        "cleanup_errors": [],
+    }
+    children = {}
+    parent = None
+    parent_identity = None
