+/**
+ * @license
+ * Copyright 2026 Qwen
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { open, type FileHandle } from 'node:fs/promises';
+import { syncDirectoryAncestors } from './durable-path.js';
+
+vi.mock('node:fs/promises', () => ({ open: vi.fn() }));
+
+describe('syncDirectoryAncestors', () => {
+  const sync = vi.fn<FileHandle['sync']>();
+  const close = vi.fn<FileHandle['close']>();
+
+  beforeEach(() => {
+    vi.resetAllMocks();
+    sync.mockResolvedValue(undefined);
+    close.mockResolvedValue(undefined);
+    vi.mocked(open).mockResolvedValue({ sync, close } as unknown as FileHandle);
+  });
+
+  it('synchronizes and closes each directory through the filesystem root', async () => {
+    const operations: string[] = [];
+    vi.mocked(open).mockImplementation(async (directory) => {
+      operations.push(`open:${String(directory)}`);
+      return {
+        sync: async () => {
+          operations.push(`sync:${String(directory)}`);
+        },
+        close: async () => {
+          operations.push(`close:${String(directory)}`);
+        },
+      } as FileHandle;
+    });
+
+    await syncDirectoryAncestors('/durability-owner/nested');
+
+    expect(vi.mocked(open).mock.calls).toEqual([
+      ['/durability-owner/nested', 'r'],
+      ['/durability-owner', 'r'],
+      ['/', 'r'],
+    ]);
+    expect(operations).toEqual([
+      'open:/durability-owner/nested',
+      'sync:/durability-owner/nested',
+      'close:/durability-owner/nested',
+      'open:/durability-owner',
+      'sync:/durability-owner',
+      'close:/durability-owner',
+      'open:/',
+      'sync:/',
+      'close:/',
+    ]);
+  });
+
+  it('closes the acquired handle and preserves a synchronization failure', async () => {
+    const cause = new Error('directory fsync failed');
+    sync.mockRejectedValueOnce(cause);
+
+    await expect(syncDirectoryAncestors('/durability-owner')).rejects.toBe(
+      cause,
+    );
+
+    expect(sync).toHaveBeenCalledOnce();
+    expect(close).toHaveBeenCalledOnce();
+    expect(open).toHaveBeenCalledOnce();
+  });
+
+  it('reports a close failure after successful synchronization', async () => {
+    const cause = new Error('directory close failed');
+    close.mockRejectedValueOnce(cause);
+
+    await expect(syncDirectoryAncestors('/durability-owner')).rejects.toBe(
+      cause,
+    );
+
+    expect(sync).toHaveBeenCalledOnce();
+    expect(close).toHaveBeenCalledOnce();
+    expect(open).toHaveBeenCalledOnce();
+  });
+
+  it('preserves an open failure without inventing an acquired handle', async () => {
+    const cause = new Error('directory open failed');
+    vi.mocked(open).mockRejectedValueOnce(cause);
+
+    await expect(syncDirectoryAncestors('/durability-owner')).rejects.toBe(
+      cause,
+    );
+
+    expect(sync).not.toHaveBeenCalled();
+    expect(close).not.toHaveBeenCalled();
+    expect(open).toHaveBeenCalledOnce();
+  });
+
+  it.each([
+    ['Error', new Error('directory fsync failed')],
+    ['undefined', undefined],
+    ['null', null],
+    ['false', false],
+    ['zero', 0],
+    ['empty string', ''],
+  ] as const)(
+    'retains both %s synchronization failure and close failure',
+    async (_label, cause) => {
+      const closeFailure = new Error('directory close failed');
+      sync.mockRejectedValueOnce(cause);
+      close.mockRejectedValueOnce(closeFailure);
+
+      const outcome = await syncDirectoryAncestors('/durability-owner').then(
+        () => ({ status: 'fulfilled' as const }),
+        (error: unknown) => ({ status: 'rejected' as const, error }),
+      );
+
+      expect(sync).toHaveBeenCalledOnce();
+      expect(close).toHaveBeenCalledOnce();
+      expect(open).toHaveBeenCalledOnce();
+      expect(outcome.status).toBe('rejected');
+      if (outcome.status !== 'rejected') throw new Error('Expected rejection');
+      expect(outcome.error).toBeInstanceOf(AggregateError);
+      if (!(outcome.error instanceof AggregateError)) {
+        throw new Error('Expected all cleanup failures');
+      }
+      expect(outcome.error.errors).toEqual([cause, closeFailure]);
+      expect(outcome.error.errors[0]).toBe(cause);
+      expect(outcome.error.errors[1]).toBe(closeFailure);
+    },
+  );
+});
diff --git a/packages/core/src/utils/durable-path.ts b/packages/core/src/utils/durable-path.ts
--- /dev/null
+++ b/packages/core/src/utils/durable-path.ts
@@ -0,0 +1,20 @@
+/**
+ * @license
+ * Copyright 2026 Qwen
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import { open } from 'node:fs/promises';
+import { dirname } from 'node:path';
+import { withCleanup } from './cleanup.js';
+
+export async function syncDirectoryAncestors(directory: string): Promise<void> {
+  for (let current = directory; ; current = dirname(current)) {
+    const handle = await open(current, 'r');
+    await withCleanup(
+      () => handle.sync(),
+      () => handle.close(),
+    );
+    if (current === dirname(current)) break;
+  }
+}
