+    def owned_state(identity):
+        # A captured lifetime never becomes a different process with the same PID.
+        if identity["gone"]:
+            return None
+        state = process_state(identity["pid"])
+        if state is None or state["starttime"] != identity["starttime"]:
+            identity["gone"] = True
+            return None
+        return state
+
+    def register_child(record, *, kernel=False):
+        pid = record["pid"]
+        if pid in children:
+            if not kernel and record["starttime"] != children[pid]["starttime"]:
+                raise ValueError("fixture event reused a registered child PID")
+            return
+        state = process_state(pid)
+        if state is not None:
