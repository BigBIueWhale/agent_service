+          },
+          {
+            ...route,
+            id: 'invalid-window',
+            generationConfig: {
+              ...route.generationConfig,
+              contextWindowSize: 0,
+            },
+          },
+          { ...route, id: 'invalid-url', baseUrl: 'not-a-url' },
