diff --git a/packages/sdk-typescript/src/daemon/ui/usage.ts b/packages/sdk-typescript/src/daemon/ui/usage.ts
--- /dev/null
+++ b/packages/sdk-typescript/src/daemon/ui/usage.ts
@@ -0,0 +1,33 @@
+import { isTokenCount } from '@qwen-code/qwen-code-core/servedUsage';
+import type { DaemonTurnUsage } from './types.js';
+
+/** Add displayed observations without inventing request-completeness facts. */
+export function combineDaemonTurnUsage(
+  a: DaemonTurnUsage | undefined,
+  b: DaemonTurnUsage | undefined,
+): DaemonTurnUsage | undefined {
+  if (a === undefined && b === undefined) return undefined;
+  const combined: DaemonTurnUsage = {
+    inputTokens: 0,
+    outputTokens: 0,
+    cachedTokens: 0,
+  };
+  for (const usage of [a, b]) {
+    if (usage === undefined) continue;
+    for (const key of [
+      'inputTokens',
+      'outputTokens',
+      'cachedTokens',
+    ] as const) {
+      const sum = combined[key] + usage[key];
+      if (!isTokenCount(usage[key]) || !isTokenCount(sum)) {
+        throw new Error(`Invalid displayed usage count: ${key}`);
+      }
+      combined[key] = sum;
+    }
+    if (usage.cachedTokens > usage.inputTokens) {
+      throw new Error('Displayed cache usage exceeds input usage.');
+    }
+  }
+  return combined;
+}
