diff --git a/packages/core/src/tools/tool-modification.ts b/packages/core/src/tools/tool-modification.ts
--- /dev/null
+++ b/packages/core/src/tools/tool-modification.ts
@@ -0,0 +1,38 @@
+/**
+ * @license
+ * Copyright 2026 Qwen
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+export interface ToolModification {
+  readonly originalProposedContent: string;
+  readonly approvedContent: string;
+}
+
+const modifications = new WeakMap<object, ToolModification>();
+
+export function withToolModification<T extends object>(
+  params: T,
+  originalProposedContent: string,
+  approvedContent: string,
+): T {
+  modifications.set(
+    params,
+    Object.freeze({ originalProposedContent, approvedContent }),
+  );
+  return params;
+}
+
+export function getToolModification(
+  params: object,
+): ToolModification | undefined {
+  return modifications.get(params);
+}
+
+/** Clone untrusted arguments while retaining runtime-authenticated provenance. */
+export function cloneToolParams<T extends object>(params: T): T {
+  const clone = structuredClone(params);
+  const modification = modifications.get(params);
+  if (modification) modifications.set(clone, modification);
+  return clone;
+}
