+/**
+ * @license
+ * Copyright 2025 Qwen
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import fs from 'node:fs';
+
+export const QWEN38_LOCKED_RUNTIME_ENV = 'QWEN38_AGENT_SERVICE_LOCKED';
+export const QWEN38_LOCKED_SYSTEM_PROMPT_PATH = '/opt/agent/system.md';
+export const QWEN38_LOCKED_DEPLOYMENT_CONTRACT_PATH =
+  '/opt/agent/deployment-contract.md';
+
+function readRequiredRegularFile(filePath: string, label: string): string {
+  const stat = fs.lstatSync(filePath);
+  if (!stat.isFile() || stat.isSymbolicLink()) {
+    throw new Error(
+      `${label} must be a regular, non-symlink file: ${filePath}`,
+    );
+  }
+  const text = fs.readFileSync(filePath, 'utf8');
+  if (!text.trim() || !text.endsWith('\n') || text.includes('\r')) {
+    throw new Error(
+      `${label} must be nonempty UTF-8-style LF text with a terminal newline: ${filePath}`,
+    );
+  }
+  return text.trim();
+}
+
+export function isQwen38LockedAgentServiceRuntime(): boolean {
+  return process.env[QWEN38_LOCKED_RUNTIME_ENV] === '1';
+}
+
+/**
+ * Return the immutable deployment contract for the one locked agent-service
+ * runtime. Outside that runtime there is no implicit local deployment prompt.
+ */
+export function getQwen38DeploymentContract(): string {
+  if (!isQwen38LockedAgentServiceRuntime()) return '';
+
+  const systemPath = process.env['QWEN_SYSTEM_MD'];
+  const contractPath = process.env['QWEN_DEPLOYMENT_CONTRACT_MD'];
+  if (systemPath !== QWEN38_LOCKED_SYSTEM_PROMPT_PATH) {
+    throw new Error(
+      `locked agent-service requires QWEN_SYSTEM_MD=${QWEN38_LOCKED_SYSTEM_PROMPT_PATH}`,
+    );
+  }
+  if (contractPath !== QWEN38_LOCKED_DEPLOYMENT_CONTRACT_PATH) {
+    throw new Error(
+      `locked agent-service requires QWEN_DEPLOYMENT_CONTRACT_MD=${QWEN38_LOCKED_DEPLOYMENT_CONTRACT_PATH}`,
+    );
+  }
+
+  return readRequiredRegularFile(contractPath, 'deployment contract');
+}
+
+// Computed once at process start so the system prompt is byte-stable for
+// the whole session (prefix-cache friendly) while anchoring the model to
+// absolute time; live time stays observable through the `date` command.
+const QWEN38_SESSION_STARTED_AT_UTC = new Date().toISOString();
+
+/**
+ * The deployment's engineering discipline. This is the same sealed text for the
+ * main session and for every foreground subagent: honest verification, scope,
+ * and tool-result integrity are properties of this runtime, not of one role.
+ * Only genuinely role-specific framing is layered on top of it.
+ */
+export function getQwen38EngineeringDiscipline(): string {
+  if (!isQwen38LockedAgentServiceRuntime()) return '';
+
+  const systemPath = process.env['QWEN_SYSTEM_MD'];
+  if (systemPath !== QWEN38_LOCKED_SYSTEM_PROMPT_PATH) {
+    throw new Error(
+      `locked agent-service requires QWEN_SYSTEM_MD=${QWEN38_LOCKED_SYSTEM_PROMPT_PATH}`,
+    );
+  }
+
+  return readRequiredRegularFile(systemPath, 'engineering discipline');
+}
+
+/**
+ * Give a subagent the identical engineering discipline the main session runs
+ * under. Without this a subagent would inherit only the environment facts and
+ * none of the deployment's integrity rules, while still holding write and shell
+ * authority whose output the parent integrates.
+ */
+export function appendQwen38EngineeringDiscipline(base: string): string {
+  const discipline = getQwen38EngineeringDiscipline();
+  if (!discipline) return base;
+  return `${base.trim()}\n\n---\n\n${discipline}`;
+}
+
+/**
+ * The only framing that is genuinely specific to the owning session, layered on
+ * top of the shared discipline.
+ */
+export function appendQwen38MainSessionFrame(base: string): string {
+  if (!isQwen38LockedAgentServiceRuntime()) return base;
+  return `${base.trim()}\n\n## This session\n\n- You are the main agent in one long-lived, non-interactive session, and you own the final response.\n- Context length is the most important thing in AI, and it is immoral to waste it. Reading is what wastes it: material you open once to learn one fact stays in this thread for the rest of the session and drags you toward compaction.\n- That is what subagents are for. A subagent's reading never enters your context; only its report comes back, so one that spends sixty turns costs you one. It is what lets a single long thread keep running without compacting the conversation, and that is the whole point -- you stay on trajectory for longer.\n- Delegate generously, then, to a foreground \`general-purpose\` or \`Explore\` subagent: broad searches, surveying unfamiliar code, reproducing a failure, converting documents -- any bounded work whose useful output is short but takes a lot of reading. Your own KV cache is held in DDR5 while it runs, so nothing you have already said is re-ingested when it returns; delegating is close to free.\n- Subagents run one at a time, in the foreground. Give it a self-contained assignment; it cannot see this conversation. Treat its report as evidence to verify, not a conclusion.\n- Keep the design decisions, the edits, and the final verification yourself.\n- Lead the final response with the outcome, then the material files, verification, and unresolved risks.`;
+}
+
+export function appendQwen38DeploymentContract(base: string): string {
+  const contract = getQwen38DeploymentContract();
+  if (!contract) return base;
+  return `${base.trim()}\n\n---\n\n${contract}\n\nSession started: ${QWEN38_SESSION_STARTED_AT_UTC}`;
+}
+
+export function appendQwen38SubagentInvocation(
+  base: string,
+  execution:
+    | {
+        readonly scratchDir: string;
+        readonly subagentType: 'general-purpose' | 'Explore';
+      }
+    | undefined,
+): string {
+  if (!isQwen38LockedAgentServiceRuntime()) return base;
+  if (!execution) {
+    throw new Error(
+      'locked agent-service subagent prompt was built outside its invocation frame',
+    );
+  }
+  return `${base.trim()}\n\n## This foreground invocation\n\n- Role: ${execution.subagentType}\n- Private scratch root: ${execution.scratchDir}\n- TMPDIR, language caches, and build caches are routed beneath that exact scratch root.\n- Scratch is not a deliverable and is not automatically bundled. Deliberately promote anything that must survive to /workspace or /artifacts.\n- The scratch tree remains available to the parent until session teardown; cleanup errors are teardown diagnostics, never silent success.`;
+}
