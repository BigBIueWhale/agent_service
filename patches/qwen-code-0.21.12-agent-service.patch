+/**
+ * @license
+ * Copyright 2025 Qwen
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import { createHash, randomUUID } from 'node:crypto';
+import { constants, createReadStream } from 'node:fs';
+import fs from 'node:fs/promises';
+import path from 'node:path';
+
+export const QWEN38_EFFECT_JOURNAL_ROOT = '/qwen-runtime/effects';
+const SUMMARY_PATH_LIMIT = 256;
+
+type EntryKind = 'directory' | 'file' | 'symlink' | 'special';
+
+interface ManifestEntry {
+  readonly kind: EntryKind;
+  readonly mode: number;
+  readonly size?: number;
+  readonly sha256?: string;
+  readonly target?: string;
+  readonly rdev?: number;
+}
+
+interface RootSnapshot {
+  readonly label: 'workspace' | 'artifacts';
+  readonly root: string;
+  readonly entries: Map<string, ManifestEntry>;
+}
+
+export interface Qwen38EffectPaths {
+  readonly created: string[];
+  readonly removed: string[];
+  readonly contentModified: string[];
+  readonly metadataModified: string[];
+}
+
+export interface Qwen38EffectJournalReport {
+  readonly schemaVersion: 1;
+  readonly journalId: string;
+  readonly manifestPath: string;
+  readonly manifestSha256: string;
+  readonly workspace: Qwen38EffectPaths;
+  readonly artifacts: Qwen38EffectPaths;
+  readonly modelSummary: string;
+}
+
+export interface Qwen38EffectJournal {
+  readonly journalId: string;
+  readonly workspaceRoot: string;
+  readonly artifactsRoot: string;
+  readonly journalRoot: string;
+  readonly beforeWorkspace: RootSnapshot;
+  readonly beforeArtifacts: RootSnapshot;
+}
+
+export class Qwen38EffectJournalError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = 'Qwen38EffectJournalError';
+  }
+}
+
+function normalizeMode(mode: number): number {
+  return mode & 0o7777;
+}
+
+async function hashRegularFile(filePath: string): Promise<ManifestEntry> {
+  const handle = await fs.open(
+    filePath,
+    constants.O_RDONLY | constants.O_NOFOLLOW,
+  );
+  try {
+    const before = await handle.stat();
+    if (!before.isFile()) {
+      throw new Error('path stopped being a regular file during snapshot');
+    }
+    const hash = createHash('sha256');
+    const stream = createReadStream(filePath, {
+      fd: handle.fd,
+      autoClose: false,
+    });
+    for await (const chunk of stream) hash.update(chunk as Buffer);
+    const after = await handle.stat();
+    if (
+      before.dev !== after.dev ||
+      before.ino !== after.ino ||
+      before.size !== after.size ||
+      before.mtimeMs !== after.mtimeMs
+    ) {
+      throw new Error('regular file changed while it was being hashed');
+    }
+    return {
+      kind: 'file',
+      mode: normalizeMode(after.mode),
+      size: after.size,
+      sha256: hash.digest('hex'),
+    };
+  } finally {
+    await handle.close();
+  }
+}
+
+async function snapshotRoot(
+  label: 'workspace' | 'artifacts',
+  root: string,
+): Promise<RootSnapshot> {
+  if (!path.isAbsolute(root)) {
+    throw new Qwen38EffectJournalError(
+      `${label} root is not absolute: ${root}`,
+    );
+  }
+  const rootStat = await fs.lstat(root);
+  if (!rootStat.isDirectory() || rootStat.isSymbolicLink()) {
+    throw new Qwen38EffectJournalError(
+      `${label} root is not a real directory: ${root}`,
+    );
+  }
+  if ((await fs.realpath(root)) !== path.resolve(root)) {
+    throw new Qwen38EffectJournalError(
+      `${label} root resolves outside its declared path: ${root}`,
+    );
+  }
+
+  const entries = new Map<string, ManifestEntry>();
+  const failures: string[] = [];
+  const walk = async (directory: string, relativeDirectory: string) => {
+    let names: string[];
+    try {
+      names = await fs.readdir(directory);
+      names.sort((a, b) => Buffer.from(a).compare(Buffer.from(b)));
+    } catch (error) {
+      failures.push(
+        `${relativeDirectory || '.'}: readdir: ${error instanceof Error ? error.message : String(error)}`,
+      );
+      return;
+    }
+
+    for (const name of names) {
+      const relative = relativeDirectory
+        ? path.posix.join(relativeDirectory, name)
+        : name;
+      const absolute = path.join(directory, name);
+      try {
+        const stat = await fs.lstat(absolute);
+        if (stat.isSymbolicLink()) {
+          entries.set(relative, {
+            kind: 'symlink',
+            mode: normalizeMode(stat.mode),
+            target: await fs.readlink(absolute),
+          });
+        } else if (stat.isDirectory()) {
+          entries.set(relative, {
+            kind: 'directory',
+            mode: normalizeMode(stat.mode),
+          });
+          await walk(absolute, relative);
+        } else if (stat.isFile()) {
+          entries.set(relative, await hashRegularFile(absolute));
+        } else {
+          entries.set(relative, {
+            kind: 'special',
+            mode: normalizeMode(stat.mode),
+            size: stat.size,
+            rdev: stat.rdev,
+          });
+        }
+      } catch (error) {
+        failures.push(
+          `${relative}: inspect: ${error instanceof Error ? error.message : String(error)}`,
+        );
+      }
+    }
+  };
+
+  await walk(root, '');
+  if (failures.length > 0) {
+    const preview = failures.slice(0, 20).join('; ');
+    throw new Qwen38EffectJournalError(
+      `${label} effect snapshot is incomplete (${failures.length} failures): ${preview}`,
+    );
+  }
+  return { label, root, entries };
+}
+
+function sameContent(before: ManifestEntry, after: ManifestEntry): boolean {
+  if (before.kind !== after.kind) return false;
+  switch (before.kind) {
+    case 'file':
+      return before.sha256 === after.sha256 && before.size === after.size;
+    case 'symlink':
+      return before.target === after.target;
+    case 'special':
+      return before.rdev === after.rdev && before.size === after.size;
+    case 'directory':
+      return true;
+    default: {
+      const exhaustive: never = before.kind;
+      return exhaustive;
+    }
+  }
+}
+
+function compareSnapshots(
+  before: RootSnapshot,
+  after: RootSnapshot,
+): Qwen38EffectPaths {
+  const created: string[] = [];
+  const removed: string[] = [];
+  const contentModified: string[] = [];
+  const metadataModified: string[] = [];
+  const names = new Set([...before.entries.keys(), ...after.entries.keys()]);
+  for (const name of [...names].sort((a, b) =>
+    Buffer.from(a).compare(Buffer.from(b)),
+  )) {
+    const oldEntry = before.entries.get(name);
+    const newEntry = after.entries.get(name);
+    if (!oldEntry) {
+      created.push(name);
+    } else if (!newEntry) {
+      removed.push(name);
+    } else if (!sameContent(oldEntry, newEntry)) {
+      contentModified.push(name);
+    } else if (oldEntry.mode !== newEntry.mode) {
+      metadataModified.push(name);
+    }
+  }
+  return { created, removed, contentModified, metadataModified };
+}
+
+async function requirePrivateJournalRoot(journalRoot: string): Promise<void> {
+  if (!path.isAbsolute(journalRoot)) {
+    throw new Qwen38EffectJournalError(
+      `effect journal root is not absolute: ${journalRoot}`,
+    );
+  }
+  await fs.mkdir(journalRoot, { recursive: true, mode: 0o700 });
+  const stat = await fs.lstat(journalRoot);
+  if (
+    !stat.isDirectory() ||
+    stat.isSymbolicLink() ||
+    (stat.mode & 0o777) !== 0o700 ||
+    (await fs.realpath(journalRoot)) !== path.resolve(journalRoot)
+  ) {
+    throw new Qwen38EffectJournalError(
+      `effect journal root must be a real mode-0700 directory: ${journalRoot}`,
+    );
+  }
+}
+
+export async function beginQwen38EffectJournal(options?: {
+  workspaceRoot?: string;
+  artifactsRoot?: string;
+  journalRoot?: string;
+}): Promise<Qwen38EffectJournal> {
+  const workspaceRoot = options?.workspaceRoot ?? '/workspace';
+  const artifactsRoot = options?.artifactsRoot ?? '/artifacts';
+  const journalRoot = options?.journalRoot ?? QWEN38_EFFECT_JOURNAL_ROOT;
+  await requirePrivateJournalRoot(journalRoot);
+  const [beforeWorkspace, beforeArtifacts] = await Promise.all([
+    snapshotRoot('workspace', workspaceRoot),
+    snapshotRoot('artifacts', artifactsRoot),
+  ]);
+  return {
+    journalId: randomUUID(),
+    workspaceRoot,
+    artifactsRoot,
+    journalRoot,
+    beforeWorkspace,
+    beforeArtifacts,
+  };
+}
+
+function collectSummaryLines(
+  label: 'workspace' | 'artifacts',
+  effects: Qwen38EffectPaths,
+  remaining: { value: number },
+): string[] {
+  const lines: string[] = [];
+  for (const [kind, paths] of Object.entries(effects) as Array<
+    [keyof Qwen38EffectPaths, string[]]
+  >) {
+    lines.push(`${label}.${kind}.count=${paths.length}`);
+    for (const item of paths) {
+      if (remaining.value === 0) continue;
+      lines.push(`${label}.${kind}.path=${JSON.stringify(item)}`);
+      remaining.value -= 1;
+    }
+  }
+  return lines;
+}
+
+async function writeJournalManifest(
+  journal: Qwen38EffectJournal,
+  payload: object,
+): Promise<{ manifestPath: string; manifestSha256: string }> {
+  const manifestPath = path.join(
+    journal.journalRoot,
+    `${journal.journalId}.json`,
+  );
+  const temporaryPath = `${manifestPath}.${randomUUID()}.tmp`;
+  const bytes = Buffer.from(`${JSON.stringify(payload, null, 2)}\n`, 'utf8');
+  const handle = await fs.open(temporaryPath, 'wx', 0o600);
+  try {
+    await handle.writeFile(bytes);
+    await handle.sync();
+  } finally {
+    await handle.close();
+  }
+  try {
+    await fs.rename(temporaryPath, manifestPath);
+    const directory = await fs.open(journal.journalRoot, 'r');
+    try {
+      await directory.sync();
+    } finally {
+      await directory.close();
+    }
+  } catch (error) {
+    await fs.rm(temporaryPath, { force: true });
+    throw error;
+  }
+  return {
+    manifestPath,
+    manifestSha256: createHash('sha256').update(bytes).digest('hex'),
+  };
+}
+
+export async function finishQwen38EffectJournal(
+  journal: Qwen38EffectJournal,
+): Promise<Qwen38EffectJournalReport> {
+  const [afterWorkspace, afterArtifacts] = await Promise.all([
+    snapshotRoot('workspace', journal.workspaceRoot),
+    snapshotRoot('artifacts', journal.artifactsRoot),
+  ]);
+  const workspace = compareSnapshots(journal.beforeWorkspace, afterWorkspace);
+  const artifacts = compareSnapshots(journal.beforeArtifacts, afterArtifacts);
+  const payload = {
+    schema_version: 1,
+    journal_id: journal.journalId,
+    roots: {
+      workspace: journal.workspaceRoot,
+      artifacts: journal.artifactsRoot,
+    },
+    effects: { workspace, artifacts },
+  };
+  const { manifestPath, manifestSha256 } = await writeJournalManifest(
+    journal,
+    payload,
+  );
+
+  const totalPaths = [workspace, artifacts].reduce(
+    (total, effects) =>
+      total +
+      effects.created.length +
+      effects.removed.length +
+      effects.contentModified.length +
+      effects.metadataModified.length,
+    0,
+  );
+  const remaining = { value: SUMMARY_PATH_LIMIT };
+  const lines = [
+    'QWEN38_TRUSTED_EXPLORE_EFFECT_JOURNAL_V1',
+    `manifest=${manifestPath}`,
+    `manifest_sha256=${manifestSha256}`,
+    `effect_path_count=${totalPaths}`,
+    ...collectSummaryLines('workspace', workspace, remaining),
+    ...collectSummaryLines('artifacts', artifacts, remaining),
+  ];
+  if (totalPaths > SUMMARY_PATH_LIMIT) {
+    lines.push(
+      `path_list_truncated=true`,
+      `path_list_limit=${SUMMARY_PATH_LIMIT}`,
+      'Read the exact hashed manifest before relying on omitted path details.',
+    );
+  } else {
+    lines.push('path_list_truncated=false');
+  }
+
+  return {
+    schemaVersion: 1,
+    journalId: journal.journalId,
+    manifestPath,
+    manifestSha256,
+    workspace,
+    artifacts,
+    modelSummary: lines.join('\n'),
+  };
+}
