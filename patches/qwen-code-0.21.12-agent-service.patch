+            generationConfig: {
+              contextWindowSize: 262144,
+              strictToolCalling: true,
+            },
+          },
+          {
+            ...route,
+            id: 'missing-strict',
+            generationConfig: {
+              contextWindowSize: 262144,
+              exactTokenCounting: 'vllm',
