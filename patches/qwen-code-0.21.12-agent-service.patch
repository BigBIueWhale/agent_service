+    const observations = new GenerationObservations();
+    const a = dispatch('a');
+    const b = dispatch('b');
+    const af = finalize(a);
+    const bf = finalize(b);
+    for (const event of [a, b, bf, af]) observations.add(event);
+    expect(observations.values()).toEqual([
+      { dispatch: a, finalization: af },
+      { dispatch: b, finalization: bf },
+    ]);
+  });
+  it('keeps finalized absent usage and a reported zero distinct', () => {
+    const observations = new GenerationObservations();
+    const a = dispatch();
+    const b = dispatch();
+    observations.add(a);
+    observations.add(b);
+    observations.add({
+      ...new ApiUsageEvent(a as unknown as ApiDispatchEvent, 100, undefined),
+      'event.name': EVENT_API_USAGE,
+    });
+    const zero = {
+      promptTokenCount: 0,
+      candidatesTokenCount: 0,
+      thoughtsTokenCount: 0,
+      cachedContentTokenCount: 0,
+      totalTokenCount: 0,
+    };
+    observations.add(finalize(b, zero));
+    expect(observations.values()[0].finalization?.served_usage).toBeNull();
+    expect(observations.values()[1].finalization?.served_usage).toEqual(zero);
+  });
+  it.each([
+    'orphan',
+    'duplicate-dispatch',
+    'duplicate-finalization',
+    'model',
+    'session_id',
+    'kv_scope',
+    'prompt_id',
+    'auth_type',
+    'subagent_name',
+    'negative-duration',
+    'nonfinite-duration',
+    'negative-ttft',
+    'missing-usage',
+    'partial-usage',
+    'inconsistent-usage',
+    'empty-id',
+    'blank-owner',
+    'invalid-timestamp',
+  ])('refuses corrupt generation evidence: %s', (kind) => {
+    const start: Record<string, unknown> = { ...dispatch() };
+    const end: Record<string, unknown> = {
+      ...finalize(start as ReturnType<typeof dispatch>),
+    };
+    let events: Array<Record<string, unknown>> = [start, end];
+    if (kind === 'orphan') events = [end];
+    else if (kind === 'duplicate-dispatch') events = [start, start];
+    else if (kind === 'duplicate-finalization') events = [start, end, end];
+    else if (
+      [
+        'model',
+        'session_id',
+        'kv_scope',
+        'prompt_id',
+        'auth_type',
+        'subagent_name',
+      ].includes(kind)
+    )
+      end[kind] = 'changed';
+    else if (kind === 'negative-duration') end['duration_ms'] = -1;
+    else if (kind === 'nonfinite-duration') end['duration_ms'] = Number.NaN;
+    else if (kind === 'negative-ttft') end['ttft_ms'] = -1;
+    else if (kind === 'missing-usage') delete end['served_usage'];
+    else if (kind === 'partial-usage')
+      end['served_usage'] = { promptTokenCount: 10 };
+    else if (kind === 'inconsistent-usage')
+      end['served_usage'] = { ...servedUsage(), totalTokenCount: 99 };
+    else if (kind === 'empty-id') start['request_id'] = '';
