@@ -0,0 +1,61 @@
+/**
+ * @license
+ * Copyright 2025 Qwen
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import fs from 'node:fs';
+import path from 'node:path';
+import { afterEach, describe, expect, it } from 'vitest';
+import {
+  createQwen38ScratchTestRoot,
+  createQwen38SubagentScratch,
+} from './qwen38-subagent-scratch.js';
+
+const cleanup: string[] = [];
+
+afterEach(() => {
+  for (const item of cleanup.splice(0)) {
+    fs.rmSync(item, { recursive: true, force: true });
+  }
+});
+
+describe('Qwen3.8 foreground-subagent scratch', () => {
+  it('creates a unique private tree for each invocation', () => {
+    const root = createQwen38ScratchTestRoot();
+    cleanup.push(root);
+    const first = createQwen38SubagentScratch('Explore', root);
+    const second = createQwen38SubagentScratch('Explore', root);
+
+    expect(first.root).not.toBe(second.root);
+    expect(path.dirname(first.root)).toBe(root);
+    for (const directory of Object.values(first)) {
+      const stat = fs.lstatSync(directory);
+      expect(stat.isDirectory()).toBe(true);
+      expect(stat.isSymbolicLink()).toBe(false);
+      expect(stat.mode & 0o777).toBe(0o700);
+    }
+  });
+
+  it('refuses a symlinked scratch root', () => {
+    const parent = createQwen38ScratchTestRoot();
+    cleanup.push(parent);
+    const real = path.join(parent, 'real');
+    const link = path.join(parent, 'link');
+    fs.mkdirSync(real, { mode: 0o700 });
+    fs.symlinkSync(real, link);
+
+    expect(() => createQwen38SubagentScratch('Explore', link)).toThrow(
+      'not a real directory',
+    );
+  });
+
+  it('refuses a root whose permissions are not private', () => {
+    const root = createQwen38ScratchTestRoot();
+    cleanup.push(root);
+    fs.chmodSync(root, 0o755);
+    expect(() => createQwen38SubagentScratch('general-purpose', root)).toThrow(
+      'mode 0700',
+    );
+  });
+});
diff --git a/packages/core/src/tools/agent/qwen38-subagent-scratch.ts b/packages/core/src/tools/agent/qwen38-subagent-scratch.ts
new file mode 100644
index 0000000..7c9c492
--- /dev/null
+++ b/packages/core/src/tools/agent/qwen38-subagent-scratch.ts
@@ -0,0 +1,81 @@
+/**
+ * @license
+ * Copyright 2025 Qwen
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+
+export const QWEN38_SUBAGENT_SCRATCH_ROOT = '/tmp/qwen-subagents';
+
+export interface Qwen38SubagentScratch {
+  readonly root: string;
+  readonly cache: string;
+  readonly pip: string;
+  readonly npm: string;
+  readonly cargo: string;
+  readonly go: string;
+}
+
+function requirePrivateRealDirectory(directory: string, label: string): void {
+  const stat = fs.lstatSync(directory);
+  if (!stat.isDirectory() || stat.isSymbolicLink()) {
+    throw new Error(`${label} is not a real directory: ${directory}`);
+  }
+  if ((stat.mode & 0o777) !== 0o700) {
+    throw new Error(`${label} must have mode 0700: ${directory}`);
+  }
+  if (fs.realpathSync(directory) !== path.resolve(directory)) {
+    throw new Error(
+      `${label} resolves outside its declared path: ${directory}`,
+    );
+  }
+}
+
+function createPrivateDirectory(directory: string): void {
+  fs.mkdirSync(directory, { mode: 0o700 });
+  requirePrivateRealDirectory(directory, 'subagent scratch directory');
+}
+
+export function createQwen38SubagentScratch(
+  subagentType: 'general-purpose' | 'Explore',
+  scratchRoot = QWEN38_SUBAGENT_SCRATCH_ROOT,
+): Qwen38SubagentScratch {
+  if (!path.isAbsolute(scratchRoot)) {
+    throw new Error(`subagent scratch root must be absolute: ${scratchRoot}`);
+  }
+  fs.mkdirSync(scratchRoot, { recursive: true, mode: 0o700 });
+  requirePrivateRealDirectory(scratchRoot, 'subagent scratch root');
+
+  const root = fs.mkdtempSync(path.join(scratchRoot, `${subagentType}-`));
+  fs.chmodSync(root, 0o700);
+  requirePrivateRealDirectory(root, 'subagent invocation scratch');
+
+  const scratch: Qwen38SubagentScratch = {
+    root,
+    cache: path.join(root, 'cache'),
+    pip: path.join(root, 'pip'),
+    npm: path.join(root, 'npm'),
+    cargo: path.join(root, 'cargo'),
+    go: path.join(root, 'go'),
+  };
+  for (const directory of [
+    scratch.cache,
+    scratch.pip,
+    scratch.npm,
+    scratch.cargo,
+    scratch.go,
+  ]) {
+    createPrivateDirectory(directory);
+  }
+  return scratch;
+}
+
+/** Test helper: create a mode-correct private root under the host temp dir. */
+export function createQwen38ScratchTestRoot(): string {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'qwen38-scratch-test-'));
+  fs.chmodSync(root, 0o700);
+  return root;
+}
