+    this.request_id = dispatch.request_id;
+    this.model = dispatch.model;
+    this.prompt_id = dispatch.prompt_id;
+    this.session_id = dispatch.session_id;
+    this.kv_scope = dispatch.kv_scope;
+    this.auth_type = dispatch.auth_type;
+    this.subagent_name = dispatch.subagent_name;
+    this.served_usage =
+      usage === undefined
+        ? null
