+
+type MaintenanceAction = 'archive' | 'unarchive' | 'delete';
+type MaintenanceResult = Awaited<
+  ReturnType<
+    | typeof archiveDaemonSessions
+    | typeof unarchiveDaemonSessions
+    | typeof deleteDaemonSessions
+  >
+>;
+
+function failureCauses(error: unknown): unknown[] {
+  return error instanceof AggregateError
+    ? error.errors.flatMap(failureCauses)
+    : [error];
+}
+
+function expectMaintenanceFailure(
+  result: MaintenanceResult,
+  sessionId: string,
+  causes: unknown[],
+): void {
+  for (const [key, value] of Object.entries(result)) {
+    if (key !== 'errors') expect(value).toEqual([]);
+  }
+  expect(result.errors).toHaveLength(1);
+  expect(result.errors[0]?.sessionId).toBe(sessionId);
+  const actual = result.errors[0]?.error;
+  if (causes.length === 1) expect(actual).toBe(causes[0]);
+  else expect(actual).toBeInstanceOf(AggregateError);
+  const observed = failureCauses(actual);
+  expect(observed).toHaveLength(causes.length);
+  for (const [index, cause] of causes.entries()) {
+    expect(observed[index]).toBe(cause);
+  }
