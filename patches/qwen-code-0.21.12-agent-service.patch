+/**
+ * @license
+ * Copyright 2026 Qwen Team
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import type { ChatRecord } from './chatRecordingService.js';
+import { requireServedUsage, type ServedUsage } from '../core/served-usage.js';
+
+export class ResumeServedUsageAccumulator {
+  private value: ServedUsage | undefined;
+  add(record: ChatRecord): void {
+    if (record.type === 'assistant' && record.usageMetadata !== undefined) {
+      this.value = requireServedUsage(
+        record.usageMetadata,
+        'Resumed assistant',
+      );
+    }
+  }
+  finish(): ServedUsage | undefined {
+    return this.value;
+  }
+}
+
+export function isResumeServedUsageCandidate(record: ChatRecord): boolean {
+  return record.type === 'assistant' && record.usageMetadata !== undefined;
+}
+
+export function getResumeServedUsage(conversation: {
+  messages: readonly ChatRecord[];
+}): ServedUsage | undefined {
+  const accumulator = new ResumeServedUsageAccumulator();
+  for (const record of conversation.messages) accumulator.add(record);
+  return accumulator.finish();
+}
