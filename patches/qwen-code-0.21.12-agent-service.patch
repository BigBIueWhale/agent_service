--- /dev/null
+++ b/packages/core/src/core/authored-instructions.ts
@@ -0,0 +1,144 @@
+import { randomUUID } from 'node:crypto';
+import type { Content, Part, PartListUnion, PartUnion } from '@google/genai';
+import { createUserContent } from './genai-compat.js';
+
+/** An instruction's author and original parts survive changes to its model-facing presentation. */
+interface AuthoredInstruction {
+  id: string;
+  author: 'user' | 'delegator';
+  parts: Part[];
+}
+
+type InstructionPart = Part & { authoredInstructions?: AuthoredInstruction[] };
+
+function instructionsOn(part: Part): readonly AuthoredInstruction[] {
+  const instructions = (part as InstructionPart).authoredInstructions;
+  if (instructions === undefined) return [];
+  if (!Array.isArray(instructions))
+    throw new Error('Invalid authored instruction ownership');
+  for (const instruction of instructions) {
+    if (
+      !instruction ||
+      typeof instruction.id !== 'string' ||
+      !instruction.id.trim() ||
+      (instruction.author !== 'user' && instruction.author !== 'delegator') ||
+      !Array.isArray(instruction.parts) ||
+      instruction.parts.length === 0 ||
+      instruction.parts.some(
+        (source) =>
+          !source ||
+          typeof source !== 'object' ||
+          'authoredInstructions' in source,
+      )
+    ) {
+      throw new Error('Invalid authored instruction source');
+    }
+    createUserContent(instruction.parts);
+  }
+  return instructions;
+}
+
+function uniqueInstructions(
+  instructions: readonly AuthoredInstruction[],
+): AuthoredInstruction[] {
+  const unique = new Map<string, AuthoredInstruction>();
+  for (const instruction of instructions) {
+    const prior = unique.get(instruction.id);
+    if (prior && JSON.stringify(prior) !== JSON.stringify(instruction))
+      throw new Error(`Conflicting authored instruction ${instruction.id}`);
+    if (!prior) unique.set(instruction.id, instruction);
+  }
+  return [...unique.values()];
+}
+
+function attachInstructions(
+  parts: PartListUnion,
+  instructions: readonly AuthoredInstruction[],
+): Part[] {
+  const result = createUserContent(parts).parts!;
+  if (instructions.length === 0) return result;
+  const [first, ...rest] = result;
+  return [
+    {
+      ...first,
+      authoredInstructions: uniqueInstructions([
+        ...instructionsOn(first),
+        ...instructions,
+      ]),
+    } as InstructionPart,
+    ...rest,
+  ];
+}
+
+/** Capture at semantic input entry, before hooks, expansion, or runtime reminders alter its presentation. */
+function retainInstruction(
+  author: AuthoredInstruction['author'],
+  modelParts: PartListUnion,
+  originalParts: PartListUnion,
+): Part[] {
+  const parts = structuredClone(createUserContent(originalParts).parts!);
+  if (parts.some((part) => instructionsOn(part).length > 0))
+    throw new Error('An authored input cannot capture another authored input');
+  return attachInstructions(modelParts, [{ id: randomUUID(), author, parts }]);
+}
+
+export function retainUserInput(
+  modelParts: PartListUnion,
+  originalParts: PartListUnion,
+): Part[] {
+  return retainInstruction('user', modelParts, originalParts);
+}
+
+export function retainDelegatedTask(
+  parts: PartListUnion,
+  originalParts: PartListUnion = parts,
+): Part[] {
+  return retainInstruction('delegator', parts, originalParts);
+}
+
+/** A text expansion changes presentation, never ownership of the text it expanded. */
+export function carryAuthoredInstructions(
+  source: PartUnion,
+  result: PartUnion[],
+): PartUnion[] {
+  if (typeof source === 'string') return result;
+  const instructions = instructionsOn(source);
+  if (instructions.length === 0) return result;
+  return attachInstructions(
+    result.length === 0 ? [{ text: '' }] : result,
+    instructions,
+  );
+}
+
+/** Ordered, deduplicated original instructions. Model-authored summaries never supply this provenance. */
+export function retainedInstructionParts(history: readonly Content[]): Part[] {
+  const instructions = collectInstructions(history);
+  const parts: Part[] = [];
+  for (const instruction of instructions) {
+    parts.push({
+      text: `Original ${instruction.author === 'user' ? 'user input' : 'delegated task'} (verbatim; chronological order):`,
+    });
+    parts.push(
+      ...attachInstructions(structuredClone(instruction.parts), [instruction]),
+    );
+  }
+  return parts;
+}
+
+function collectInstructions(
+  history: readonly Content[],
+): AuthoredInstruction[] {
+  return uniqueInstructions(
+    history.flatMap((content) =>
+      (content.parts ?? []).flatMap((part) => [...instructionsOn(part)]),
+    ),
+  );
+}
+
+/** A retry resends an existing authored input, preserving its source identity. */
+export function carryHistoryInstructions(
+  history: readonly Content[],
+  parts: PartListUnion,
+): Part[] {
+  return attachInstructions(parts, collectInstructions(history));
+}
