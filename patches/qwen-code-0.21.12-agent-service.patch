+ */
+
+import { describe, expect, it, vi } from 'vitest';
+import { waitFor } from '@testing-library/react';
+import {
+  AgentStatus,
+  ArenaSessionStatus,
+  type ArenaManager,
+  type GenerationUsageSummary,
+} from '@qwen-code/qwen-code-core';
+import { renderWithProviders } from '../../../test-utils/render.js';
+import { ArenaStatusDialog } from './ArenaStatusDialog.js';
+
+const usageCases = [
+  {
+    label: 'failure without usage',
+    ownerUsage: {
+      requests: 1,
+      usageReports: 0,
+      unreportedUsageRequests: 1,
+      unfinalizedRequests: 0,
+      usage: null,
+    },
+    tokens: 'No served usage reported',
+    observations: [
+      '1 requests',
+      '0 usage reports',
