diff --git a/packages/cli/src/utils/compression-result.ts b/packages/cli/src/utils/compression-result.ts
--- /dev/null
+++ b/packages/cli/src/utils/compression-result.ts
@@ -0,0 +1,118 @@
+/**
+ * @license
+ * Copyright 2026 Qwen Team
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import {
+  CompressionStatus,
+  CompactionFinalizationError,
+  type ChatCompressionInfo,
+} from '@qwen-code/qwen-code-core';
+import type { CompressionActionReturn } from '../ui/commands/types.js';
+import type { HistoryItemCompression } from '../ui/types.js';
+
+export type CompressionOutcome = Pick<
+  ChatCompressionInfo,
+  'originalTokenCount' | 'newTokenCount' | 'compressionStatus' | 'warning'
+> & { finalizationFailure?: string };
+
+export function formatCompressionResult(info: CompressionOutcome): {
+  messageType: 'info' | 'error';
+  content: string;
+} {
+  for (const count of [info.originalTokenCount, info.newTokenCount]) {
+    if (!Number.isSafeInteger(count) || count < 0) {
+      throw new Error(
+        'Completed compaction requires exact non-negative token counts.',
+      );
+    }
+  }
+  for (const detail of [info.warning, info.finalizationFailure]) {
+    if (detail !== undefined && typeof detail !== 'string') {
+      throw new Error('Compaction details must be text.');
+    }
+  }
+  const status = info.compressionStatus;
+  let content: string;
+  let messageType: 'info' | 'error' = 'error';
+  switch (status) {
+    case CompressionStatus.COMPRESSED:
+      messageType = 'info';
+      content = `Compaction checkpoint reduced from ${info.originalTokenCount} to ${info.newTokenCount} tokens.`;
+      break;
+    case CompressionStatus.NOOP:
+      messageType = 'info';
+      content = 'No compression needed.';
+      break;
+    case CompressionStatus.COMPRESSION_FAILED_INFLATED_TOKEN_COUNT:
+      content = 'Compaction candidate did not reduce the token count.';
+      break;
+    case CompressionStatus.COMPRESSION_FAILED_INSUFFICIENT_ROOM:
+      content =
+        'Compaction candidate is smaller but leaves insufficient room for the next model request.';
+      break;
+    case CompressionStatus.COMPRESSION_FAILED_TOKEN_COUNT_ERROR:
+      content = 'Compaction failed because exact token counting failed.';
+      break;
+    case CompressionStatus.COMPRESSION_FAILED_EMPTY_SUMMARY:
+      content =
+        'Compaction failed because the model returned an empty summary.';
+      break;
+    case CompressionStatus.COMPRESSION_FAILED_OUTPUT_TRUNCATED:
+      content = 'Compaction failed because the model output was truncated.';
+      break;
+    case CompressionStatus.COMPRESSION_FAILED_PROTOCOL_ERROR:
+      content = 'Compaction failed because a required protocol step failed.';
+      break;
+    default: {
+      const unhandled: never = status;
+      throw new Error(`Unknown compaction status: ${unhandled}`);
+    }
+  }
+  if (messageType === 'error') {
+    content = `${content} Original history retained (${info.originalTokenCount} tokens).`;
+  }
+  if (info.warning) content += `\n${info.warning}`;
+  if (info.finalizationFailure !== undefined) {
+    messageType = 'error';
+    content += `\n${info.finalizationFailure}`;
+  }
+  return { messageType, content };
+}
+
+export function compressionOutcome(
+  info: ChatCompressionInfo,
+  finalizationFailure?: string,
+): CompressionOutcome {
+  return {
+    originalTokenCount: info.originalTokenCount,
+    newTokenCount: info.newTokenCount,
+    compressionStatus: info.compressionStatus,
+    ...(info.warning ? { warning: info.warning } : {}),
+    ...(finalizationFailure !== undefined ? { finalizationFailure } : {}),
+  };
+}
+
+export function createCompressionHistoryItem(compression: CompressionOutcome) {
+  return {
+    type: 'compression',
+    compression,
+    text: formatCompressionResult(compression).content,
+  } satisfies HistoryItemCompression;
+}
+
+export async function runCompressionCommand(
+  operation: () => Promise<ChatCompressionInfo>,
+): Promise<CompressionActionReturn> {
+  try {
+    return { type: 'compression', info: await operation() };
+  } catch (error) {
+    if (!(error instanceof CompactionFinalizationError)) throw error;
+    return {
+      type: 'compression',
+      info: error.info,
+      finalizationFailure: error.message,
+    };
+  }
+}
