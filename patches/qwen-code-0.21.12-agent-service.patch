+ * Copyright 2026 Qwen Team
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import { describe, expect, it } from 'vitest';
+import { stripTrailingToolCallResidue } from './toolCallResidue.js';
+
+// The four positive fixtures are the complete residue population from five
+// benchmark event logs (3,278 events): every assistant text block that
+// carried call syntax, byte-for-byte. The negative fixtures include the
+// corpus's real legitimate quoting shapes; the detector must strip all of
+// the former and none of the latter.
+describe('stripTrailingToolCallResidue', () => {
+  it('[residue-quarantine] removes a whole-block residue fragment (testA2:385)', () => {
+    const residue =
+      '</invoke>\n\n</parameter>\n<parameter=offset>\n5919\n</parameter>\n</function>\n</tool_call>';
+    const result = stripTrailingToolCallResidue(residue);
+    expect(result.removed).toBe(residue);
+    expect(result.text).toBe('');
+  });
+
+  it('[residue-quarantine] removes a whole-block residue fragment (testA:43)', () => {
+    const residue =
+      '</invoke>\n\n</parameter>\n<parameter=offset>\n1323\n</parameter>\n</function>\n</tool_call>';
+    const result = stripTrailingToolCallResidue(residue);
+    expect(result.removed).toBe(residue);
+    expect(result.text).toBe('');
+  });
+
+  it('[residue-quarantine] keeps the prose and removes only the trailing fragment (testA:298)', () => {
+    const prose =
+      '\n\nThe pattern is now clear: batching two `read_file` calls per turn causes the first one to drop its offset. From here, only one read per turn will be performed.';
+    const residue =
+      '\n\n\n</invoke>\n</function_calls>\n</parameter>\n<parameter=offset>\n3746\n</parameter>\n</function>\n</tool_call>';
+    const result = stripTrailingToolCallResidue(prose + residue);
+    expect(result.removed).not.toBeNull();
+    expect(result.text).toBe(prose.replace(/\s+$/, ''));
+    expect(result.text).toContain('only one read per turn');
+    expect(result.text).not.toContain('</invoke>');
+  });
+
+  it('[residue-quarantine] removes a closers-only fragment with no parameter (testc:602)', () => {
+    const residue = '</invoke>\n</parameter>\n</function>\n</tool_call>';
+    const result = stripTrailingToolCallResidue(residue);
+    expect(result.removed).toBe(residue);
+    expect(result.text).toBe('');
+  });
+
+  it('[residue-quarantine] leaves prose that quotes call syntax inline (false-positive control)', () => {
+    // Real shape from the same corpus: the model's own self-diagnosis names
+    // the syntax it mishandled. Inline mentions never sit alone on closing
+    // lines, so the detector must not touch them.
+    const diagnosis =
+      'I keep omitting the offset parameter in some of my calls. The calls ' +
+      'that succeeded had explicit offset + limit, written as ' +
+      '`<parameter=offset>5919</parameter>` inside the call block. I will ' +
+      'pass offset explicitly from now on.';
+    expect(stripTrailingToolCallResidue(diagnosis)).toEqual({
+      text: diagnosis,
+      removed: null,
+    });
+  });
+
+  it('[residue-quarantine] leaves a fenced code block at the end of a message (false-positive control)', () => {
+    const fenced =
+      'The failing serialization looked like this:\n\n```\n</parameter>\n</function>\n</tool_call>\n```';
+    expect(stripTrailingToolCallResidue(fenced)).toEqual({
+      text: fenced,
+      removed: null,
+    });
+  });
+
+  it('[residue-quarantine] leaves a single quoted closer line (false-positive control)', () => {
+    const single = 'Every call must end with the closing tag:\n</tool_call>';
+    expect(stripTrailingToolCallResidue(single)).toEqual({
+      text: single,
+      removed: null,
+    });
+  });
+
+  it('[residue-quarantine] leaves a deliberate opener-first example (false-positive control)', () => {
+    // An example that starts with a parameter opener is a demonstration,
+    // not resumed serialization: residue re-enters closers first.
+    const example =
+      'Pass the offset like this:\n<parameter=offset>\n5919\n</parameter>';
+    expect(stripTrailingToolCallResidue(example)).toEqual({
+      text: example,
+      removed: null,
+    });
+  });
+
+  it('[residue-quarantine] leaves ordinary prose and empty text unchanged', () => {
+    expect(stripTrailingToolCallResidue('A plain answer.')).toEqual({
+      text: 'A plain answer.',
+      removed: null,
+    });
+    expect(stripTrailingToolCallResidue('')).toEqual({
+      text: '',
+      removed: null,
+    });
+  });
+});
diff --git a/packages/core/src/utils/toolCallResidue.ts b/packages/core/src/utils/toolCallResidue.ts
new file mode 100644
index 0000000..001e228
--- /dev/null
+++ b/packages/core/src/utils/toolCallResidue.ts
@@ -0,0 +1,104 @@
+/**
+ * @license
+ * Copyright 2026 Qwen Team
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+/**
+ * Trailing tool-call serialization residue in the model's visible text.
+ *
+ * The model occasionally discharges part of a pending tool call into the
+ * prose channel immediately before the real `<tool_call>` trigger fires —
+ * characteristically resuming an earlier turn's unfinished serialization,
+ * closers first (`</invoke>`, `</parameter>`, then a stray
+ * `<parameter=name>value</parameter>` pair). The structured call that
+ * follows in the same completion is parsed and executed normally, so the
+ * fragment is pure noise — but history re-renders every assistant text
+ * verbatim into later prompts, where the fragment becomes a serialized
+ * exemplar of exactly the malformed shape it came from. Forensics across
+ * five benchmark runs (3,278 events) found four such fragments; all four
+ * sat at the end of a text block in a turn that carried tool calls, began
+ * with a closing tag, and mixed the Qwen and foreign (Anthropic-style)
+ * conventions. The same corpus contains legitimate call-syntax quoting —
+ * self-diagnosis notes naming `<parameter=...>` — only inline in prose or
+ * in the thinking channel, never in this trailing closers-first shape, so
+ * the detector below matched every fragment and nothing else.
+ *
+ * Detection is deliberately structural, not literal: a maximal trailing
+ * run of whole lines that are closing tags of either convention, bare
+ * `<parameter=...>` openers, single value lines directly after an opener,
+ * or blank — accepted only when the run opens with a closer, ends with a
+ * closer, and holds at least two tag lines. Prose that merely mentions
+ * call syntax, fenced code blocks, and a lone quoted closer all fail one
+ * of those conditions and are left untouched. A false positive would only
+ * shorten the re-rendered copy of one message, never affect execution.
+ */
+
+const CLOSER_LINE =
+  /^\s*<\/(?:tool_call|function|parameter|invoke|function_calls)>\s*$/;
+const PARAMETER_OPENER_LINE = /^\s*<parameter=[^<>\s]*>\s*$/;
+const BLANK_LINE = /^\s*$/;
+
+export interface ToolCallResidueStripResult {
+  /** The text with any trailing residue removed (right-trimmed if stripped). */
+  text: string;
+  /** The removed residue, or null when nothing matched. */
+  removed: string | null;
+}
+
+export function stripTrailingToolCallResidue(
+  text: string,
+): ToolCallResidueStripResult {
+  const lines = text.split('\n');
+  // Walk backwards to find the largest admissible tail: closers, parameter
+  // openers, blanks, and single value lines that directly follow an opener.
+  let start = lines.length;
+  while (start > 0) {
+    const line = lines[start - 1]!;
+    if (
+      CLOSER_LINE.test(line) ||
+      PARAMETER_OPENER_LINE.test(line) ||
+      BLANK_LINE.test(line) ||
+      (start >= 2 && PARAMETER_OPENER_LINE.test(lines[start - 2]!))
+    ) {
+      start--;
+    } else {
+      break;
+    }
+  }
+  if (start >= lines.length) {
+    return { text, removed: null };
+  }
+
+  // Validate the tail forward: it must open and close with a closing tag
+  // (the "resumed serialization, closers first" signature), carry at least
+  // two tag lines, and admit a non-tag line only as the value of the
+  // parameter opener directly above it.
+  let firstTag: string | null = null;
+  let lastTag: string | null = null;
+  let tagCount = 0;
+  for (let i = start; i < lines.length; i++) {
+    const line = lines[i]!;
+    if (BLANK_LINE.test(line)) {
+      continue;
+    }
+    const isCloser = CLOSER_LINE.test(line);
+    const isOpener = PARAMETER_OPENER_LINE.test(line);
+    if (!isCloser && !isOpener) {
+      if (i === start || !PARAMETER_OPENER_LINE.test(lines[i - 1]!)) {
+        return { text, removed: null };
+      }
+      continue;
+    }
+    tagCount++;
+    firstTag ??= isCloser ? 'closer' : 'opener';
+    lastTag = isCloser ? 'closer' : 'opener';
+  }
+  if (firstTag !== 'closer' || lastTag !== 'closer' || tagCount < 2) {
+    return { text, removed: null };
+  }
+
+  const kept = lines.slice(0, start).join('\n').replace(/\s+$/, '');
+  const removed = lines.slice(start).join('\n');
+  return { text: kept, removed };
+}
