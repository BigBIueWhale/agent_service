+/**
+ * @license
+ * Copyright 2025 Qwen
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import { describe, expect, it } from 'vitest';
+import {
+  deriveVllmTokenizeUrl,
+  validateVllmTokenizeResponse,
+} from './pipeline.js';
+
+describe('vLLM exact token counting', () => {
+  it('derives the root tokenizer endpoint from a /v1 API base', () => {
+    expect(deriveVllmTokenizeUrl('http://127.0.0.1:8000/v1')).toBe(
+      'http://127.0.0.1:8000/tokenize',
+    );
+    expect(deriveVllmTokenizeUrl('http://localhost:8000/prefix/v1/')).toBe(
+      'http://localhost:8000/prefix/tokenize',
+    );
+  });
+
+  it('rejects ambiguous or non-vLLM API bases', () => {
+    expect(() => deriveVllmTokenizeUrl(undefined)).toThrow(
+      'requires an explicit OpenAI baseUrl',
+    );
+    expect(() => deriveVllmTokenizeUrl('http://127.0.0.1:8000')).toThrow(
+      'requires baseUrl to end in /v1',
+    );
+    expect(() =>
+      deriveVllmTokenizeUrl('http://127.0.0.1:8000/v1?route=other'),
+    ).toThrow('without query parameters');
+  });
+
+  it('accepts only an integer count with the configured model window', () => {
+    expect(
+      validateVllmTokenizeResponse(
+        { count: 12_345, max_model_len: 262_144 },
+        262_144,
+      ),
+    ).toEqual({ totalTokens: 12_345, maxModelLen: 262_144 });
+  });
+
+  it('fails closed on malformed or mismatched responses', () => {
+    expect(() =>
+      validateVllmTokenizeResponse(
+        { count: 12.5, max_model_len: 262_144 },
+        262_144,
+      ),
+    ).toThrow('refusing to estimate');
+    expect(() =>
+      validateVllmTokenizeResponse(
+        { count: 12_345, max_model_len: 131_072 },
+        262_144,
+      ),
+    ).toThrow('refusing to use mismatched limits');
+    expect(() =>
+      validateVllmTokenizeResponse(
+        { count: 12_345, max_model_len: 262_144 },
+        undefined,
+      ),
+    ).toThrow('requires an explicit positive contextWindowSize');
+  });
+});
