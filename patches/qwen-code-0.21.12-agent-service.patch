+  llmContent: PartListUnion,
+  operationalMessage: string,
+): string {
+  const modelFacing = normalizeParts(llmContent)
+    .map((part) => (typeof part.text === 'string' ? part.text : ''))
+    .filter((text) => text.length > 0)
+    .join('\n')
+    .trim();
+  const operational = operationalMessage.trim();
+  if (modelFacing.length === 0) {
+    return operationalMessage;
+  }
+  if (operational.length === 0 || modelFacing.includes(operational)) {
+    return modelFacing;
+  }
+  return `${modelFacing}\n${operational}`;
