+    expect(metricValues('↳ Input Tokens')).toEqual(['10']);
+    expect(metricValues('↳ Output Tokens')).toEqual(['4']);
+    expect(metricValues('↳ Thoughts')).toEqual(['2']);
+    expect(metricValues('↳ Cached')).toEqual(['3 (30.0%)']);
+  });
+
+  it('retains complete raw model names containing source-like delimiters', () => {
+    const status = statusFor({
