+
+/**
+ * Parse the PNG container itself before asking an image library to decode it.
+ * This keeps the client contract aligned with the serving contract: one IHDR,
+ * at least one IDAT, one terminal IEND, no animation control, and no tRNS
+ * transparency shortcut. Decoder metadata is checked independently below.
+ */
+function inspectStrictPng(bytes: Buffer, filePath: string): StrictPngHeader {
+  const fail = (reason: string): never => {
+    throw new ImageViewError(
+      'invalid_png_contract',
+      `Image violates the Qwen3.8 full-quality PNG contract (${reason}): ${filePath}`,
+    );
+  };
+
+  if (
+    bytes.length < PNG_SIGNATURE.length ||
+    !bytes.subarray(0, PNG_SIGNATURE.length).equals(PNG_SIGNATURE)
+  ) {
+    fail('missing exact PNG signature');
+  }
+
+  let offset = PNG_SIGNATURE.length;
+  let header: StrictPngHeader | undefined;
+  let sawIdat = false;
+  let sawIend = false;
+  while (offset < bytes.length) {
+    if (offset + 12 > bytes.length) fail('truncated chunk header');
+    const length = bytes.readUInt32BE(offset);
+    const chunkEnd = offset + 12 + length;
+    if (chunkEnd > bytes.length) fail('truncated chunk payload');
+    const type = bytes.toString('ascii', offset + 4, offset + 8);
+    const dataOffset = offset + 8;
+
+    if (!header && type !== 'IHDR') fail('IHDR is not the first chunk');
+    if (type === 'IHDR') {
+      if (header) fail('duplicate IHDR');
+      if (length !== 13) fail('IHDR length is not 13 bytes');
+      header = {
+        width: bytes.readUInt32BE(dataOffset),
+        height: bytes.readUInt32BE(dataOffset + 4),
+        bitDepth: bytes[dataOffset + 8],
+        colorType: bytes[dataOffset + 9],
+      };
+      if (header.width === 0 || header.height === 0) {
+        fail('zero image dimension');
+      }
+      if (header.bitDepth !== 8 || ![2, 6].includes(header.colorType)) {
+        fail('source pixels are not 8-bit RGB or RGBA');
+      }
+      if (
+        bytes[dataOffset + 10] !== 0 ||
+        bytes[dataOffset + 11] !== 0 ||
+        ![0, 1].includes(bytes[dataOffset + 12])
+      ) {
+        fail('unsupported PNG compression, filter, or interlace method');
+      }
