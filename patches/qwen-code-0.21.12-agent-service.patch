+/**
+ * @license
+ * Copyright 2025 Qwen Team
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import { act, cleanup, renderHook } from '@testing-library/react';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import {
+  AgentEventEmitter,
+  AgentEventType,
+  AgentStatus,
+  type AgentInteractive,
+} from '@qwen-code/qwen-code-core';
+import { StreamingState } from '../types.js';
+import { useAgentStreamingState } from './useAgentStreamingState.js';
+
+function createAgent(id: string, count: number | undefined) {
+  const emitter = new AgentEventEmitter();
+  const getLastServedPromptTokenCount = vi.fn(() => count);
+  const getStatus = vi.fn(() => AgentStatus.IDLE);
+  const agent = {
+    getEventEmitter: () => emitter,
+    getLastServedPromptTokenCount,
+    getStatus,
+    getPendingApprovals: () => new Map(),
+  } satisfies Pick<
+    AgentInteractive,
+    | 'getEventEmitter'
+    | 'getLastServedPromptTokenCount'
+    | 'getStatus'
+    | 'getPendingApprovals'
+  >;
+  return {
+    agent: agent as unknown as AgentInteractive,
+    emitter,
+    getStatus,
+    getLastServedPromptTokenCount,
+    publishUsage(promptTokenCount: number) {
+      getLastServedPromptTokenCount.mockReturnValue(promptTokenCount);
+      emitter.emit(AgentEventType.USAGE_METADATA, {
+        subagentId: id,
+        round: 1,
+        timestamp: 1,
+        usage: {
+          promptTokenCount,
+          candidatesTokenCount: 0,
+          cachedContentTokenCount: 0,
+          thoughtsTokenCount: 0,
+          totalTokenCount: promptTokenCount,
+        },
+      });
+    },
+  };
+}
+
+afterEach(() => {
+  cleanup();
+  vi.restoreAllMocks();
+});
+
+describe('useAgentStreamingState selected owner', () => {
