+
+import { describe, it, expect } from 'vitest';
+import {
+  describeSessionTurnBudget,
+  sessionTurnBudgetReached,
+  validateMaxSessionTurns,
+  UNLIMITED_SESSION_TURNS,
+} from './session-turn-budget.js';
+
+describe('validateMaxSessionTurns', () => {
+  it.each([UNLIMITED_SESSION_TURNS, 1, 400, 2000])('accepts %d', (value) => {
+    expect(validateMaxSessionTurns(value)).toBe(value);
+  });
+
+  it('reads an unset budget as unlimited', () => {
+    expect(validateMaxSessionTurns(undefined)).toBe(UNLIMITED_SESSION_TURNS);
+  });
+
+  it.each([0, -2, -42])('refuses %d as a budget', (value) => {
+    expect(() => validateMaxSessionTurns(value)).toThrow(
+      /must be >= 1 \(or -1 for unlimited\)/,
+    );
+  });
+
+  it.each([0.5, Number.NaN, Number.POSITIVE_INFINITY])(
+    'refuses the non-integer %s',
+    (value) => {
+      expect(() => validateMaxSessionTurns(value)).toThrow(
+        /must be an integer/,
+      );
+    },
+  );
+});
+
+describe('sessionTurnBudgetReached', () => {
+  it('never stops a run that was given the unlimited sentinel', () => {
+    expect(sessionTurnBudgetReached(UNLIMITED_SESSION_TURNS, 0)).toBe(false);
+    expect(sessionTurnBudgetReached(UNLIMITED_SESSION_TURNS, 1_000_000)).toBe(
+      false,
+    );
+  });
+
+  it('admits exactly as many budgeted turns as the budget names', () => {
+    expect(sessionTurnBudgetReached(3, 0)).toBe(false);
+    expect(sessionTurnBudgetReached(3, 2)).toBe(false);
+    expect(sessionTurnBudgetReached(3, 3)).toBe(true);
+    expect(sessionTurnBudgetReached(3, 4)).toBe(true);
+  });
+});
+
+describe('describeSessionTurnBudget', () => {
+  it('states the bound, the turns it admitted, and what is absent', () => {
+    const message = describeSessionTurnBudget(400, 400, false);
+
+    expect(message).toBe(
+      'Reached the session turn budget of 400 after 400 completed turn(s); ' +
+        'the run stopped between turns and carries no final answer.',
+    );
+  });
+
+  it('names the unmet structured-output contract when one was required', () => {
+    const message = describeSessionTurnBudget(12, 12, true);
+
+    expect(message).toContain('the session turn budget of 12');
+    expect(message).toContain('--json-schema contract was never met');
+    expect(message).toContain('structured_output');
+  });
+});
diff --git a/packages/core/src/config/session-turn-budget.ts b/packages/core/src/config/session-turn-budget.ts
--- /dev/null
+++ b/packages/core/src/config/session-turn-budget.ts
@@ -0,0 +1,80 @@
+/**
+ * @license
+ * Copyright 2025 Qwen Team
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import { FatalConfigError } from '../utils/errors.js';
+
+/** The one value of `maxSessionTurns` that means "no session turn budget". */
+export const UNLIMITED_SESSION_TURNS = -1;
+
+/**
+ * Validates the session-turn limit at config and persisted-agent boundaries.
+ * {@link UNLIMITED_SESSION_TURNS} is the unlimited sentinel; every other
+ * accepted value is a real budget of at least one turn. A session permitted no
+ * model turn can do no work, and any other number outside the budget's range
+ * would quietly read as "unlimited" and disable the guardrail a caller
+ * believed it had set.
+ */
+export function validateMaxSessionTurns(value: number | undefined): number {
+  const resolved = value ?? UNLIMITED_SESSION_TURNS;
+  if (!Number.isInteger(resolved)) {
+    throw new FatalConfigError(
+      `Invalid maxSessionTurns: must be an integer, got ${String(resolved)}`,
+    );
+  }
+  if (resolved !== UNLIMITED_SESSION_TURNS && resolved < 1) {
+    throw new FatalConfigError(
+      `Invalid maxSessionTurns: must be >= 1 (or ${UNLIMITED_SESSION_TURNS} for unlimited), got ${resolved}`,
+    );
+  }
+  return resolved;
+}
+
+/**
+ * The session turn budget, asked once and answered the same way everywhere it
+ * is enforced: the interactive stream, the headless reasoning loop, and the
+ * headless drain loop all decide a turn's admissibility with this predicate,
+ * so a run cannot be stopped by one layer's reading of the bound and let
+ * through by another's.
+ *
+ * `startedBudgetedTurns` counts the turns already charged against the budget,
+ * so the question is asked before the turn it decides is started: a run
+ * stopped here reports exactly the budget it was given as its turn count,
+ * having started no turn it could not finish.
+ */
+export function sessionTurnBudgetReached(
+  maxSessionTurns: number,
+  startedBudgetedTurns: number,
+): boolean {
+  return maxSessionTurns >= 1 && startedBudgetedTurns >= maxSessionTurns;
+}
+
+/**
+ * States a run that the session turn budget stopped, in the terms the record
+ * can prove: the bound, how many turns it admitted, and what the run
+ * therefore does not carry. A run stopped here was stopped between turns, so
+ * unlike every other ending it interrupted nothing -- there is no partial
+ * turn behind it, and no final message was ever begun.
+ *
+ * Under a `--json-schema` contract the same ending has a second reading worth
+ * stating: the contract's terminating tool call never came, and the reasons
+ * for that are usually the tool being denied or the schema being
+ * unsatisfiable rather than the budget being too small.
+ */
+export function describeSessionTurnBudget(
+  maxSessionTurns: number,
+  completedTurns: number,
+  jsonSchemaActive: boolean,
+): string {
+  const base =
+    `Reached the session turn budget of ${maxSessionTurns} after ` +
+    `${completedTurns} completed turn(s); the run stopped between turns and ` +
+    'carries no final answer.';
+  return jsonSchemaActive
+    ? `${base} The --json-schema contract was never met: check that ` +
+        'structured_output is not denied by permissions.deny / --exclude-tools ' +
+        'and that the schema is satisfiable.'
+    : base;
+}
