diff --git a/packages/core/src/services/state-snapshot.ts b/packages/core/src/services/state-snapshot.ts
--- /dev/null
+++ b/packages/core/src/services/state-snapshot.ts
@@ -0,0 +1,59 @@
+import { SaxesParser } from 'saxes';
+
+const SECTIONS = [
+  'intent',
+  'environment',
+  'completed',
+  'in_progress',
+  'learnings',
+  'next_step',
+] as const;
+
+/** Exactly one XML snapshot with six nonempty text sections, no undeclared structure. */
+export function isValidStateSnapshot(summary: string): boolean {
+  let depth = 0;
+  let section = 0;
+  let text = '';
+  let complete = false;
+  const refuse = () => {
+    throw new Error('Invalid state snapshot structure');
+  };
+  try {
+    const parser = new SaxesParser({ xmlns: false });
+    parser.on('error', refuse);
+    parser.on('doctype', refuse);
+    parser.on('processinginstruction', refuse);
+    parser.on('xmldecl', refuse);
+    parser.on('comment', refuse);
+    parser.on('opentag', (tag) => {
+      if (Object.keys(tag.attributes).length > 0) refuse();
+      if (depth === 0) {
+        if (complete || tag.name !== 'state_snapshot') refuse();
+      } else if (depth === 1) {
+        if (tag.name !== SECTIONS[section]) refuse();
+        text = '';
+      } else refuse();
+      depth++;
+    });
+    const appendText = (value: string) => {
+      if (depth === 2) text += value;
+      else if (value.trim()) refuse();
+    };
+    parser.on('text', appendText);
+    parser.on('cdata', appendText);
+    parser.on('closetag', () => {
+      if (depth === 2) {
+        if (!text.trim()) refuse();
+        section++;
+      } else if (depth === 1) {
+        if (section !== SECTIONS.length) refuse();
+        complete = true;
+      }
+      depth--;
+    });
+    parser.write(summary).close();
+    return complete && depth === 0;
+  } catch {
+    return false;
+  }
+}
