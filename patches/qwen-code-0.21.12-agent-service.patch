--- /dev/null
+++ b/packages/cli/src/utils/relaunch-ownership-fixtures/child.mjs
@@ -0,0 +1,98 @@
+import { registerCleanup, runExitCleanup } from 'ACTUAL_CLEANUP';
+import {
+  appendFileSync,
+  readFileSync,
+  writeFileSync,
+  existsSync,
+  watchFile,
+  unwatchFile,
+} from 'node:fs';
+import { join } from 'node:path';
+const [root, mode] = process.argv.slice(2);
+const stat = readFileSync('/proc/self/stat', 'utf8');
+const starttime = stat.slice(stat.lastIndexOf(')') + 2).split(/\s+/)[19];
+const event = (type, data = {}) =>
+  appendFileSync(
+    join(root, 'child.events.jsonl'),
+    JSON.stringify({
+      type,
+      pid: process.pid,
+      ppid: process.ppid,
+      starttime,
+      ns: process.hrtime.bigint().toString(),
+      ...data,
+    }) + '\n',
+  );
+const ended = (code) => {
+  writeFileSync(
+    join(root, 'child.exiting.json'),
+    JSON.stringify({
+      pid: process.pid,
+      code,
+      ns: process.hrtime.bigint().toString(),
+    }),
+  );
+  event('child_exiting', { code });
+  process.exit(code);
+};
+// Represent pending work before cancellation even if a broken parent dies.
+// This timer only keeps the fixture live; it never releases or settles cleanup.
+const pendingWork = setInterval(() => {}, 60_000);
+let started = false;
+const handlers = [];
+for (const signal of ['SIGTERM', 'SIGINT', 'SIGHUP']) {
+  const handler = () => {
+    if (started) return;
+    started = true;
+    clearInterval(pendingWork);
+    event('abort', { signal });
+    writeFileSync(
+      join(root, 'child.aborted.json'),
+      JSON.stringify({ pid: process.pid, signal }),
+    );
+    registerCleanup(async () => {
+      event('cleanup_entered');
+      writeFileSync(join(root, 'cleanup.entered'), String(process.pid));
+      await new Promise((resolve) => {
+        const check = () => {
+          if (existsSync(join(root, 'release'))) {
+            unwatchFile(join(root, 'release'));
+            resolve();
+          }
+        };
+        watchFile(join(root, 'release'), { interval: 10 }, check);
+        check();
+      });
+      event('cleanup_released');
+    });
+    const cleaned = runExitCleanup();
+    // Model the caller relinquishing its work-cancellation handler after the
+    // synchronous cleanup owner has installed its own hold listeners.
+    for (const [name, fn] of handlers) process.off(name, fn);
+    event('caller_handlers_removed');
+    cleaned.then(
+      () => {
+        event('cleanup_settled');
+        ended(130);
+      },
+      (error) => {
+        event('cleanup_failed', { error: String(error) });
+        ended(1);
+      },
+    );
+  };
+  handlers.push([signal, handler]);
+  process.on(signal, handler);
+}
+process.on('disconnect', () => event('ipc_disconnect'));
+event('child_started', { mode });
+writeFileSync(
+  join(root, 'child.ready.json'),
+  JSON.stringify({
+    pid: process.pid,
+    ppid: process.ppid,
+    starttime,
+    ns: process.hrtime.bigint().toString(),
+  }),
+);
+if (mode === 'ordinary_exit') ended(7);
