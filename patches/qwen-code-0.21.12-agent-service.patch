+/** Provider-independent counts whose meaning is preserved by aggregation. */
+export interface GenerationUsageCounts {
+  promptTokenCount: number;
+  candidatesTokenCount: number;
+  thoughtsTokenCount: number;
+  cachedContentTokenCount: number;
+  totalTokenCount: number;
+}
+
+/** Served totals, with missing observations represented separately. */
+export interface GenerationUsageSummary {
+  requests: number;
+  usageReports: number;
+  unfinalizedRequests: number;
+  unreportedUsageRequests: number;
+  usage: GenerationUsageCounts | null;
+}
