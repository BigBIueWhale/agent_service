+/** A complete physical JSONL object, with fatal UTF-8 decoding. */
+export function decodeJsonlRecord<T>(bytes: Uint8Array, location: string): T {
+  try {
+    const text = new TextDecoder('utf-8', { fatal: true }).decode(bytes);
+    const value: unknown = JSON.parse(text);
+    if (!value || typeof value !== 'object' || Array.isArray(value)) {
+      throw new Error('record must be an object');
+    }
+    return value as T;
+  } catch (cause) {
+    throw new Error(`Invalid JSONL record at ${location}`, { cause });
+  }
+}
+
+function decodeJsonlRecords<T>(bytes: Buffer, filePath: string): T[] {
+  if (bytes.length > 0 && bytes[bytes.length - 1] !== 0x0a) {
+    throw new Error(`Unterminated JSONL record in ${filePath}`);
+  }
+  const records: T[] = [];
+  let start = 0;
+  while (start < bytes.length) {
+    const end = bytes.indexOf(0x0a, start);
+    records.push(
+      decodeJsonlRecord<T>(
+        bytes.subarray(start, end),
+        `${filePath}:${records.length + 1}`,
+      ),
+    );
+    start = end + 1;
+  }
+  return records;
+}
+
+/** Complete evidence; unreadable or damaged records refuse the read. */
+export async function readStrict<T>(filePath: string): Promise<T[]> {
+  return decodeJsonlRecords<T>(await fs.promises.readFile(filePath), filePath);
+}
+
+export function readStrictSync<T>(filePath: string): T[] {
+  return decodeJsonlRecords<T>(fs.readFileSync(filePath), filePath);
+}
 
