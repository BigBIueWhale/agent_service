+/**
+ * @license
+ * Copyright 2025 Qwen
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import fs from 'node:fs';
+
+export const QWEN38_LOCKED_RUNTIME_ENV = 'QWEN38_AGENT_SERVICE_LOCKED';
+export const QWEN38_LOCKED_SYSTEM_PROMPT_PATH = '/opt/agent/system.md';
+export const QWEN38_LOCKED_DEPLOYMENT_CONTRACT_PATH =
+  '/opt/agent/deployment-contract.md';
+
+function readRequiredRegularFile(filePath: string, label: string): string {
+  const stat = fs.lstatSync(filePath);
+  if (!stat.isFile() || stat.isSymbolicLink()) {
+    throw new Error(
+      `${label} must be a regular, non-symlink file: ${filePath}`,
+    );
+  }
+  const text = fs.readFileSync(filePath, 'utf8');
+  if (!text.trim() || !text.endsWith('\n') || text.includes('\r')) {
+    throw new Error(
+      `${label} must be nonempty UTF-8-style LF text with a terminal newline: ${filePath}`,
+    );
+  }
+  return text.trim();
+}
+
+export function isQwen38LockedAgentServiceRuntime(): boolean {
+  return process.env[QWEN38_LOCKED_RUNTIME_ENV] === '1';
+}
+
+/**
+ * Return the immutable deployment contract for the one locked agent-service
+ * runtime. Outside that runtime there is no implicit local deployment prompt.
+ */
+export function getQwen38DeploymentContract(): string {
+  if (!isQwen38LockedAgentServiceRuntime()) return '';
+
+  const systemPath = process.env['QWEN_SYSTEM_MD'];
+  const contractPath = process.env['QWEN_DEPLOYMENT_CONTRACT_MD'];
+  if (systemPath !== QWEN38_LOCKED_SYSTEM_PROMPT_PATH) {
+    throw new Error(
+      `locked agent-service requires QWEN_SYSTEM_MD=${QWEN38_LOCKED_SYSTEM_PROMPT_PATH}`,
+    );
+  }
+  if (contractPath !== QWEN38_LOCKED_DEPLOYMENT_CONTRACT_PATH) {
+    throw new Error(
+      `locked agent-service requires QWEN_DEPLOYMENT_CONTRACT_MD=${QWEN38_LOCKED_DEPLOYMENT_CONTRACT_PATH}`,
+    );
+  }
+
+  return readRequiredRegularFile(contractPath, 'deployment contract');
+}
+
+export function appendQwen38DeploymentContract(base: string): string {
+  const contract = getQwen38DeploymentContract();
+  return contract ? `${base.trim()}\n\n---\n\n${contract}` : base;
+}
+
+export function appendQwen38SubagentInvocation(
+  base: string,
+  execution:
+    | {
+        readonly scratchDir: string;
+        readonly subagentType: 'general-purpose' | 'Explore';
+      }
+    | undefined,
+): string {
+  if (!isQwen38LockedAgentServiceRuntime()) return base;
+  if (!execution) {
+    throw new Error(
+      'locked agent-service subagent prompt was built outside its invocation frame',
+    );
+  }
+  return `${base.trim()}\n\n## This foreground invocation\n\n- Role: ${execution.subagentType}\n- Private scratch root: ${execution.scratchDir}\n- TMPDIR, language caches, and build caches are routed beneath that exact scratch root.\n- Scratch is not a deliverable and is not automatically bundled. Deliberately promote anything that must survive to /workspace or /artifacts.\n- The scratch tree remains available to the parent until session teardown; cleanup errors are teardown diagnostics, never silent success.`;
+}
