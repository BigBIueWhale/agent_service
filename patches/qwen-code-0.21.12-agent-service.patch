+  {
+    label: 'no requests',
+    ownerUsage: {
+      requests: 0,
+      usageReports: 0,
+      unreportedUsageRequests: 0,
+      unfinalizedRequests: 0,
+      usage: null,
+    },
+    tokens: 'No served usage reported',
+    observations: [
+      '0 requests',
+      '0 usage reports',
+      '0 without usage',
+      '0 unfinalized',
+    ],
+  },
+  {
+    label: 'served zero',
+    ownerUsage: {
+      requests: 1,
+      usageReports: 1,
+      unreportedUsageRequests: 0,
+      unfinalizedRequests: 0,
+      usage: {
+        promptTokenCount: 0,
+        candidatesTokenCount: 0,
+        thoughtsTokenCount: 0,
+        cachedContentTokenCount: 0,
+        totalTokenCount: 0,
+      },
+    },
+    tokens: '0 reported tokens (in 0, out 0)',
+    observations: [
+      '1 requests',
+      '1 usage reports',
+      '0 without usage',
+      '0 unfinalized',
+    ],
+  },
+  {
+    label: 'missing and unfinished reports',
+    ownerUsage: {
+      requests: 3,
+      usageReports: 1,
+      unreportedUsageRequests: 1,
+      unfinalizedRequests: 1,
+      usage: {
+        promptTokenCount: 100,
+        candidatesTokenCount: 50,
+        thoughtsTokenCount: 20,
+        cachedContentTokenCount: 30,
+        totalTokenCount: 150,
+      },
+    },
+    tokens: '150 reported tokens (in 100, out 50)',
+    observations: [
+      '3 requests',
+      '1 usage reports',
+      '1 without usage',
+      '1 unfinalized',
+    ],
+  },
+];
+
+function managerFor(
+  ownerUsage: GenerationUsageSummary,
+  mode: 'tmux' | 'in-process',
+) {
+  const cached = {
+    requests: 99,
+    usageReports: 0,
+    unreportedUsageRequests: 0,
+    unfinalizedRequests: 99,
+    usage: null,
+  };
+  return {
+    getBackend: () => ({
+      type: mode,
+      getAgent: () => ({
+        getStats: () => ({
+          ownerUsage,
+          rounds: 17,
+          totalToolCalls: 7,
+          successfulToolCalls: 6,
+          failedToolCalls: 1,
+          totalDurationMs: 12_000,
+        }),
+      }),
+    }),
+    getSessionStatus: () => ArenaSessionStatus.IDLE,
+    getTask: () => 'Own invocation',
+    getAgentStates: () => [
+      {
+        agentId: 'own',
+        model: { modelId: 'own', authType: 'openai' },
+        status: AgentStatus.IDLE,
+        startedAt: 0,
+        stats: {
+          ownerUsage: mode === 'in-process' ? cached : ownerUsage,
+          durationMs: 12_000,
+          toolCalls: mode === 'in-process' ? 99 : 7,
+          successfulToolCalls: mode === 'in-process' ? 99 : 6,
+          failedToolCalls: mode === 'in-process' ? 0 : 1,
+        },
+      },
+    ],
+  } as unknown as ArenaManager;
+}
+
+describe('ArenaStatusDialog', () => {
+  describe.each(['tmux', 'in-process'] as const)(
+    '%s owner projection',
+    (mode) => {
+      it.each(usageCases)(
+        'renders $label with requests and independent duration/tool facts',
+        ({ ownerUsage, tokens, observations }) => {
+          const { lastFrame, unmount } = renderWithProviders(
+            <ArenaStatusDialog
+              manager={managerFor(ownerUsage, mode)}
+              closeArenaDialog={vi.fn()}
+              width={120}
+            />,
+          );
+          const frame = (lastFrame() ?? '').replace(/[│\s]+/g, ' ');
+          expect(frame).toContain(tokens);
+          for (const observation of observations)
+            expect(frame).toContain(observation);
+          expect(frame).toContain('Requests');
+          expect(frame).toContain('12.0s');
+          expect(frame).toContain('6/1');
+          expect(frame).not.toContain('99 requests');
+          expect(frame).not.toContain('Rounds');
+          if (ownerUsage.usage === null) expect(frame).toContain('unknown');
+          unmount();
+        },
+      );
+    },
+  );
+
+  it.each(['q', '\r', '\x1b'])('closes on %j', async (key) => {
+    const closeArenaDialog = vi.fn();
+    const { stdin, unmount } = renderWithProviders(
+      <ArenaStatusDialog
+        manager={managerFor(usageCases[0]!.ownerUsage, 'tmux')}
+        closeArenaDialog={closeArenaDialog}
+      />,
+    );
+    stdin.write(key);
+    await waitFor(() => expect(closeArenaDialog).toHaveBeenCalledTimes(1));
+    unmount();
+  });
+});
