diff --git a/packages/core/src/core/generation-context.ts b/packages/core/src/core/generation-context.ts
--- /dev/null
+++ b/packages/core/src/core/generation-context.ts
@@ -0,0 +1,70 @@
+/**
+ * @license
+ * Copyright 2026 Qwen
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import type {
+  GenerateContentParameters,
+  EmbedContentParameters,
+} from '@google/genai';
+import type { ContentGenerator } from './contentGenerator.js';
+
+/** Cache ownership belongs to an invocation, independently of model selection. */
+export class GenerationContext {
+  constructor(readonly kvScope: string) {
+    if (typeof kvScope !== 'string' || !kvScope.trim()) {
+      throw new Error('Generation requires a nonempty owning invocation ID.');
+    }
+    Object.freeze(this);
+  }
+
+  bind(provider: ContentGenerator): GenerationClient {
+    return new GenerationClient(provider, this);
+  }
+}
+
+export type OwnedGenerationRequest = GenerateContentParameters & {
+  readonly generationContext: GenerationContext;
+};
+
+/** Every provider request is constructed here with its owning invocation. */
+export class GenerationClient {
+  constructor(
+    readonly provider: ContentGenerator,
+    readonly context: GenerationContext,
+  ) {}
+
+  generateContent(request: GenerateContentParameters, promptId: string) {
+    return this.provider.generateContent(
+      { ...request, generationContext: this.context },
+      promptId,
+    );
+  }
+
+  generateContentStream(request: GenerateContentParameters, promptId: string) {
+    return this.provider.generateContentStream(
+      { ...request, generationContext: this.context },
+      promptId,
+    );
+  }
+
+  countRequestTokens(request: GenerateContentParameters, promptId: string) {
+    if (!this.provider.countRequestTokens) {
+      throw new Error(
+        'The configured provider cannot count its rendered requests.',
+      );
+    }
+    return this.provider.countRequestTokens(
+      { ...request, generationContext: this.context },
+      promptId,
+    );
+  }
+
+  embedContent(request: EmbedContentParameters) {
+    return this.provider.embedContent(request);
+  }
+  useSummarizedThinking() {
+    return this.provider.useSummarizedThinking();
+  }
+}
