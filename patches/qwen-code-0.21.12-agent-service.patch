+/**
+ * @license
+ * Copyright 2026 Qwen
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import {
+  runOutsideAgentContext,
+  uiTelemetryService,
+  type Config,
+} from '@qwen-code/qwen-code-core';
+import type { UIState } from './contexts/UIStateContext.js';
+import { buildStatusLinePresetData } from './statusLinePresets.js';
+
+export function getStatusLineData(config: Config, uiState: UIState) {
+  // A child telemetry event may trigger rendering inside its execution frame.
+  return runOutsideAgentContext(() => {
+    const stats = uiState.sessionStats;
+    const route = config.getContentGeneratorConfig();
+    return buildStatusLinePresetData({
+      sessionId: stats.sessionId,
+      version: config.getCliVersion(),
+      modelDisplayName: uiState.currentModel
+        ? config.getModelsConfig().getModelDisplayName(uiState.currentModel)
+        : config.getModelDisplayName(),
+      reasoning: route?.reasoning,
+      currentDir: config.getTargetDir(),
+      branch: uiState.branchName,
+      contextWindowSize: route?.contextWindowSize,
+      lastServedPromptTokens: stats.lastServedPromptTokenCount,
+      generationUsage: uiTelemetryService.getGenerationUsage(stats.sessionId),
+      totalLinesAdded: stats.metrics.files.totalLinesAdded,
+      totalLinesRemoved: stats.metrics.files.totalLinesRemoved,
+      streamingState: uiState.streamingState,
+    });
+  });
+}
