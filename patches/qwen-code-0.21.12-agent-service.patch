+import { describe, expect, it } from 'vitest';
+import vectors from './__fixtures__/partial-stream-v1.json' with { type: 'json' };
+import { RuntimePartialStream } from './runtime-partial-stream.js';
+import { validateRuntimeStreamRecord } from './runtime-stream-contract.js';
+
+describe('shared partial-stream temporal vectors', () => {
+  it.each(vectors.cases)('$name', (test) => {
+    const owner = new RuntimePartialStream();
+    const run = () => {
+      for (const action of test.actions) {
+        switch (action.kind) {
+          case 'partial': {
+            const record = {
+              type: 'stream_event',
+              uuid: 'event',
+              session_id: 'session',
+              parent_tool_use_id: test.root ? null : 'tool',
+              event: action.event,
+            };
+            expect(validateRuntimeStreamRecord(record)).toBeNull();
+            owner.observe(
+              action.event as Parameters<RuntimePartialStream['observe']>[0],
+              test.root,
+            );
+            break;
+          }
+          case 'message_complete':
+            owner.completeMessage();
+            break;
+          case 'scope_complete':
+            owner.finish();
+            break;
+          default:
+            throw new Error(`Unknown fixture action ${action.kind}`);
+        }
+      }
+    };
+    if (test.expected.state === 'accepted') expect(run).not.toThrow();
+    else expect(run).toThrow(test.expected.cause);
+  });
+});
diff --git a/packages/core/src/utils/runtime-partial-stream.ts b/packages/core/src/utils/runtime-partial-stream.ts
--- /dev/null
+++ b/packages/core/src/utils/runtime-partial-stream.ts
@@ -0,0 +1,98 @@
+import type { PARTIAL_EVENT_KINDS } from '../generated/stream-contract.js';
+
+type PartialKind = (typeof PARTIAL_EVENT_KINDS)[number];
+
+/** Temporal rules for the shared stream protocol: root markers delimit turns;
+ * complete assistant records delimit category-specific block groups in either
+ * root or child scopes. Only structurally admitted records enter this owner.
+ */
+export class RuntimePartialStream {
+  private rootTurnOpen = false;
+  private readonly blocks = new Map<number, { type: string; open: boolean }>();
+
+  observe(
+    event: {
+      type: PartialKind;
+      index?: number;
+      content_block?: { type: string };
+      delta?: { type: string };
+    },
+    root: boolean,
+  ): void {
+    switch (event.type) {
+      case 'message_start':
+        if (!root || this.rootTurnOpen || this.blocks.size !== 0) {
+          throw new Error('message_start requires a new root turn');
+        }
+        this.rootTurnOpen = true;
+        return;
+      case 'content_block_start': {
+        if (root && !this.rootTurnOpen)
+          throw new Error('root content block precedes message_start');
+        if (event.index !== this.blocks.size)
+          throw new Error(
+            "content block index does not follow this message's prefix",
+          );
+        this.blocks.set(event.index, {
+          type: event.content_block!.type,
+          open: true,
+        });
+        return;
+      }
+      case 'content_block_delta':
+      case 'content_block_stop': {
+        const block = this.blocks.get(event.index!);
+        if (!block) throw new Error('content block was not started');
+        if (!block.open) throw new Error('content block is already closed');
+        if (event.type === 'content_block_stop') {
+          block.open = false;
+          return;
+        }
+        const expected =
+          block.type === 'text'
+            ? 'text_delta'
+            : block.type === 'thinking'
+              ? 'thinking_delta'
+              : block.type === 'tool_use'
+                ? 'input_json_delta'
+                : undefined;
+        if (!expected)
+          throw new Error('this content block has no delta representation');
+        if (event.delta!.type !== expected)
+          throw new Error('delta type contradicts its content block');
+        return;
+      }
+      case 'message_stop':
+        if (!root || !this.rootTurnOpen || this.blocks.size !== 0) {
+          throw new Error(
+            'message_stop requires a root turn with all complete messages delivered',
+          );
+        }
+        this.rootTurnOpen = false;
+        return;
+      case 'goal_state':
+      case 'active_goal':
+      case 'tool_progress':
+        return;
+      default: {
+        const unhandled: never = event.type;
+        throw new Error(
+          `Shared partial event lacks an interpretation: ${unhandled}`,
+        );
+      }
+    }
+  }
+
+  completeMessage(): void {
+    if ([...this.blocks.values()].some((block) => block.open)) {
+      throw new Error('assistant message has an unclosed partial block');
+    }
+    this.blocks.clear();
+  }
+
+  finish(): void {
+    if (this.rootTurnOpen || this.blocks.size !== 0) {
+      throw new Error('scope has unfinished partial output');
+    }
+  }
+}
