+export function undeclaredToolParamsError(
+  toolName: string,
+  parametersJsonSchema: unknown,
+  params: object,
+): string | null {
+  if (
+    typeof parametersJsonSchema !== 'object' ||
+    parametersJsonSchema === null ||
+    Array.isArray(parametersJsonSchema)
+  ) {
+    return null;
+  }
+  const schema = parametersJsonSchema as {
+    properties?: unknown;
+    additionalProperties?: unknown;
+    patternProperties?: unknown;
+  };
+  if (
+    schema.additionalProperties !== false ||
+    schema.patternProperties !== undefined
+  ) {
+    return null;
+  }
+  const properties = schema.properties;
+  if (
+    typeof properties !== 'object' ||
+    properties === null ||
+    Array.isArray(properties)
+  ) {
+    return null;
+  }
+  const declared = Object.keys(properties as Record<string, unknown>);
+  if (declared.length === 0) {
+    return null;
+  }
+  const declaredSet = new Set(declared);
+  const undeclared = Object.keys(params).filter(
+    (name) => !declaredSet.has(name),
+  );
+  if (undeclared.length === 0) {
+    return null;
+  }
+  const offending = undeclared.map((name) => `'${name}'`).join(', ');
+  const accepted = declared.map((name) => `'${name}'`).join(', ');
+  const subject = undeclared.length === 1 ? 'parameter' : 'parameters';
+  // The refusal names what was rejected and the complete set that exists, so
+  // the correction is available without a second failed call. It does not
+  // restate the call shape: the schema already carries that, in every
+  // request, and a second copy here could drift from it.
+  return (
+    `${toolName} has no ${subject} ${offending}. ` +
+    `It accepts exactly: ${accepted}. ` +
+    `Re-send the call using only those parameters.`
+  );
