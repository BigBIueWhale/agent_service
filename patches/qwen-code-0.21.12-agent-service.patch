+  it.each(['modified_by_user', 'ai_proposed_content'])(
+    'rejects model-supplied %s on Edit and Write',
+    (key) => {
+      const config = {} as Config;
+      expect(() =>
+        new EditTool(config).build({
+          file_path: '/tmp/example',
+          old_string: 'old',
+          new_string: 'new',
+          [key]: true,
+        }),
+      ).toThrow(key);
+      expect(() =>
+        new WriteFileTool(config).build({
+          file_path: '/tmp/example',
+          content: 'text',
+          [key]: true,
+        }),
+      ).toThrow(key);
+    },
