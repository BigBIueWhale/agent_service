@@ -0,0 +1,54 @@
+import { relaunchAppInChildProcess } from 'ACTUAL_RELAUNCH';
+import { writeFileSync, appendFileSync, existsSync } from 'node:fs';
+import { join } from 'node:path';
+const [root, mode, childBundle] = process.argv.slice(2);
+const event = (type, data = {}) =>
+  appendFileSync(
+    join(root, 'parent.events.jsonl'),
+    JSON.stringify({
+      type,
+      pid: process.pid,
+      ns: process.hrtime.bigint().toString(),
+      ...data,
+    }) + '\n',
+  );
+writeFileSync(
+  join(root, 'parent.json'),
+  JSON.stringify({ pid: process.pid, ppid: process.ppid }),
+);
+process.on('exit', (code) =>
+  event('parent_exit', {
+    code,
+    childExited: existsSync(join(root, 'child.exiting.json')),
+    releasePresent: existsSync(join(root, 'release')),
+  }),
+);
+delete process.env.QWEN_CODE_NO_RELAUNCH;
+process.execArgv = [];
+process.argv = [process.execPath, childBundle, root, mode];
+if (mode === 'spawn_error')
+  process.execPath = join(root, 'missing-node-executable');
+await relaunchAppInChildProcess([], [], {
+  afterSpawn() {
+    event('after_spawn');
+    if (mode.startsWith('after_spawn_')) {
+      const end = Date.now() + 5000;
+      while (!existsSync(join(root, 'child.ready.json'))) {
+        if (Date.now() > end) throw Error('fixture child never ready');
+        Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 10);
+      }
+      event('hook_throw');
+      const causes = {
+        after_spawn_throw: Error('owned-afterSpawn-failure'),
+        after_spawn_undefined: undefined,
+        after_spawn_null: null,
+        after_spawn_false: false,
+        after_spawn_zero: 0,
+        after_spawn_empty: '',
+      };
+      throw causes[mode];
+    }
+  },
+});
+event('unexpected_return');
+process.exit(99);
