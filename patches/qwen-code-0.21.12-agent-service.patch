--- /dev/null
+++ b/packages/core/src/utils/runtime-stream-contract.ts
@@ -0,0 +1,124 @@
+import type { GoalSnapshotV2 } from '../goals/goal-protocol.js';
+import { requireGenerationUsage } from '../telemetry/generation-usage.js';
+import {
+  GOAL_CHECKPOINT_EVIDENCE_MAX_BYTES,
+  STREAM_CONTRACT_SHA256,
+  STREAM_EVENT_KINDS,
+  SYSTEM_EVENT_KINDS,
+  PARTIAL_EVENT_KINDS,
+} from '../generated/stream-contract.js';
+import generatedGoalValidator from '../generated/goal-snapshot-validator.js';
+import generatedStreamValidator from '../generated/stream-record-validator.js';
+import generatedControlValidator from '../generated/outbound-control-validator.js';
+import type { ErrorObject } from 'ajv';
+
+const validateGoalStructure = generatedGoalValidator;
+const validateStreamStructure = generatedStreamValidator;
+const validateControlStructure = generatedControlValidator;
+
+export { STREAM_CONTRACT_SHA256 };
+export {
+  STREAM_EVENT_KINDS,
+  OUTBOUND_CONTROL_KINDS,
+} from '../generated/stream-contract.js';
+
+export function validateRuntimeControlRecord(value: unknown): string | null {
+  return validateControlStructure(value)
+    ? null
+    : schemaError(validateControlStructure.errors);
+}
+
+function schemaError(errors: ErrorObject[] | null | undefined): string {
+  if (!errors?.length) {
+    throw new Error('Shared schema validator failed without a diagnostic');
+  }
+  return errors
+    .map((error) => `${error.instancePath}: ${error.message}`)
+    .join('; ');
+}
+
+export function validateGoalSnapshot(value: unknown): string | null {
+  if (!validateGoalStructure(value))
+    return schemaError(validateGoalStructure.errors);
+  const snapshot = value as GoalSnapshotV2;
+  const goal = snapshot.goal;
+  const checkpoint = goal?.evidenceCheckpoint;
+  if (checkpoint !== undefined) {
+    if (goal?.evidenceCursor.recordId !== checkpoint.checkpointId) {
+      return 'Goal evidence cursor does not name its checkpoint';
+    }
+    let bytes = 0;
+    for (const [index, claim] of checkpoint.claims.entries()) {
+      if (claim.id !== `${checkpoint.checkpointId}:${index + 1}`) {
+        return 'Goal evidence claim identity does not match its checkpoint and position';
+      }
+      bytes += new TextEncoder().encode(claim.claim).byteLength;
+    }
+    if (bytes > GOAL_CHECKPOINT_EVIDENCE_MAX_BYTES) {
+      return 'Goal evidence claim UTF-8 bytes exceed the shared evidence bound';
+    }
+  }
+  return null;
+}
+
+export function validateRuntimeStreamRecord(value: unknown): string | null {
+  if (value === null || typeof value !== 'object' || Array.isArray(value)) {
+    return 'Runtime stream record must be an object';
+  }
+  const envelope = value as Record<string, unknown>;
+  if (!STREAM_EVENT_KINDS.some((kind) => kind === envelope['type'])) {
+    return `Unsupported stream event type ${JSON.stringify(envelope['type'])}`;
+  }
+  if (
+    envelope['type'] === 'system' &&
+    !SYSTEM_EVENT_KINDS.some((kind) => kind === envelope['subtype'])
+  ) {
+    return `Unsupported system subtype ${JSON.stringify(envelope['subtype'])}`;
+  }
+  if (envelope['type'] === 'stream_event') {
+    const event = envelope['event'];
+    if (event === null || typeof event !== 'object' || Array.isArray(event)) {
+      return 'stream_event requires an object event';
+    }
+    const partial = event as Record<string, unknown>;
+    if (!PARTIAL_EVENT_KINDS.some((kind) => kind === partial['type'])) {
+      return `Unsupported stream_event variant ${JSON.stringify(partial['type'])}`;
+    }
+    if (partial['type'] === 'goal_state') {
+      const error = validateGoalSnapshot(partial['goal_state']);
+      if (error !== null) return `Invalid goal_state: ${error}`;
+    }
+  }
+  if (!validateStreamStructure(value))
+    return schemaError(validateStreamStructure.errors);
+  const record = value as {
+    type: string;
+    subtype?: string;
+    stream_contract_sha256?: string;
+    data?: { stream_contract_sha256?: string; usage?: { ownerUsage: unknown } };
+    event?: { type: string; goal_state?: unknown };
+  };
+  if (
+    record.type === 'system' &&
+    (record.subtype === 'init' || record.subtype === 'session_start')
+  ) {
+    const identity =
+      record.subtype === 'init'
+        ? record.stream_contract_sha256
+        : record.data?.stream_contract_sha256;
+    if (identity !== STREAM_CONTRACT_SHA256)
+      return 'Stream contract identity is missing or incompatible';
+  }
+  if (
+    record.type === 'system' &&
+    record.subtype === 'task_notification' &&
+    record.data?.usage
+  ) {
+    try {
+      requireGenerationUsage(record.data.usage.ownerUsage);
+    } catch (error) {
+      return `Task usage summary is invalid: ${String(error)}`;
+    }
+  }
+  return null;
+}
