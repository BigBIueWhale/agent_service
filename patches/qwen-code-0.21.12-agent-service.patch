+/**
+ * The reasoning the first candidate emitted, concatenated: exactly the parts
+ * `getResponseText` drops. For observation only; this text is never handed
+ * back to a model.
+ */
+export function getResponseThoughtText(
+  response: GenerateContentResponse,
+): string | null {
+  const parts = response.candidates?.[0]?.content?.parts;
+  if (!parts || parts.length === 0) {
+    return null;
+  }
+  return parts
+    .filter((part) => part.text && part.thought)
+    .map((part) => part.text)
+    .join('');
 }
 
