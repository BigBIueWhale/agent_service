diff --git a/packages/core/src/utils/cleanup.ts b/packages/core/src/utils/cleanup.ts
--- /dev/null
+++ b/packages/core/src/utils/cleanup.ts
@@ -0,0 +1,58 @@
+function throwCleanupErrors(errors: unknown[]): void {
+  if (errors.length === 1) throw errors[0];
+  if (errors.length > 1)
+    throw new AggregateError(errors, 'Cleanup obligations failed');
+}
+
+/** Completes independent cleanup obligations and preserves every failure. */
+export async function runCleanupSteps(
+  steps: Iterable<() => void | Promise<void>>,
+): Promise<void> {
+  const errors: unknown[] = [];
+  for (const step of steps) {
+    try {
+      await step();
+    } catch (error) {
+      if (!errors.includes(error)) errors.push(error);
+    }
+  }
+  throwCleanupErrors(errors);
+}
+
+/** Settles synchronous owners before returning to their caller. */
+export function runCleanupStepsSync(steps: Iterable<() => void>): void {
+  const errors: unknown[] = [];
+  for (const step of steps) {
+    try {
+      step();
+    } catch (error) {
+      if (!errors.includes(error)) errors.push(error);
+    }
+  }
+  throwCleanupErrors(errors);
+}
+
+export function withSyncCleanup<T>(operation: () => T, cleanup: () => void): T {
+  let result!: T;
+  runCleanupStepsSync([
+    () => {
+      result = operation();
+    },
+    cleanup,
+  ]);
+  return result;
+}
+/** Retains an operation's value only after its cleanup obligations settle. */
+export async function withCleanup<T>(
+  operation: () => Promise<T>,
+  cleanup: () => void | Promise<void>,
+): Promise<T> {
+  let result!: T;
+  await runCleanupSteps([
+    async () => {
+      result = await operation();
+    },
+    cleanup,
+  ]);
+  return result;
+}
