+
+vi.mock('../telemetry/loggers.js', async (importOriginal) => {
+  const actual =
+    await importOriginal<typeof import('../telemetry/loggers.js')>();
+  return { ...actual, logChatCompression: vi.fn() };
+});
+
+interface Source {
+  id: string;
+  author: 'user' | 'delegator';
+  parts: Part[];
+}
+type OwnedPart = Part & { authoredInstructions: Source[] };
+
+function historyOf(parts: PartListUnion): Content[] {
+  return [createUserContent(parts)];
+}
+
+function sources(history: readonly Content[]): Source[] {
+  const found = new Map<string, Source>();
+  for (const content of history) {
+    for (const part of content.parts ?? []) {
+      for (const source of (part as Partial<OwnedPart>).authoredInstructions ??
+        []) {
+        if (!found.has(source.id)) found.set(source.id, source);
+      }
+    }
+  }
+  return [...found.values()];
+}
+
+const originalText =
+  '  לשמור עברית\r\n中文 🧪 <state_snapshot>&raw;</state_snapshot>\t';
+const image: Part = { inlineData: { mimeType: 'image/png', data: 'AAEC/w==' } };
+const document: Part = {
+  fileData: {
+    mimeType: 'application/pdf',
+    fileUri: 'file:///fixture/original.pdf',
+  },
+};
+const summary =
+  '<state_snapshot><intent>Derived state</intent><environment>Repository</environment><completed>Inspection</completed><in_progress>Implementation</in_progress><learnings>Verified state</learnings><next_step>Test</next_step></state_snapshot>';
+const compose = (history: Content[]) =>
+  composePostCompactHistory(history, summary, { maxFiles: 0, maxImages: 0 });
+
+function chatRecord(
+  fields: Pick<ChatRecord, 'type'> & Partial<ChatRecord>,
+): ChatRecord {
+  return {
+    uuid: `record-${fields.subtype ?? fields.type}`,
+    parentUuid: null,
+    sessionId: 'authored-session',
+    timestamp: '2026-09-08T00:00:00.000Z',
+    cwd: '/fixture',
+    version: 'fixture',
+    ...fields,
+  };
+}
+
+describe('authored instruction ownership', () => {
+  it('captures original bytes and media independently of mutable input presentation', () => {
+    const original = [
+      { text: originalText },
+      structuredClone(image),
+      structuredClone(document),
+    ];
+    const marked = retainUserInput(
+      [{ text: 'expanded runtime presentation' }],
+      original,
+    );
+    original[0].text = 'mutated outside';
+    original[1].inlineData!.data = 'mutated outside';
+    const retained = retainedInstructionParts(historyOf(marked));
+    expect(sources(historyOf(retained))).toEqual([
+      {
+        id: expect.any(String),
+        author: 'user',
+        parts: [{ text: originalText }, image, document],
+      },
+    ]);
+    expect(
+      retained.slice(1).map((part) => {
+        const { authoredInstructions: _ownership, ...payload } =
+          part as Partial<OwnedPart>;
+        return payload;
+      }),
+    ).toEqual([{ text: originalText }, image, document]);
+  });
+
+  it('keeps user and delegated sources distinct in chronological order', () => {
+    const user = retainUserInput(
+      [{ text: 'expanded' }],
+      [{ text: 'first correction' }],
