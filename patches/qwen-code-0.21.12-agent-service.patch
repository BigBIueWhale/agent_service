+import { getRecordedUiEvent } from './recorded-ui-telemetry.js';
+import type { ChatRecord } from './chatRecordingService.js';
+import { EVENT_API_DISPATCH, EVENT_API_USAGE } from '../telemetry/constants.js';
+import {
+  GenerationObservations,
+  type GenerationObservationEvent,
+  type GenerationObservation,
+} from '../telemetry/generation-observations.js';
+
+/** Dispatches survive even when an eager stream is never consumed or the process is cut. */
+export function getRecordedGenerationObservations(
+  records: readonly ChatRecord[],
+): readonly GenerationObservation[] {
+  const observations = new GenerationObservations();
+  for (const record of records) {
+    const event = getRecordedUiEvent(record);
+    if (!event) continue;
+    if (
+      event['event.name'] !== EVENT_API_DISPATCH &&
+      event['event.name'] !== EVENT_API_USAGE
+    )
+      continue;
+    observations.add(event as unknown as GenerationObservationEvent);
+  }
+  return observations.values();
+}
diff --git a/packages/core/src/services/recorded-ui-telemetry.ts b/packages/core/src/services/recorded-ui-telemetry.ts
--- /dev/null
+++ b/packages/core/src/services/recorded-ui-telemetry.ts
@@ -0,0 +1,27 @@
+import type { ChatRecord } from './chatRecordingService.js';
+import type { UiEvent } from '../telemetry/uiTelemetry.js';
+
+export function getRecordedUiEvent(record: ChatRecord): UiEvent | undefined {
+  if (record.type !== 'system' || record.subtype !== 'ui_telemetry')
+    return undefined;
+  const payload = record.systemPayload;
+  if (!payload || typeof payload !== 'object' || Array.isArray(payload)) {
+    throw new Error('Invalid recorded telemetry payload');
+  }
+  const event = (payload as { uiEvent?: unknown }).uiEvent;
+  if (
+    !event ||
+    typeof event !== 'object' ||
+    Array.isArray(event) ||
+    typeof (event as Record<string, unknown>)['event.name'] !== 'string' ||
+    !(event as Record<string, unknown>)['event.name']
+  ) {
+    throw new Error('Invalid recorded telemetry event');
+  }
+  if ('session_id' in event && event.session_id !== record.sessionId) {
+    throw new Error(
+      'Recorded telemetry session does not match its owning record',
+    );
+  }
+  return event as UiEvent;
+}
