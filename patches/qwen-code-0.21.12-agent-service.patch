+/**
+ * Clamp against a server-authoritative count of the fully rendered prompt.
+ * Unlike the estimate path, this intentionally has no heuristic margin and no
+ * minimum-output floor: either the exact remaining room is used or the turn
+ * fails before it can overflow vLLM's configured context window.
+ */
+export function clampExactOutputTokensToWindow(
+  outputCeiling: number,
+  contextWindowSize: number,
+  exactPromptTokens: number,
+): TokenCount {
+  if (
+    !Number.isSafeInteger(outputCeiling) ||
+    outputCeiling <= 0 ||
+    !Number.isSafeInteger(contextWindowSize) ||
+    contextWindowSize <= 0 ||
+    !Number.isSafeInteger(exactPromptTokens) ||
+    exactPromptTokens < 0
+  ) {
+    throw new Error('Exact output clamp received invalid token limits.');
+  }
+  const room = contextWindowSize - exactPromptTokens;
+  if (room <= 0) {
+    throw new Error(
+      `Exact rendered prompt uses ${exactPromptTokens} tokens, exceeding the ${contextWindowSize}-token context window before generation.`,
+    );
+  }
+  return Math.min(outputCeiling, room);
+}
