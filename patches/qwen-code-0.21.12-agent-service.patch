+ */
+function inspectStrictPng(bytes: Buffer, filePath: string): StrictPngHeader {
+  const fail = (reason: string): never => {
+    throw new ImageViewError(
+      'invalid_png_contract',
+      `Image violates the Qwen3.8 full-quality PNG contract (${reason}): ${filePath}`,
+    );
+  };
+
