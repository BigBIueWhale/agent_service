+  describe('supported batch failure evidence and accounting', () => {
+    function batchResponse(
+      text: string,
+      args: string,
+    ): OpenAI.Chat.ChatCompletion {
+      return {
+        id: 'batch-response',
+        object: 'chat.completion',
+        created: 1,
+        model: 'test-model',
+        usage: {
+          prompt_tokens: 11,
+          completion_tokens: 7,
+          total_tokens: 18,
+          prompt_tokens_details: { cached_tokens: 3 },
+          completion_tokens_details: { reasoning_tokens: 2 },
+        },
+        choices: [
+          {
+            index: 0,
+            logprobs: null,
+            finish_reason: 'tool_calls',
+            message: {
+              role: 'assistant',
+              refusal: null,
+              content: text,
+              tool_calls: [
+                {
+                  id: 'batch-call',
+                  type: 'function',
+                  function: { name: 'respond_in_schema', arguments: args },
+                },
+              ],
+            },
+          },
+        ],
+      };
+    }
+    async function actualBatchClient(response: OpenAI.Chat.ChatCompletion) {
+      const actualUtilities = await vi.importActual<
+        typeof import('../utils/generateContentResponseUtilities.js')
+      >('../utils/generateContentResponseUtilities.js');
+      vi.mocked(getFunctionCalls).mockImplementation(
+        actualUtilities.getFunctionCalls,
+      );
+      const create = vi.fn().mockResolvedValue(response);
+      const provider = {
+        buildClient: () =>
+          ({ chat: { completions: { create } } }) as unknown as OpenAI,
+        buildRequest: (request: OpenAI.Chat.ChatCompletionCreateParams) =>
+          request,
+        buildHeaders: () => ({}),
+        getDefaultGenerationConfig: () => ({}),
+      } as OpenAICompatibleProvider;
+      const owner = new GenerationContext('batch-child-owner');
+      const admission = new RuntimeContractAdmission();
+      const recorder = {
+        recordUiTelemetryEvent: vi.fn().mockResolvedValue(undefined),
+      };
+      const preparedConfig = () => TEST_PROFILE;
+      const config = {
+        ...mockConfig,
+        assertRuntimeContractAvailable: () => admission.assertAvailable(),
+        getContentGenerator: () => owner.bind(loggingGenerator),
+        getContentGeneratorConfig: preparedConfig,
+        requireContentGeneratorConfig: preparedConfig,
+        getGenerationContext: () => owner,
+        getTelemetryUserId: () => 'test-user',
+        getTelemetrySensitiveSpanAttributeMaxLength: () => 4096,
+        getTelemetryIncludeSensitiveSpanAttributes: () => false,
+        getChatRecordingService: () => recorder,
+      } as unknown as Config;
+      const rawGenerator = new OpenAIContentGenerator(
+        TEST_PROFILE,
+        config,
+        provider,
+      );
+      const loggingGenerator = new LoggingContentGenerator(
+        rawGenerator,
+        config,
+        TEST_PROFILE,
+      );
+      return {
+        instance: new BaseLlmClient(config),
+        create,
+        recorder,
+        admission,
+      };
+    }
+
+    it.each(['json', 'text', 'stream'] as const)(
+      'refuses %s generation after a latched contract failure without dispatching',
+      async (mode) => {
+        const { instance, create, recorder, admission } =
+          await actualBatchClient(batchResponse('', '{}'));
+        let violation: unknown;
+        try {
+          admission.admitGoalSnapshot({
+            v: 2,
+            goal: null,
+            activity: 'unsupported',
+          });
+        } catch (error) {
+          violation = error;
+        }
+        expect(violation).toBeInstanceOf(RuntimeContractViolation);
+        const generation =
+          mode === 'json'
+            ? instance.generateJson(defaultOptions)
+            : instance.generateText({
+                ...defaultOptions,
+                stream: mode === 'stream',
+              });
+        const failure: unknown = await generation.then(
+          () => {
+            throw new Error('Expected runtime contract refusal');
+          },
+          (error: unknown) => error,
+        );
+        expect(failure).toBeInstanceOf(Error);
+        expect((failure as Error).cause).toBe(violation);
+        expect(create).not.toHaveBeenCalled();
+        expect(logApiDispatch).not.toHaveBeenCalled();
+        expect(logApiUsage).not.toHaveBeenCalled();
+        expect(recorder.recordUiTelemetryEvent).not.toHaveBeenCalled();
+      },
+    );
+
+    it('accepts an identified completed schema call whose validated result is an empty object', async () => {
+      const { instance, create } = await actualBatchClient(
+        batchResponse('', '{}'),
