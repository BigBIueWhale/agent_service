+import type { GenerationUsageSummary } from '@qwen-code/qwen-code-core/generationUsage';
+import type { DaemonSessionStatsStatus } from '@qwen-code/webui/daemon-react-sdk';
+import { I18nProvider } from '../../i18n';
+import {
+  StatsMessage,
+  formatDuration,
+  parseStatsMessage,
+  serializeStatsMessage,
+  type StatsView,
+} from './StatsMessage';
+
+const noRequests: GenerationUsageSummary = {
+  requests: 0,
+  usageReports: 0,
+  unfinalizedRequests: 0,
+  unreportedUsageRequests: 0,
+  usage: null,
+};
+const reportedZero: GenerationUsageSummary = {
+  requests: 1,
+  usageReports: 1,
+  unfinalizedRequests: 0,
+  unreportedUsageRequests: 0,
+  usage: {
+    promptTokenCount: 0,
+    candidatesTokenCount: 0,
+    cachedContentTokenCount: 0,
+    thoughtsTokenCount: 0,
+    totalTokenCount: 0,
+  },
+};
+const reported: GenerationUsageSummary = {
+  ...reportedZero,
+  usage: {
+    promptTokenCount: 10,
+    candidatesTokenCount: 4,
+    cachedContentTokenCount: 3,
+    thoughtsTokenCount: 2,
+    totalTokenCount: 14,
+  },
+};
+
+function statusFor(
+  generationUsage: GenerationUsageSummary,
+): DaemonSessionStatsStatus {
+  return {
+    v: 1,
+    sessionId: 'stats-owner',
+    workspaceCwd: '/fixture',
+    sessionStartTimeMs: 0,
+    durationMs: 1000,
+    promptCount: 1,
+    generationUsage,
+    models:
+      generationUsage.requests === 0
+        ? {}
+        : {
+            'selected-model::reviewer': {
+              generationUsage,
+              api: { totalErrors: 0, totalLatencyMs: 0 },
+            },
+          },
+    tools: {
+      totalCalls: 0,
+      totalSuccess: 0,
+      totalFail: 0,
+      totalDurationMs: 0,
+      byName: {},
+    },
+    files: { totalLinesAdded: 0, totalLinesRemoved: 0 },
+  };
+}
+
+let container: HTMLDivElement | null = null;
+let root: Root | null = null;
+function render(
+  status: DaemonSessionStatsStatus,
+  view: StatsView = 'overview',
+) {
+  if (!container) {
+    container = document.createElement('div');
+    document.body.appendChild(container);
+    root = createRoot(container);
+  }
+  act(() =>
+    root!.render(
+      <I18nProvider language="en">
+        <StatsMessage view={view} status={status} />
+      </I18nProvider>,
+    ),
+  );
+  return container;
+}
+function metricValues(label: string): string[] {
+  const row = Array.from(
+    container!.querySelectorAll('[class*="pivotRow"]'),
+  ).find((item) => item.firstElementChild?.textContent === label);
+  expect(row, `Missing metric ${label}`).toBeDefined();
+  return Array.from(row!.children)
+    .slice(1)
+    .map((child) => child.textContent ?? '');
+}
+
+afterEach(() => {
+  act(() => root?.unmount());
+  container?.remove();
+  root = null;
+  container = null;
+});
+
+describe('StatsMessage', () => {
+  it('distinguishes unknown model usage from a served-zero report', () => {
+    render(statusFor(reportedZero), 'model');
+    expect(metricValues('Total')).toEqual(['0']);
+    expect(container!.textContent).toContain('1 usage reports');
+    const unknown = { ...noRequests, requests: 1, unreportedUsageRequests: 1 };
+    render(statusFor(unknown), 'model');
+    expect(metricValues('Total')).toEqual(['—']);
+    expect(container!.textContent).toContain('No served usage reported');
+    expect(container!.textContent).toContain('1 without usage');
+  });
+
+  it.each([
