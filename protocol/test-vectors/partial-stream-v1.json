{
  "v": 1,
  "cases": [
    {
      "name": "root category groups reset indices within one turn",
      "root": true,
      "actions": [
        {
          "kind": "partial",
          "event": {
            "type": "message_start",
            "message": {
              "id": "first",
              "role": "assistant",
              "model": "fixture",
              "content": []
            }
          }
        },
        {
          "kind": "partial",
          "event": {
            "type": "content_block_start",
            "index": 0,
            "content_block": {
              "type": "thinking",
              "thinking": ""
            }
          }
        },
        {
          "kind": "partial",
          "event": {
            "type": "content_block_delta",
            "index": 0,
            "delta": {
              "type": "thinking_delta",
              "thinking": "exact delivered content"
            }
          }
        },
        {
          "kind": "partial",
          "event": {
            "type": "content_block_stop",
            "index": 0
          }
        },
        {
          "kind": "message_complete"
        },
        {
          "kind": "partial",
          "event": {
            "type": "content_block_start",
            "index": 0,
            "content_block": {
              "type": "text",
              "text": ""
            }
          }
        },
        {
          "kind": "partial",
          "event": {
            "type": "content_block_delta",
            "index": 0,
            "delta": {
              "type": "text_delta",
              "text": "exact delivered content"
            }
          }
        },
        {
          "kind": "partial",
          "event": {
            "type": "content_block_stop",
            "index": 0
          }
        },
        {
          "kind": "message_complete"
        },
        {
          "kind": "partial",
          "event": {
            "type": "message_stop"
          }
        },
        {
          "kind": "scope_complete"
        }
      ],
      "expected": {
        "state": "accepted"
      }
    },
