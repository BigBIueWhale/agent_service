+        for identity in children.values():
+            cleanup_step(lambda identity=identity: close_identity(identity))
+        if result["cleanup_errors"]:
+            result["status"] = "FIXTURE_OR_ASSERTION_FAILURE"
+        (case / "observations.json").write_text(json.dumps(result, indent=2) + "\n")
+    print(json.dumps(result), flush=True)
