@@ -0,0 +1,147 @@
+/**
+ * @license
+ * Copyright 2025 Qwen
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import type OpenAI from 'openai';
+import type { Config } from '../../config/config.js';
+import type { ContentGeneratorConfig } from '../contentGenerator.js';
+import { ContentGenerationPipeline } from './pipeline.js';
+import type { OpenAICompatibleProvider } from './provider/index.js';
+import type { PipelineConfig } from './types.js';
+import {
+  MAX_STREAM_GUARD_TIMEOUT_MS,
+  QWEN_STREAM_IDLE_TIMEOUT_MS_ENV,
+  QWEN_STREAM_MAX_LIFETIME_MS_ENV,
+} from './constants.js';
+
+vi.mock('./converter.js', () => ({ OpenAIContentConverter: {} }));
+vi.mock('openai');
+vi.mock('../../telemetry/gen-ai-request.js', () => ({
+  reportOpenAiRequest: vi.fn(),
+  reportOpenAiResponse: vi.fn(),
+  reportOpenAiChunk: vi.fn(),
+}));
+
+const guards = [
+  ['streamIdleTimeoutMs', QWEN_STREAM_IDLE_TIMEOUT_MS_ENV],
+  ['streamMaxLifetimeMs', QWEN_STREAM_MAX_LIFETIME_MS_ENV],
+] as const;
+
+const invalidConfigValues: Array<{ label: string; value: unknown }> = [
+  { label: 'null', value: null },
+  { label: 'false', value: false },
+  { label: 'numeric string', value: '10' },
+  { label: 'object', value: {} },
+  { label: 'NaN', value: NaN },
+  { label: 'positive infinity', value: Infinity },
+  { label: 'negative infinity', value: -Infinity },
+  { label: 'fraction', value: 0.5 },
+  { label: 'negative integer', value: -1 },
+  { label: 'above timer ceiling', value: MAX_STREAM_GUARD_TIMEOUT_MS + 1 },
+];
+
+const invalidEnvValues = [
+  '',
+  ' \t ',
+  'not-a-number',
+  '-1',
+  '+1',
+  '0x10',
+  '1e3',
+  '1.5',
+  'Infinity',
+  String(MAX_STREAM_GUARD_TIMEOUT_MS + 1),
+];
+
+describe('stream guard configuration admission', () => {
+  let contentGeneratorConfig: ContentGeneratorConfig;
+  let provider: OpenAICompatibleProvider;
+  let config: PipelineConfig;
+
+  beforeEach(() => {
+    vi.stubEnv(QWEN_STREAM_IDLE_TIMEOUT_MS_ENV, undefined);
+    vi.stubEnv(QWEN_STREAM_MAX_LIFETIME_MS_ENV, undefined);
+    contentGeneratorConfig = { model: 'guard-admission-model' };
+    provider = {
+      buildClient: vi.fn().mockReturnValue({} as OpenAI),
+      buildRequest: vi.fn(),
+      buildHeaders: vi.fn(),
+      getDefaultGenerationConfig: vi.fn(),
+    };
+    config = {
+      cliConfig: {} as Config,
+      contentGeneratorConfig,
+      provider,
+      errorHandler: {
+        handle: vi.fn((error: unknown): never => {
+          throw error;
+        }),
+        shouldSuppressErrorLogging: vi.fn(() => false),
+      },
+    };
+  });
+
+  afterEach(() => {
+    vi.unstubAllEnvs();
+  });
+
+  function expectRefusalBeforeClientConstruction(label: string): void {
+    let rejection: unknown;
+    try {
+      new ContentGenerationPipeline(config);
+    } catch (error) {
+      rejection = error;
+    }
+    expect(provider.buildClient).not.toHaveBeenCalled();
+    expect(rejection).toBeInstanceOf(Error);
+    expect((rejection as Error).message).toContain(label);
+  }
+
+  it('admits absent guard settings and constructs the client once', () => {
+    expect(() => new ContentGenerationPipeline(config)).not.toThrow();
+    expect(provider.buildClient).toHaveBeenCalledTimes(1);
+  });
+
+  describe.each(guards)('%s', (field, envName) => {
+    it.each(invalidConfigValues)(
+      'refuses explicit $label before constructing a client',
+      ({ value }) => {
+        vi.stubEnv(envName, '4000');
+        // Runtime configuration can arrive outside the TypeScript boundary.
+        contentGeneratorConfig[field] = value as number;
+        expectRefusalBeforeClientConstruction(field);
+      },
+    );
+
+    it.each(invalidEnvValues)(
+      'refuses provided environment value %j before constructing a client',
+      (value) => {
+        vi.stubEnv(envName, value);
+        expectRefusalBeforeClientConstruction(envName);
+      },
+    );
+
+    it.each([0, 1, MAX_STREAM_GUARD_TIMEOUT_MS])(
+      'admits explicit %i before an invalid lower-priority environment value',
+      (value) => {
+        contentGeneratorConfig[field] = value;
+        vi.stubEnv(envName, 'invalid-lower-priority-value');
+        expect(() => new ContentGenerationPipeline(config)).not.toThrow();
+        expect(provider.buildClient).toHaveBeenCalledTimes(1);
+      },
+    );
+
+    it.each(['0', ' 4000 ', String(MAX_STREAM_GUARD_TIMEOUT_MS)])(
+      'admits environment value %j when the config field is undefined',
+      (value) => {
+        contentGeneratorConfig[field] = undefined;
+        vi.stubEnv(envName, value);
+        expect(() => new ContentGenerationPipeline(config)).not.toThrow();
+        expect(provider.buildClient).toHaveBeenCalledTimes(1);
+      },
+    );
+  });
+});
